extends RefCounted
class_name MMShaderCache

## A cache of compiled shaders (SPIR-V), in memory and on disk.
##
## Shaders are identified by a hash of their preprocessed source, of the
## stages they define, of Godot's version and of the rendering device. Before
## hashing, comments (they contain node names) are removed and node instance
## ids (o1234567...) are renamed in order of appearance, so shaders that only
## differ by the names of their variables share the same SPIR-V (parameters
## and textures are bound by position, not by name).
##
## Files on disk are checked (magic, version, key, checksum, SPIR-V header)
## before they are used: a damaged or outdated file is deleted and the shader
## is compiled again.

## (not user://shader_cache, which is Godot's own shader cache)
const CACHE_DIR : String = "user://compiled_shaders"
const FILE_EXTENSION : String = "spvc"
const FILE_MAGIC : PackedByteArray = [ 0x4d, 0x4d, 0x53, 0x43 ] # "MMSC"
## Increase this when the file format or the way keys are computed changes
const FORMAT_VERSION : int = 1
const SPIRV_MAGIC : int = 0x07230203
## Maximum size of the shaders kept in memory
const MEMORY_CACHE_MAX_BYTES : int = 64 << 20
## When the disk cache is larger than its maximum size, the oldest files are
## deleted until it is below this fraction of the maximum size
const DISK_CACHE_TRIM_RATIO : float = 0.75

## Whether the cache is used (shader_cache preference)
static var enabled : bool = true
## Maximum size of the disk cache in bytes (shader_cache_max_size preference, in MB)
static var max_disk_size : int = 256 << 20

static var config_read : bool = false
static var mutex : Mutex = Mutex.new()
## SPIR-V by key, most recently used last
static var memory_cache : Dictionary = {}
static var memory_cache_bytes : int = 0
## Size of the disk cache in bytes, -1 if it was not measured yet
static var disk_size : int = -1
static var device_key : String = ""

## Statistics (since the start of the session)
static var compiled_count : int = 0
static var memory_hits : int = 0
static var disk_hits : int = 0
static var rejected_files : int = 0

## Block comments are matched so that a // inside them is not taken for a
## line comment, and are kept. Line comments that end with a backslash
## (continued on the next line) are kept as well.
static var comment_regex : RegEx = RegEx.create_from_string("/\\*[\\s\\S]*?\\*/|//(?:[^\\n]*[^\\\\\\n\\r])?(?![^\\n\\r])")
## Instance ids appear alone or in names (p_o1234567_amount)
static var instance_id_regex : RegEx = RegEx.create_from_string("(?<![A-Za-z0-9])o(\\d{6,})")


## Reads the preferences, then trims the disk cache to its new maximum size
static func update_config() -> void:
	config_read = true
	var was_enabled : bool = enabled
	enabled = mm_globals.get_config("shader_cache")
	max_disk_size = int(mm_globals.get_config("shader_cache_max_size")) << 20
	if not enabled and was_enabled:
		clear_memory_cache()
	if enabled:
		trim_disk_cache(max_disk_size)

static func ensure_config() -> void:
	if not config_read:
		update_config()

static func is_enabled() -> bool:
	ensure_config()
	return enabled

## The source of a shader without line comments (they contain node names),
## with node instance ids (o1234567...) renamed in order of appearance. It is
## only hashed, never compiled.
static func canonicalize_source(source : String) -> String:
	var parts : PackedStringArray = PackedStringArray()
	var position : int = 0
	for m : RegExMatch in comment_regex.search_all(source):
		if m.get_string().begins_with("//"):
			parts.append(source.substr(position, m.get_start()-position))
			position = m.get_end()
	parts.append(source.substr(position))
	source = "".join(parts)
	# "@" cannot appear in GLSL identifiers, so renamed ids cannot clash with
	# other names
	var names : Dictionary = {}
	parts = PackedStringArray()
	position = 0
	for m : RegExMatch in instance_id_regex.search_all(source):
		var id : String = m.get_string(1)
		if not names.has(id):
			names[id] = "o@%d" % names.size()
		parts.append(source.substr(position, m.get_start()-position))
		parts.append(names[id])
		position = m.get_end()
	parts.append(source.substr(position))
	return "".join(parts)

## Godot's version and the rendering device (the SPIR-V generated by Godot's
## shader compiler depends on the device's capabilities)
static func get_device_key(rd : RenderingDevice) -> String:
	if device_key == "":
		var version : Dictionary = Engine.get_version_info()
		var info : PackedStringArray = PackedStringArray()
		info.append("format %d" % FORMAT_VERSION)
		info.append("godot %s %s" % [ version.string, version.hash ])
		info.append("driver %s" % RenderingServer.get_current_rendering_driver_name())
		info.append("device %s %s" % [ rd.get_device_vendor_name(), rd.get_device_name() ])
		info.append("adapter %s" % RenderingServer.get_video_adapter_api_version())
		info.append("pipeline cache %s" % rd.get_device_pipeline_cache_uuid())
		device_key = "\n".join(info)
	return device_key

static func get_key(rd : RenderingDevice, src : RDShaderSource, stages : Array) -> String:
	var text : String = get_device_key(rd)
	for s in stages:
		text += "\n// stage %s\n" % s
		text += canonicalize_source(src["source_"+s])
	return text.sha256_text()

static func get_file_path(key : String) -> String:
	return CACHE_DIR.path_join("%s.%s" % [ key, FILE_EXTENSION ])

## Returns the SPIR-V of a shader, or null if it is not in the cache
static func load_spirv(key : String, stages : Array) -> RDShaderSPIRV:
	if not is_enabled():
		return null
	mutex.lock()
	var spirv : RDShaderSPIRV = memory_cache.get(key)
	if spirv != null:
		# Move to the end (most recently used)
		memory_cache.erase(key)
		memory_cache[key] = spirv
		memory_hits += 1
	mutex.unlock()
	if spirv != null:
		return spirv
	spirv = read_file(key, stages)
	if spirv != null:
		mutex.lock()
		disk_hits += 1
		mutex.unlock()
		add_to_memory_cache(key, stages, spirv)
	return spirv

## Adds the SPIR-V of a successfully compiled shader to the cache
static func store_spirv(key : String, stages : Array, spirv : RDShaderSPIRV) -> void:
	if not is_enabled():
		return
	add_to_memory_cache(key, stages, spirv)
	write_file(key, stages, spirv)

## Removes a shader whose SPIR-V could not be used
static func discard(key : String) -> void:
	mutex.lock()
	remove_from_memory_cache(key)
	mutex.unlock()
	delete_file(get_file_path(key))

static func count_compiled() -> void:
	mutex.lock()
	compiled_count += 1
	mutex.unlock()

static func get_spirv_size(spirv : RDShaderSPIRV, stages : Array) -> int:
	var size : int = 0
	for s in stages:
		size += spirv["bytecode_"+s].size()
	return size

static func add_to_memory_cache(key : String, stages : Array, spirv : RDShaderSPIRV) -> void:
	var size : int = get_spirv_size(spirv, stages)
	mutex.lock()
	remove_from_memory_cache(key)
	memory_cache[key] = spirv
	spirv.set_meta("mm_cache_size", size)
	memory_cache_bytes += size
	while memory_cache_bytes > MEMORY_CACHE_MAX_BYTES and memory_cache.size() > 1:
		remove_from_memory_cache(memory_cache.keys()[0])
	mutex.unlock()

## Must be called with the mutex locked
static func remove_from_memory_cache(key : String) -> void:
	if memory_cache.has(key):
		memory_cache_bytes -= memory_cache[key].get_meta("mm_cache_size", 0)
		memory_cache.erase(key)

static func clear_memory_cache() -> void:
	mutex.lock()
	memory_cache.clear()
	memory_cache_bytes = 0
	mutex.unlock()

# Disk cache
#
# File format: "MMSC", format version (u32), key (u32 length + UTF-8), stage
# count (u32), then for each stage its name (u32 length + UTF-8) and its
# SPIR-V (u32 length + bytes), and the SHA-256 of everything before it.

static func append_u32(data : PackedByteArray, value : int) -> void:
	var offset : int = data.size()
	data.resize(offset+4)
	data.encode_u32(offset, value)

static func append_bytes(data : PackedByteArray, bytes : PackedByteArray) -> void:
	append_u32(data, bytes.size())
	data.append_array(bytes)

static func write_file(key : String, stages : Array, spirv : RDShaderSPIRV) -> void:
	var data : PackedByteArray = FILE_MAGIC.duplicate()
	append_u32(data, FORMAT_VERSION)
	append_bytes(data, key.to_utf8_buffer())
	append_u32(data, stages.size())
	for s in stages:
		append_bytes(data, String(s).to_utf8_buffer())
		append_bytes(data, spirv["bytecode_"+s])
	var hashing : HashingContext = HashingContext.new()
	hashing.start(HashingContext.HASH_SHA256)
	hashing.update(data)
	data.append_array(hashing.finish())
	if DirAccess.make_dir_recursive_absolute(CACHE_DIR) != OK:
		return
	# Write to a temporary file first, so a file is never seen half written
	var path : String = get_file_path(key)
	var tmp_path : String = "%s.%d.tmp" % [ path, OS.get_thread_caller_id() ]
	var file : FileAccess = FileAccess.open(tmp_path, FileAccess.WRITE)
	if file == null:
		return
	var written : bool = file.store_buffer(data)
	file.close()
	if not written or DirAccess.rename_absolute(tmp_path, path) != OK:
		DirAccess.remove_absolute(tmp_path)
		return
	mutex.lock()
	if disk_size >= 0:
		disk_size += data.size()
	var trim : bool = disk_size < 0 or disk_size > max_disk_size
	mutex.unlock()
	if trim:
		trim_disk_cache(max_disk_size)

class Reader:
	var data : PackedByteArray
	var position : int = 0
	var valid : bool = true

	func _init(d : PackedByteArray) -> void:
		data = d

	func read_u32() -> int:
		if position+4 > data.size():
			valid = false
			return 0
		var value : int = data.decode_u32(position)
		position += 4
		return value

	func read_bytes() -> PackedByteArray:
		var size : int = read_u32()
		if not valid or position+size > data.size():
			valid = false
			return PackedByteArray()
		var bytes : PackedByteArray = data.slice(position, position+size)
		position += size
		return bytes

## Reads and checks a cache file. Returns null (and deletes the file if it is
## damaged or outdated) if it cannot be used.
static func read_file(key : String, stages : Array) -> RDShaderSPIRV:
	var path : String = get_file_path(key)
	if not FileAccess.file_exists(path):
		return null
	var data : PackedByteArray = FileAccess.get_file_as_bytes(path)
	var spirv : RDShaderSPIRV = parse_file(data, key, stages)
	if spirv == null:
		push_warning("Ignoring invalid shader cache file %s" % path)
		mutex.lock()
		rejected_files += 1
		mutex.unlock()
		delete_file(path)
	return spirv

static func parse_file(data : PackedByteArray, key : String, stages : Array) -> RDShaderSPIRV:
	if data.size() < FILE_MAGIC.size()+32 or data.slice(0, FILE_MAGIC.size()) != FILE_MAGIC:
		return null
	var hashing : HashingContext = HashingContext.new()
	hashing.start(HashingContext.HASH_SHA256)
	hashing.update(data.slice(0, data.size()-32))
	if hashing.finish() != data.slice(data.size()-32):
		return null
	var reader : Reader = Reader.new(data.slice(0, data.size()-32))
	reader.position = FILE_MAGIC.size()
	if reader.read_u32() != FORMAT_VERSION:
		return null
	if reader.read_bytes().get_string_from_utf8() != key:
		return null
	if reader.read_u32() != stages.size():
		return null
	var spirv : RDShaderSPIRV = RDShaderSPIRV.new()
	for s in stages:
		if reader.read_bytes().get_string_from_utf8() != s:
			return null
		var bytecode : PackedByteArray = reader.read_bytes()
		if not reader.valid or bytecode.size() < 20 or bytecode.size() % 4 != 0 or bytecode.decode_u32(0) != SPIRV_MAGIC:
			return null
		spirv["bytecode_"+s] = bytecode
	if not reader.valid or reader.position != reader.data.size():
		return null
	return spirv

static func delete_file(path : String) -> void:
	if not FileAccess.file_exists(path):
		return
	var size : int = FileAccess.get_size(path)
	if DirAccess.remove_absolute(path) == OK:
		mutex.lock()
		if disk_size >= 0:
			disk_size = max(disk_size-size, 0)
		mutex.unlock()

## Returns the files of the disk cache as [ path, size, modification time ]
static func list_files() -> Array[Array]:
	var files : Array[Array] = []
	var dir : DirAccess = DirAccess.open(CACHE_DIR)
	if dir == null:
		return files
	for f : String in dir.get_files():
		var path : String = CACHE_DIR.path_join(f)
		if f.get_extension() == FILE_EXTENSION or f.get_extension() == "tmp":
			files.append([ path, FileAccess.get_size(path), FileAccess.get_modified_time(path) ])
	return files

## Returns the number of files and the size in bytes of the disk cache
static func get_disk_usage() -> Dictionary:
	var count : int = 0
	var size : int = 0
	for f in list_files():
		if f[0].get_extension() == FILE_EXTENSION:
			count += 1
		size += f[1]
	return { count=count, size=size }

## Deletes the oldest files of the disk cache if it is larger than max_size
## (and leftover temporary files)
static func trim_disk_cache(max_size : int) -> void:
	var files : Array[Array] = list_files()
	var size : int = 0
	for f in files:
		size += f[1]
	if size > max_size:
		files.sort_custom(func(a, b): return a[2] < b[2])
		var target_size : int = int(max_size*DISK_CACHE_TRIM_RATIO)
		for f in files:
			if size <= target_size:
				break
			if DirAccess.remove_absolute(f[0]) == OK:
				size -= f[1]
	mutex.lock()
	disk_size = size
	mutex.unlock()

## Removes all shaders from the cache (memory and disk)
static func clear() -> void:
	clear_memory_cache()
	for f in list_files():
		DirAccess.remove_absolute(f[0])
	mutex.lock()
	disk_size = 0
	mutex.unlock()

static func get_statistics_string() -> String:
	return "Shaders: %d compiled, %d from the cache (%d in memory, %d on disk)" % [ compiled_count, memory_hits+disk_hits, memory_hits, disk_hits ]
