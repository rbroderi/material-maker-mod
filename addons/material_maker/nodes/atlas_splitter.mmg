{
	"name": "atlas_splitter",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"columns": 2.0,
		"fit": 0,
		"index": 0.0,
		"rows": 2.0
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length(fract($uv*2.0)-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "The atlas: a grid of images, indexed from the top left corner, row by row",
				"name": "atlas",
				"shortdesc": "Atlas",
				"type": "rgba"
			}
		],
		"instance": [
			"vec4 $(name)_split(vec2 uv) {",
			"\tvec2 grid = max(floor(vec2($columns, $rows)), vec2(1.0));",
			"\tfloat index = mod(floor($index), grid.x*grid.y);",
			"\t// (index+0.5)/columns: an exact division can round down",
			"\tfloat row = floor((index+0.5)/grid.x);",
			"\tvec2 cell = vec2(index-row*grid.x, row);",
			"\tvec2 l = fract(uv);",
			"\tif ($fit == 1) {",
			"\t\t// Keeps the aspect ratio of the atlas's cells",
			"\t\tfloat aspect = grid.y/grid.x;",
			"\t\tif (aspect < 1.0) {",
			"\t\t\tl.x = (l.x-0.5)/aspect+0.5;",
			"\t\t} else {",
			"\t\t\tl.y = (l.y-0.5)*aspect+0.5;",
			"\t\t}",
			"\t\tif (any(lessThan(l, vec2(0.0))) || any(greaterThanEqual(l, vec2(1.0)))) {",
			"\t\t\treturn vec4(0.0);",
			"\t\t}",
			"\t}",
			"\treturn $atlas((cell+l)/grid);",
			"}"
		],
		"longdesc": "Extracts one image of an atlas whose images are on a grid, by index (from the top left corner, row by row)",
		"name": "Atlas Splitter",
		"outputs": [
			{
				"longdesc": "The extracted image",
				"rgba": "$(name)_split($uv)",
				"shortdesc": "Output",
				"type": "rgba"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 2.0,
				"label": "Columns",
				"longdesc": "The number of columns of the atlas",
				"max": 16.0,
				"min": 1.0,
				"name": "columns",
				"shortdesc": "Columns",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 2.0,
				"label": "Rows",
				"longdesc": "The number of rows of the atlas",
				"max": 16.0,
				"min": 1.0,
				"name": "rows",
				"shortdesc": "Rows",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Index",
				"longdesc": "The index of the extracted image (from the top left corner, row by row; wraps around)",
				"max": 255.0,
				"min": 0.0,
				"name": "index",
				"shortdesc": "Index",
				"step": 1.0,
				"type": "float"
			},
			{
				"default": 0,
				"label": "Fit",
				"longdesc": "How the image fills the output when the atlas's cells are not square:\n- Stretch: the image is stretched to fill the output\n- Keep aspect ratio: the image keeps its proportions, on a transparent background",
				"name": "fit",
				"shortdesc": "Fit",
				"type": "enum",
				"values": [
					{
						"name": "Stretch",
						"value": "0"
					},
					{
						"name": "Keep aspect ratio",
						"value": "1"
					}
				]
			}
		],
		"shortdesc": "Atlas Splitter"
	},
	"type": "shader"
}