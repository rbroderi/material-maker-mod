			"Unity/Built-in Shader": {
				"export_extension": "mat",
				"files": [
					{
						"file_name": "$(path_prefix).shader",
						"template": "Shader \"Material Maker/$(file_prefix)\"\n{\n\t// Procedural material generated by Material Maker: the graph is computed\n\t// in this shader (buffers, if any, are textures)\n\tProperties {\n$begin_buffers\n\t\ttexture_$(buffer_index) (\"Texture $(buffer_index)\", 2D) = \"white\" {}\n$end_buffers\n\t\t_MainTex (\"UV\", 2D) = \"white\" {}\n\t}\n\tSubShader {\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n\t\tTags { \"RenderType\"=\"Transparent\" \"Queue\"=\"Transparent\" }\n$else\n\t\tTags { \"RenderType\"=\"Opaque\" }\n$fi\n\t\tLOD 200\n\t\tCGPROGRAM\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n\t\t#pragma surface surf Standard fullforwardshadows alpha:fade\n$else\n\t\t#pragma surface surf Standard fullforwardshadows\n$fi\n\t\t#pragma target 3.5\n\n\t\tsampler2D _MainTex;\n\t\tstruct Input {\n\t\t\tfloat2 uv_MainTex;\n\t\t};\n\n$definitions hlsl,rename_buffers,unity\n\n\t\tvoid surf (Input IN, inout SurfaceOutputStandard o) {\n\t\t\tfloat _seed_variation_ = 0.0;\n\t\t\tfloat4 _controlled_variation_ = float4(0.0, 0.0, 0.0, 0.0);\n\t\t\tfloat2 uv = frac(IN.uv_MainTex);\n$begin_generate hlsl,rename_buffers,unity\n\t\t\tfloat3 albedo_tex = $albedo_tex(uv);\n#ifndef UNITY_COLORSPACE_GAMMA\n\t\t\talbedo_tex = GammaToLinearSpace(albedo_tex);\n#endif\n\t\t\to.Albedo = albedo_tex*$albedo_color.rgb;\n\t\t\to.Metallic = $metallic*$metallic_tex(uv);\n\t\t\to.Smoothness = 1.0-$roughness*$roughness_tex(uv);\n\t\t\t// Material Maker's normal convention to Unity's tangent space (OpenGL)\n\t\t\tfloat3 normal_tex = ($normal_tex(uv)*float3(-1.0, 1.0, -1.0)+float3(1.0, 0.0, 1.0))*2.0-float3(1.0, 1.0, 1.0);\n\t\t\to.Normal = normalize(float3(normal_tex.xy*$normal, normal_tex.z));\n\t\t\tfloat3 emission_tex = $emission_tex(uv);\n#ifndef UNITY_COLORSPACE_GAMMA\n\t\t\temission_tex = GammaToLinearSpace(emission_tex);\n#endif\n\t\t\to.Emission = emission_tex*$emission_energy;\n\t\t\to.Occlusion = lerp(1.0, $ao_tex(uv), $ao);\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n\t\t\to.Alpha = $opacity_tex(uv);\n$else\n\t\t\to.Alpha = 1.0;\n$fi\n$end_generate\n\t\t}\n\t\tENDCG\n\t}\n\tFallBack \"Diffuse\"\n}\n",
						"type": "template"
					},
					{
