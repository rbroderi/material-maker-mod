							"$if $(connected:normal_tex)",
							"        m_Texture: {fileID: 2800000, guid: $uid(2), type: 3}",
							"$else",
							"        m_Texture: {fileID: 0}",
							"$fi",
							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
							"    - _DetailAlbedoMap:",
							"        m_Texture: {fileID: 0}",
							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
							"    - _DetailMask:",
							"        m_Texture: {fileID: 0}",
							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
							"    - _DetailNormalMap:",
