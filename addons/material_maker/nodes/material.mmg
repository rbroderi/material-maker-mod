			"MaterialX/OpenPBR": {
				"export_extension": "mtlx",
				"files": [
					{
						"conditions": "$(connected:albedo_tex) or $(connected:opacity_tex)",
						"file_name": "$(path_prefix)_albedo.png",
						"output": 0,
						"type": "texture"
					},
					{
						"conditions": "$(connected:metallic_tex)",
						"file_name": "$(path_prefix)_metallic.png",
						"output": 12,
						"type": "texture"
					},
					{
						"conditions": "$(connected:roughness_tex)",
						"file_name": "$(path_prefix)_roughness.png",
						"output": 13,
						"type": "texture"
					},
					{
						"conditions": "$(connected:normal_tex)",
						"file_name": "$(path_prefix)_normal.png",
						"output": 3,
						"type": "texture"
					},
					{
						"conditions": "$(connected:emission_tex)",
						"file_name": "$(path_prefix)_emission.png",
						"output": 2,
						"type": "texture"
					},
					{
						"conditions": "$(connected:depth_tex)",
						"file_name": "$(path_prefix)_height.png",
						"output": 8,
						"type": "texture"
					},
					{
						"conditions": "$(connected:coat_tex)",
						"file_name": "$(path_prefix)_coat.png",
						"output": 15,
						"type": "texture"
					},
					{
						"conditions": "$(connected:coat_roughness_tex)",
						"file_name": "$(path_prefix)_coat_roughness.png",
						"output": 16,
						"type": "texture"
					},
					{
						"conditions": "$(connected:anisotropy_tex)",
						"file_name": "$(path_prefix)_anisotropy.png",
						"output": 17,
						"type": "texture"
					},
					{
						"conditions": "$(connected:sheen_tex)",
						"file_name": "$(path_prefix)_sheen.png",
						"output": 18,
						"type": "texture"
					},
					{
						"conditions": "$(connected:transmission_tex)",
						"file_name": "$(path_prefix)_transmission.png",
						"output": 19,
						"type": "texture"
					},
					{
						"file_name": "$(path_prefix).mtlx",
						"template": [
							"<?xml version=\"1.0\"?>",
							"<!-- Generated by Material Maker. Textures are exported next to this file. -->",
							"<materialx version=\"1.39\" colorspace=\"lin_rec709\">",
							"  <nodegraph name=\"NG_material\">",
							"$if $(connected:albedo_tex) or $(connected:opacity_tex)",
							"    <image name=\"albedo_image\" type=\"color4\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_albedo.png\" colorspace=\"srgb_texture\" />",
							"    </image>",
							"$fi",
							"$if $(connected:albedo_tex)",
							"    <convert name=\"albedo_rgb\" type=\"color3\">",
							"      <input name=\"in\" type=\"color4\" nodename=\"albedo_image\" />",
							"    </convert>",
							"    <multiply name=\"base_color\" type=\"color3\">",
							"      <input name=\"in1\" type=\"color3\" nodename=\"albedo_rgb\" />",
							"      <input name=\"in2\" type=\"color3\" value=\"$(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b)\" />",
							"    </multiply>",
							"    <output name=\"base_color_output\" type=\"color3\" nodename=\"base_color\" />",
							"$fi",
							"$if $(connected:opacity_tex)",
							"    <extract name=\"opacity\" type=\"float\">",
							"      <input name=\"in\" type=\"color4\" nodename=\"albedo_image\" />",
							"      <input name=\"index\" type=\"integer\" value=\"3\" />",
							"    </extract>",
							"    <output name=\"opacity_output\" type=\"float\" nodename=\"opacity\" />",
							"$fi",
							"$if $(connected:metallic_tex)",
							"    <image name=\"metallic_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_metallic.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"metallic\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"metallic_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:metallic)\" />",
							"    </multiply>",
							"    <output name=\"metallic_output\" type=\"float\" nodename=\"metallic\" />",
							"$fi",
							"$if $(connected:roughness_tex)",
							"    <image name=\"roughness_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_roughness.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"roughness\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"roughness_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:roughness)\" />",
							"    </multiply>",
							"    <output name=\"roughness_output\" type=\"float\" nodename=\"roughness\" />",
							"$fi",
							"$if $(connected:normal_tex)",
							"    <image name=\"normal_image\" type=\"vector3\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_normal.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <normalmap name=\"normal\" type=\"vector3\">",
							"      <input name=\"in\" type=\"vector3\" nodename=\"normal_image\" />",
							"      <input name=\"scale\" type=\"float\" value=\"$(param:normal)\" />",
							"    </normalmap>",
							"    <output name=\"normal_output\" type=\"vector3\" nodename=\"normal\" />",
							"$fi",
							"$if $(connected:emission_tex)",
							"    <image name=\"emission_image\" type=\"color3\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_emission.png\" colorspace=\"srgb_texture\" />",
							"    </image>",
							"    <output name=\"emission_output\" type=\"color3\" nodename=\"emission_image\" />",
							"$fi",
							"$if $(connected:depth_tex)",
							"    <image name=\"height_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_height.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <output name=\"height_output\" type=\"float\" nodename=\"height_image\" />",
							"$fi",
							"$if $(connected:coat_tex)",
							"    <image name=\"coat_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_coat.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"coat\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"coat_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:coat)\" />",
							"    </multiply>",
							"    <output name=\"coat_output\" type=\"float\" nodename=\"coat\" />",
							"$fi",
							"$if $(connected:coat_roughness_tex)",
							"    <image name=\"coat_roughness_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_coat_roughness.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"coat_roughness\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"coat_roughness_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:coat_roughness)\" />",
							"    </multiply>",
							"    <output name=\"coat_roughness_output\" type=\"float\" nodename=\"coat_roughness\" />",
							"$fi",
							"$if $(connected:anisotropy_tex)",
							"    <image name=\"anisotropy_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_anisotropy.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"anisotropy\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"anisotropy_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:anisotropy)\" />",
							"    </multiply>",
							"    <output name=\"anisotropy_output\" type=\"float\" nodename=\"anisotropy\" />",
							"$fi",
							"$if $(connected:sheen_tex)",
							"    <image name=\"sheen_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_sheen.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"sheen\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"sheen_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:sheen)\" />",
							"    </multiply>",
							"    <output name=\"sheen_output\" type=\"float\" nodename=\"sheen\" />",
							"$fi",
							"$if $(connected:transmission_tex)",
							"    <image name=\"transmission_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_transmission.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"transmission\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"transmission_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:transmission)\" />",
							"    </multiply>",
							"    <output name=\"transmission_output\" type=\"float\" nodename=\"transmission\" />",
							"$fi",
							"  </nodegraph>",
							"  <open_pbr_surface name=\"SR_material\" type=\"surfaceshader\">",
							"$if $(connected:albedo_tex)",
							"    <input name=\"base_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"base_color_output\" />",
							"$else",
							"    <input name=\"base_color\" type=\"color3\" value=\"$(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b)\" />",
							"$fi",
							"$if $(connected:opacity_tex)",
							"    <input name=\"geometry_opacity\" type=\"float\" nodegraph=\"NG_material\" output=\"opacity_output\" />",
							"$fi",
							"$if $(connected:metallic_tex)",
							"    <input name=\"base_metalness\" type=\"float\" nodegraph=\"NG_material\" output=\"metallic_output\" />",
							"$else",
							"    <input name=\"base_metalness\" type=\"float\" value=\"$(param:metallic)\" />",
							"$fi",
							"$if $(connected:roughness_tex)",
							"    <input name=\"specular_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"roughness_output\" />",
							"$else",
							"    <input name=\"specular_roughness\" type=\"float\" value=\"$(param:roughness)\" />",
							"$fi",
							"$if $(connected:normal_tex)",
							"    <input name=\"geometry_normal\" type=\"vector3\" nodegraph=\"NG_material\" output=\"normal_output\" />",
							"$fi",
							"$if $(connected:emission_tex)",
							"    <input name=\"emission_luminance\" type=\"float\" value=\"$(param:emission_energy)\" />",
							"    <input name=\"emission_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"emission_output\" />",
							"$fi",
							"$if $(connected:coat_tex)",
							"    <input name=\"coat_weight\" type=\"float\" nodegraph=\"NG_material\" output=\"coat_output\" />",
							"$else",
							"    <input name=\"coat_weight\" type=\"float\" value=\"$(param:coat)\" />",
							"$fi",
							"$if $(connected:coat_roughness_tex)",
							"    <input name=\"coat_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"coat_roughness_output\" />",
							"$else",
							"    <input name=\"coat_roughness\" type=\"float\" value=\"$(param:coat_roughness)\" />",
							"$fi",
							"$if $(connected:anisotropy_tex)",
							"    <input name=\"specular_roughness_anisotropy\" type=\"float\" nodegraph=\"NG_material\" output=\"anisotropy_output\" />",
							"$else",
							"    <input name=\"specular_roughness_anisotropy\" type=\"float\" value=\"$(param:anisotropy)\" />",
							"$fi",
							"$if $(connected:sheen_tex)",
							"    <input name=\"fuzz_weight\" type=\"float\" nodegraph=\"NG_material\" output=\"sheen_output\" />",
							"$else",
							"    <input name=\"fuzz_weight\" type=\"float\" value=\"$(param:sheen)\" />",
							"$fi",
							"$if $(connected:transmission_tex)",
							"    <input name=\"transmission_weight\" type=\"float\" nodegraph=\"NG_material\" output=\"transmission_output\" />",
							"$else",
							"    <input name=\"transmission_weight\" type=\"float\" value=\"$(param:transmission)\" />",
							"$fi",
							"  </open_pbr_surface>",
							"$if $(connected:depth_tex)",
							"  <displacement name=\"DS_material\" type=\"displacementshader\">",
							"    <input name=\"displacement\" type=\"float\" nodegraph=\"NG_material\" output=\"height_output\" />",
							"    <input name=\"scale\" type=\"float\" value=\"$(param:depth_scale)\" />",
							"  </displacement>",
							"$fi",
							"  <surfacematerial name=\"M_material\" type=\"material\">",
							"    <input name=\"surfaceshader\" type=\"surfaceshader\" nodename=\"SR_material\" />",
							"$if $(connected:depth_tex)",
							"    <input name=\"displacementshader\" type=\"displacementshader\" nodename=\"DS_material\" />",
							"$fi",
							"  </surfacematerial>",
							"</materialx>"
						],
						"type": "template"
					}
				]
			},
			"MaterialX/Procedural": {
				"export_extension": "mtlx",
				"files": [
					{
						"file_name": "$(path_prefix).mtlx",
						"template": "<?xml version=\"1.0\"?>\n<!-- Procedural material generated by Material Maker: the graph is a custom node\n     whose GLSL implementation ($(file_prefix).glsl) is next to this file (add\n     this directory to the search path of MaterialX's GLSL shader generator) -->\n<materialx version=\"1.39\">\n  <nodedef name=\"ND_mm_procedural\" node=\"mm_procedural\">\n    <input name=\"texcoord\" type=\"vector2\" defaultgeomprop=\"UV0\" />\n    <output name=\"base_color\" type=\"color3\" />\n    <output name=\"metallic\" type=\"float\" />\n    <output name=\"roughness\" type=\"float\" />\n    <output name=\"normal\" type=\"vector3\" />\n    <output name=\"emission\" type=\"color3\" />\n    <output name=\"opacity\" type=\"float\" />\n  </nodedef>\n  <implementation name=\"IM_mm_procedural_genglsl\" nodedef=\"ND_mm_procedural\" target=\"genglsl\" file=\"$(file_prefix).glsl\" function=\"mm_procedural\" />\n  <nodegraph name=\"NG_material\">\n    <mm_procedural name=\"procedural\" type=\"multioutput\" />\n    <normalmap name=\"normalmap\" type=\"vector3\">\n      <input name=\"in\" type=\"vector3\" nodename=\"procedural\" output=\"normal\" />\n      <input name=\"scale\" type=\"float\" value=\"$(param:normal)\" />\n    </normalmap>\n    <output name=\"base_color_output\" type=\"color3\" nodename=\"procedural\" output=\"base_color\" />\n    <output name=\"metallic_output\" type=\"float\" nodename=\"procedural\" output=\"metallic\" />\n    <output name=\"roughness_output\" type=\"float\" nodename=\"procedural\" output=\"roughness\" />\n    <output name=\"normal_output\" type=\"vector3\" nodename=\"normalmap\" />\n    <output name=\"emission_output\" type=\"color3\" nodename=\"procedural\" output=\"emission\" />\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n    <convert name=\"opacity\" type=\"color3\">\n      <input name=\"in\" type=\"float\" nodename=\"procedural\" output=\"opacity\" />\n    </convert>\n    <output name=\"opacity_output\" type=\"color3\" nodename=\"opacity\" />\n$fi\n  </nodegraph>\n  <standard_surface name=\"SR_$(file_prefix)\" type=\"surfaceshader\">\n    <input name=\"base_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"base_color_output\" />\n    <input name=\"metalness\" type=\"float\" nodegraph=\"NG_material\" output=\"metallic_output\" />\n    <input name=\"specular_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"roughness_output\" />\n    <input name=\"normal\" type=\"vector3\" nodegraph=\"NG_material\" output=\"normal_output\" />\n    <input name=\"emission\" type=\"float\" value=\"1.0\" />\n    <input name=\"emission_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"emission_output\" />\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n    <input name=\"opacity\" type=\"color3\" nodegraph=\"NG_material\" output=\"opacity_output\" />\n$fi\n  </standard_surface>\n  <surfacematerial name=\"$(file_prefix)\" type=\"material\">\n    <input name=\"surfaceshader\" type=\"surfaceshader\" nodename=\"SR_$(file_prefix)\" />\n  </surfacematerial>\n</materialx>\n",
						"type": "template"
					},
					{
						"file_name": "$(path_prefix).glsl",
						"template": "// Procedural material generated by Material Maker: implementation of the\n// mm_procedural MaterialX node (genglsl)\n$inline_buffers\nfloat elapsed_time = 0.0;\n$definitions uniform_to_global\n\nvoid mm_procedural(vec2 texcoord, out vec3 base_color, out float metallic, out float roughness, out vec3 normal, out vec3 emission, out float opacity)\n{\n\tfloat _seed_variation_ = 0.0;\n\tvec4 _controlled_variation_ = vec4(0.0);\n\t// MaterialX's texture coordinates start at the bottom left of images\n\tvec2 uv = fract(vec2(texcoord.x, 1.0-texcoord.y));\n$begin_generate\n\tvec3 albedo_tex = $albedo_tex(uv);\n\tbase_color = mix(pow((albedo_tex+vec3(0.055))/1.055, vec3(2.4)), albedo_tex/12.92, lessThan(albedo_tex, vec3(0.04045)))*$albedo_color.rgb;\n\tmetallic = $metallic*$metallic_tex(uv);\n\troughness = $roughness*$roughness_tex(uv);\n\tnormal = $normal_tex(uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0);\n\tvec3 emission_tex = $emission_tex(uv);\n\temission = mix(pow((emission_tex+vec3(0.055))/1.055, vec3(2.4)), emission_tex/12.92, lessThan(emission_tex, vec3(0.04045)))*$emission_energy;\n\topacity = $opacity_tex(uv);\n$end_generate\n}\n",
						"type": "template"
					}
				]
			},
			"MaterialX/Standard Surface": {
				"export_extension": "mtlx",
				"files": [
					{
						"conditions": "$(connected:albedo_tex) or $(connected:opacity_tex)",
						"file_name": "$(path_prefix)_albedo.png",
						"output": 0,
						"type": "texture"
					},
					{
						"conditions": "$(connected:metallic_tex)",
						"file_name": "$(path_prefix)_metallic.png",
						"output": 12,
						"type": "texture"
					},
					{
						"conditions": "$(connected:roughness_tex)",
						"file_name": "$(path_prefix)_roughness.png",
						"output": 13,
						"type": "texture"
					},
					{
						"conditions": "$(connected:normal_tex)",
						"file_name": "$(path_prefix)_normal.png",
						"output": 3,
						"type": "texture"
					},
					{
						"conditions": "$(connected:emission_tex)",
						"file_name": "$(path_prefix)_emission.png",
						"output": 2,
						"type": "texture"
					},
					{
						"conditions": "$(connected:depth_tex)",
						"file_name": "$(path_prefix)_height.png",
						"output": 8,
						"type": "texture"
					},
					{
						"conditions": "$(connected:coat_tex)",
						"file_name": "$(path_prefix)_coat.png",
						"output": 15,
						"type": "texture"
					},
					{
						"conditions": "$(connected:coat_roughness_tex)",
						"file_name": "$(path_prefix)_coat_roughness.png",
						"output": 16,
						"type": "texture"
					},
					{
						"conditions": "$(connected:anisotropy_tex)",
						"file_name": "$(path_prefix)_anisotropy.png",
						"output": 17,
						"type": "texture"
					},
					{
						"conditions": "$(connected:sheen_tex)",
						"file_name": "$(path_prefix)_sheen.png",
						"output": 18,
						"type": "texture"
					},
					{
						"conditions": "$(connected:transmission_tex)",
						"file_name": "$(path_prefix)_transmission.png",
						"output": 19,
						"type": "texture"
					},
					{
						"file_name": "$(path_prefix).mtlx",
						"template": [
							"<?xml version=\"1.0\"?>",
							"<!-- Generated by Material Maker. Textures are exported next to this file. -->",
							"<materialx version=\"1.38\" colorspace=\"lin_rec709\">",
							"  <nodegraph name=\"NG_material\">",
							"$if $(connected:albedo_tex) or $(connected:opacity_tex)",
							"    <image name=\"albedo_image\" type=\"color4\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_albedo.png\" colorspace=\"srgb_texture\" />",
							"    </image>",
							"$fi",
							"$if $(connected:albedo_tex)",
							"    <convert name=\"albedo_rgb\" type=\"color3\">",
							"      <input name=\"in\" type=\"color4\" nodename=\"albedo_image\" />",
							"    </convert>",
							"    <multiply name=\"base_color\" type=\"color3\">",
							"      <input name=\"in1\" type=\"color3\" nodename=\"albedo_rgb\" />",
							"      <input name=\"in2\" type=\"color3\" value=\"$(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b)\" />",
							"    </multiply>",
							"    <output name=\"base_color_output\" type=\"color3\" nodename=\"base_color\" />",
							"$fi",
							"$if $(connected:opacity_tex)",
							"    <extract name=\"opacity\" type=\"float\">",
							"      <input name=\"in\" type=\"color4\" nodename=\"albedo_image\" />",
							"      <input name=\"index\" type=\"integer\" value=\"3\" />",
							"    </extract>",
							"    <convert name=\"opacity_color\" type=\"color3\">",
							"      <input name=\"in\" type=\"float\" nodename=\"opacity\" />",
							"    </convert>",
							"    <output name=\"opacity_output\" type=\"color3\" nodename=\"opacity_color\" />",
							"$fi",
							"$if $(connected:metallic_tex)",
							"    <image name=\"metallic_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_metallic.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"metallic\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"metallic_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:metallic)\" />",
							"    </multiply>",
							"    <output name=\"metallic_output\" type=\"float\" nodename=\"metallic\" />",
							"$fi",
							"$if $(connected:roughness_tex)",
							"    <image name=\"roughness_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_roughness.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"roughness\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"roughness_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:roughness)\" />",
							"    </multiply>",
							"    <output name=\"roughness_output\" type=\"float\" nodename=\"roughness\" />",
							"$fi",
							"$if $(connected:normal_tex)",
							"    <image name=\"normal_image\" type=\"vector3\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_normal.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <normalmap name=\"normal\" type=\"vector3\">",
							"      <input name=\"in\" type=\"vector3\" nodename=\"normal_image\" />",
							"      <input name=\"scale\" type=\"float\" value=\"$(param:normal)\" />",
							"    </normalmap>",
							"    <output name=\"normal_output\" type=\"vector3\" nodename=\"normal\" />",
							"$fi",
							"$if $(connected:emission_tex)",
							"    <image name=\"emission_image\" type=\"color3\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_emission.png\" colorspace=\"srgb_texture\" />",
							"    </image>",
							"    <output name=\"emission_output\" type=\"color3\" nodename=\"emission_image\" />",
							"$fi",
							"$if $(connected:depth_tex)",
							"    <image name=\"height_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_height.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <output name=\"height_output\" type=\"float\" nodename=\"height_image\" />",
							"$fi",
							"$if $(connected:coat_tex)",
							"    <image name=\"coat_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_coat.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"coat\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"coat_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:coat)\" />",
							"    </multiply>",
							"    <output name=\"coat_output\" type=\"float\" nodename=\"coat\" />",
							"$fi",
							"$if $(connected:coat_roughness_tex)",
							"    <image name=\"coat_roughness_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_coat_roughness.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"coat_roughness\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"coat_roughness_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:coat_roughness)\" />",
							"    </multiply>",
							"    <output name=\"coat_roughness_output\" type=\"float\" nodename=\"coat_roughness\" />",
							"$fi",
							"$if $(connected:anisotropy_tex)",
							"    <image name=\"anisotropy_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_anisotropy.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"anisotropy\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"anisotropy_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:anisotropy)\" />",
							"    </multiply>",
							"    <output name=\"anisotropy_output\" type=\"float\" nodename=\"anisotropy\" />",
							"$fi",
							"$if $(connected:sheen_tex)",
							"    <image name=\"sheen_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_sheen.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"sheen\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"sheen_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:sheen)\" />",
							"    </multiply>",
							"    <output name=\"sheen_output\" type=\"float\" nodename=\"sheen\" />",
							"$fi",
							"$if $(connected:transmission_tex)",
							"    <image name=\"transmission_image\" type=\"float\">",
							"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_transmission.png\" colorspace=\"raw\" />",
							"    </image>",
							"    <multiply name=\"transmission\" type=\"float\">",
							"      <input name=\"in1\" type=\"float\" nodename=\"transmission_image\" />",
							"      <input name=\"in2\" type=\"float\" value=\"$(param:transmission)\" />",
							"    </multiply>",
							"    <output name=\"transmission_output\" type=\"float\" nodename=\"transmission\" />",
							"$fi",
							"  </nodegraph>",
							"  <standard_surface name=\"SR_material\" type=\"surfaceshader\">",
							"$if $(connected:albedo_tex)",
							"    <input name=\"base_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"base_color_output\" />",
							"$else",
							"    <input name=\"base_color\" type=\"color3\" value=\"$(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b)\" />",
							"$fi",
							"$if $(connected:opacity_tex)",
							"    <input name=\"opacity\" type=\"color3\" nodegraph=\"NG_material\" output=\"opacity_output\" />",
							"$fi",
							"$if $(connected:metallic_tex)",
							"    <input name=\"metalness\" type=\"float\" nodegraph=\"NG_material\" output=\"metallic_output\" />",
							"$else",
							"    <input name=\"metalness\" type=\"float\" value=\"$(param:metallic)\" />",
							"$fi",
							"$if $(connected:roughness_tex)",
							"    <input name=\"specular_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"roughness_output\" />",
							"$else",
							"    <input name=\"specular_roughness\" type=\"float\" value=\"$(param:roughness)\" />",
							"$fi",
							"$if $(connected:normal_tex)",
							"    <input name=\"normal\" type=\"vector3\" nodegraph=\"NG_material\" output=\"normal_output\" />",
							"$fi",
							"$if $(connected:emission_tex)",
							"    <input name=\"emission\" type=\"float\" value=\"$(param:emission_energy)\" />",
							"    <input name=\"emission_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"emission_output\" />",
							"$fi",
							"$if $(connected:coat_tex)",
							"    <input name=\"coat\" type=\"float\" nodegraph=\"NG_material\" output=\"coat_output\" />",
							"$else",
							"    <input name=\"coat\" type=\"float\" value=\"$(param:coat)\" />",
							"$fi",
							"$if $(connected:coat_roughness_tex)",
							"    <input name=\"coat_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"coat_roughness_output\" />",
							"$else",
							"    <input name=\"coat_roughness\" type=\"float\" value=\"$(param:coat_roughness)\" />",
							"$fi",
							"$if $(connected:anisotropy_tex)",
							"    <input name=\"specular_anisotropy\" type=\"float\" nodegraph=\"NG_material\" output=\"anisotropy_output\" />",
							"$else",
							"    <input name=\"specular_anisotropy\" type=\"float\" value=\"$(param:anisotropy)\" />",
							"$fi",
							"$if $(connected:sheen_tex)",
							"    <input name=\"sheen\" type=\"float\" nodegraph=\"NG_material\" output=\"sheen_output\" />",
							"$else",
							"    <input name=\"sheen\" type=\"float\" value=\"$(param:sheen)\" />",
							"$fi",
							"$if $(connected:transmission_tex)",
							"    <input name=\"transmission\" type=\"float\" nodegraph=\"NG_material\" output=\"transmission_output\" />",
							"$else",
							"    <input name=\"transmission\" type=\"float\" value=\"$(param:transmission)\" />",
							"$fi",
							"  </standard_surface>",
							"$if $(connected:depth_tex)",
							"  <displacement name=\"DS_material\" type=\"displacementshader\">",
							"    <input name=\"displacement\" type=\"float\" nodegraph=\"NG_material\" output=\"height_output\" />",
							"    <input name=\"scale\" type=\"float\" value=\"$(param:depth_scale)\" />",
							"  </displacement>",
							"$fi",
							"  <surfacematerial name=\"M_material\" type=\"material\">",
							"    <input name=\"surfaceshader\" type=\"surfaceshader\" nodename=\"SR_material\" />",
							"$if $(connected:depth_tex)",
							"    <input name=\"displacementshader\" type=\"displacementshader\" nodename=\"DS_material\" />",
							"$fi",
							"  </surfacematerial>",
							"</materialx>"
						],
						"type": "template"
					}
				]
			},
			"USD/UsdPreviewSurface": {
				"export_extension": "usda",
				"files": [
					{
						"conditions": "$(connected:albedo_tex) or $(connected:opacity_tex)",
						"file_name": "$(path_prefix)_albedo.png",
						"output": 0,
						"type": "texture"
					},
					{
						"conditions": "$(connected:metallic_tex)",
						"file_name": "$(path_prefix)_metallic.png",
						"output": 12,
						"type": "texture"
					},
					{
						"conditions": "$(connected:roughness_tex)",
						"file_name": "$(path_prefix)_roughness.png",
						"output": 13,
						"type": "texture"
					},
					{
						"conditions": "$(connected:normal_tex)",
						"file_name": "$(path_prefix)_normal.png",
						"output": 3,
						"type": "texture"
					},
					{
						"conditions": "$(connected:emission_tex)",
						"file_name": "$(path_prefix)_emission.png",
						"output": 2,
						"type": "texture"
					},
					{
						"conditions": "$(connected:depth_tex)",
						"file_name": "$(path_prefix)_height.png",
						"output": 8,
						"type": "texture"
					},
					{
						"conditions": "$(connected:ao_tex)",
						"file_name": "$(path_prefix)_ao.png",
						"output": 9,
						"type": "texture"
					},
					{
						"conditions": "$(connected:coat_tex)",
						"file_name": "$(path_prefix)_coat.png",
						"output": 15,
						"type": "texture"
					},
					{
						"conditions": "$(connected:coat_roughness_tex)",
						"file_name": "$(path_prefix)_coat_roughness.png",
						"output": 16,
						"type": "texture"
					},
					{
						"file_name": "$(path_prefix).usda",
						"template": [
							"#usda 1.0",
							"(",
							"    doc = \"Generated by Material Maker. Textures are exported next to this file.\"",
							"    defaultPrim = \"Material\"",
							")",
							"def Material \"Material\"",
							"{",
							"    token outputs:surface.connect = </Material/preview_surface.outputs:surface>",
							"$if $(connected:depth_tex)",
							"    token outputs:displacement.connect = </Material/preview_surface.outputs:displacement>",
							"$fi",
							"    def Shader \"preview_surface\"",
							"    {",
							"        uniform token info:id = \"UsdPreviewSurface\"",
							"$if $(connected:albedo_tex)",
							"        color3f inputs:diffuseColor.connect = </Material/albedo_texture.outputs:rgb>",
							"$else",
							"        color3f inputs:diffuseColor = ($(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b))",
							"$fi",
							"$if $(connected:opacity_tex)",
							"        float inputs:opacity.connect = </Material/albedo_texture.outputs:a>",
							"$fi",
							"$if $(connected:ao_tex)",
							"        float inputs:occlusion.connect = </Material/ao_texture.outputs:r>",
							"$fi",
							"$if $(connected:metallic_tex)",
							"        float inputs:metallic.connect = </Material/metallic_texture.outputs:r>",
							"$else",
							"        float inputs:metallic = $(param:metallic)",
							"$fi",
							"$if $(connected:roughness_tex)",
							"        float inputs:roughness.connect = </Material/roughness_texture.outputs:r>",
							"$else",
							"        float inputs:roughness = $(param:roughness)",
							"$fi",
							"$if $(connected:normal_tex)",
							"        normal3f inputs:normal.connect = </Material/normal_texture.outputs:rgb>",
							"$fi",
							"$if $(connected:emission_tex)",
							"        color3f inputs:emissiveColor.connect = </Material/emission_texture.outputs:rgb>",
							"$fi",
							"$if $(connected:depth_tex)",
							"        float inputs:displacement.connect = </Material/height_texture.outputs:r>",
							"$fi",
							"$if $(connected:coat_tex)",
							"        float inputs:clearcoat.connect = </Material/coat_texture.outputs:r>",
							"$else",
							"        float inputs:clearcoat = $(param:coat)",
							"$fi",
							"$if $(connected:coat_roughness_tex)",
							"        float inputs:clearcoatRoughness.connect = </Material/coat_roughness_texture.outputs:r>",
							"$else",
							"        float inputs:clearcoatRoughness = $(param:coat_roughness)",
							"$fi",
							"        token outputs:surface",
							"        token outputs:displacement",
							"    }",
							"    def Shader \"st_reader\"",
							"    {",
							"        uniform token info:id = \"UsdPrimvarReader_float2\"",
							"        string inputs:varname = \"st\"",
							"        float2 outputs:result",
							"    }",
							"$if $(connected:albedo_tex) or $(connected:opacity_tex)",
							"    def Shader \"albedo_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_albedo.png@",
							"        token inputs:sourceColorSpace = \"sRGB\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b), 1.0)",
							"        float3 outputs:rgb",
							"        float outputs:a",
							"    }",
							"$fi",
							"$if $(connected:metallic_tex)",
							"    def Shader \"metallic_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_metallic.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:metallic), $(param:metallic), $(param:metallic), 1.0)",
							"        float outputs:r",
							"    }",
							"$fi",
							"$if $(connected:roughness_tex)",
							"    def Shader \"roughness_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_roughness.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:roughness), $(param:roughness), $(param:roughness), 1.0)",
							"        float outputs:r",
							"    }",
							"$fi",
							"$if $(connected:normal_tex)",
							"    def Shader \"normal_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_normal.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = (2.0, 2.0, 2.0, 1.0)",
							"        float4 inputs:bias = (-1.0, -1.0, -1.0, 0.0)",
							"        float3 outputs:rgb",
							"    }",
							"$fi",
							"$if $(connected:emission_tex)",
							"    def Shader \"emission_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_emission.png@",
							"        token inputs:sourceColorSpace = \"sRGB\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:emission_energy), $(param:emission_energy), $(param:emission_energy), 1.0)",
							"        float3 outputs:rgb",
							"    }",
							"$fi",
							"$if $(connected:depth_tex)",
							"    def Shader \"height_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_height.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:depth_scale), $(param:depth_scale), $(param:depth_scale), 1.0)",
							"        float outputs:r",
							"    }",
							"$fi",
							"$if $(connected:ao_tex)",
							"    def Shader \"ao_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_ao.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float outputs:r",
							"    }",
							"$fi",
							"$if $(connected:coat_tex)",
							"    def Shader \"coat_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_coat.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:coat), $(param:coat), $(param:coat), 1.0)",
							"        float outputs:r",
							"    }",
							"$fi",
							"$if $(connected:coat_roughness_tex)",
							"    def Shader \"coat_roughness_texture\"",
							"    {",
							"        uniform token info:id = \"UsdUVTexture\"",
							"        asset inputs:file = @./$(file_prefix)_coat_roughness.png@",
							"        token inputs:sourceColorSpace = \"raw\"",
							"        float2 inputs:st.connect = </Material/st_reader.outputs:result>",
							"        token inputs:wrapS = \"repeat\"",
							"        token inputs:wrapT = \"repeat\"",
							"        float4 inputs:scale = ($(param:coat_roughness), $(param:coat_roughness), $(param:coat_roughness), 1.0)",
							"        float outputs:r",
							"    }",
							"$fi",
							"}"
						],
						"type": "template"
					}
				]
			},
			"Unity/3D": {
