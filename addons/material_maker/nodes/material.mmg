							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
							"    - _MainTex:",
							"$if $(connected:albedo_tex)",
							"        m_Texture: {fileID: 2800000, guid: $uid(0), type: 3}",
							"$else",
							"        m_Texture: {fileID: 0}",
							"$fi",
							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
							"    - _MetallicGlossMap:",
							"$if $(connected:roughness_tex) or $(connected:metallic_tex)",
							"        m_Texture: {fileID: 2800000, guid: $uid(1), type: 3}",
							"$else",
							"        m_Texture: {fileID: 0}",
							"$fi",
							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
							"    - _OcclusionMap:",
							"$if $(connected:ao_tex)",
							"        m_Texture: {fileID: 2800000, guid: $uid(4), type: 3}",
							"$else",
							"        m_Texture: {fileID: 0}",
							"$fi",
							"        m_Scale: {x: 1, y: 1}",
							"        m_Offset: {x: 0, y: 0}",
