		{
			"name": "normal",
			"node_position": {
				"x": 1450,
				"y": 150
			},
			"parameters": {
				"size": 10,
				"strength": 0.2
			},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "0.5",
						"function": true,
						"label": "",
						"longdesc": "The height map",
						"name": "in",
						"shortdesc": "Height",
						"type": "f"
					}
				],
				"instance": [
					"vec3 $(name)_normal(vec2 uv) {",
					"\tvec3 e = vec3(1.0/$size, -1.0/$size, 0.0);",
					"\tvec2 rv = vec2(1.0, -1.0)*$in(uv+e.xy);",
					"\trv += vec2(-1.0, 1.0)*$in(uv-e.xy);",
					"\trv += vec2(1.0, 1.0)*$in(uv+e.xx);",
					"\trv += vec2(-1.0, -1.0)*$in(uv-e.xx);",
					"\trv += vec2(2.0, 0.0)*$in(uv+e.xz);",
					"\trv += vec2(-2.0, 0.0)*$in(uv-e.xz);",
					"\trv += vec2(0.0, 2.0)*$in(uv+e.zx);",
					"\trv += vec2(0.0, -2.0)*$in(uv-e.zx);",
					"\treturn 0.5*normalize(vec3(rv*$strength*$size/128.0, -1.0))+vec3(0.5);",
					"}"
				],
				"longdesc": "Normal",
				"name": "Normal",
				"outputs": [
					{
						"longdesc": "The normal map",
						"rgb": "$(name)_normal($uv)",
						"shortdesc": "Normal",
						"type": "rgb"
					}
				],
				"parameters": [
					{
						"default": 10,
						"first": 4,
						"label": "Size",
						"last": 13,
						"longdesc": "The resolution of the height map",
						"name": "size",
						"shortdesc": "Size",
						"type": "size"
					},
					{
						"control": "None",
						"default": 0.2,
						"label": "Strength",
						"longdesc": "The strength of the normal map",
						"max": 4.0,
						"min": 0.0,
						"name": "strength",
						"shortdesc": "Strength",
						"step": 0.01,
						"type": "float"
					}
				],
				"shortdesc": "Normal"
			},
			"type": "shader"
		},
