		{
			"name": "lighting_by",
			"node_position": {
				"x": 400,
				"y": 300
			},
			"parameters": {
				"size": 9
			},
			"seed_int": 0,
			"type": "buffer",
			"version": 1
		},
		{
			"name": "mean",
			"node_position": {
				"x": 600,
				"y": 450
			},
			"parameters": {},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "0.0",
						"function": true,
						"label": "",
						"longdesc": "The image",
						"name": "in",
						"shortdesc": "Input",
						"type": "f"
					}
				],
				"instance": [
					"float $(name)_mean(vec2 uv) {",
					"\tfloat sum = 0.0;",
					"\tfor (int y = 0; y < 64; ++y) {",
					"\t\tfor (int x = 0; x < 64; ++x) {",
					"\t\t\tsum += $in((vec2(float(x), float(y))+vec2(0.5))/64.0);",
					"\t\t}",
					"\t}",
					"\treturn sum/4096.0;",
					"}"
				],
				"longdesc": "Mean",
				"name": "Mean",
				"outputs": [
					{
						"f": "$(name)_mean($uv)",
						"longdesc": "The average of the image",
						"shortdesc": "Mean",
						"type": "f"
					}
				],
				"parameters": [],
				"shortdesc": "Mean"
			},
			"type": "shader"
		},
		{
			"name": "mean_buffer",
			"node_position": {
				"x": 800,
				"y": 450
			},
			"parameters": {
				"size": 4
			},
			"seed_int": 0,
			"type": "buffer",
			"version": 1
		},
		{
			"name": "maps",
			"node_position": {
				"x": 1000,
				"y": 0
			},
			"parameters": {
				"ao": 1.0,
				"delight": 1.0,
				"height_contrast": 1.0,
				"invert": false,
				"roughness_max": 0.9,
				"roughness_min": 0.4
			},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "vec4(0.5)",
						"function": true,
						"label": "",
						"longdesc": "The photo",
						"name": "in",
						"shortdesc": "Photo",
						"type": "rgba"
					},
					{
						"default": "0.5",
						"function": true,
						"label": "",
						"longdesc": "The luminance blurred by the detail radius",
						"name": "detail",
						"shortdesc": "Detail",
						"type": "f"
					},
					{
						"default": "0.5",
						"function": true,
						"label": "",
						"longdesc": "The luminance blurred by twice the detail radius",
						"name": "lighting",
						"shortdesc": "Lighting",
						"type": "f"
					},
					{
						"default": "0.5",
						"function": true,
						"label": "",
						"longdesc": "The average luminance",
						"name": "mean",
						"shortdesc": "Mean",
						"type": "f"
					}
				],
				"instance": [
					"vec3 $(name)_albedo(vec2 uv) {",
					"\tvec3 c = $in(uv).rgb;",
					"\tfloat gain = $mean(vec2(0.5))/max($lighting(uv), 0.002);",
					"\treturn clamp(c*mix(1.0, min(gain, 64.0), $delight), vec3(0.0), vec3(1.0));",
					"}",
					"",
					"// Details are the luminance minus its blur, relative to the local lighting,",
					"// so their contrast does not depend on how bright the area is",
					"float $(name)_height(vec2 uv) {",
					"\tfloat detail = (dot($in(uv).rgb, vec3(0.2126, 0.7152, 0.0722))-$detail(uv))/max($lighting(uv), 0.002);",
					"\tfloat h = clamp(0.5+$height_contrast*detail, 0.0, 1.0);",
					"\treturn $invert ? 1.0-h : h;",
					"}"
				],
				"longdesc": "Photo maps",
				"name": "Photo maps",
				"outputs": [
					{
						"longdesc": "The photo without large scale lighting variations",
						"rgb": "$(name)_albedo($uv)",
						"shortdesc": "Albedo",
						"type": "rgb"
					},
					{
						"f": "$(name)_height($uv)",
						"longdesc": "The height",
						"shortdesc": "Height",
						"type": "f"
					},
					{
						"f": "mix($roughness_min, $roughness_max, 1.0-clamp(dot($(name)_albedo($uv), vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0))",
						"longdesc": "The roughness",
						"shortdesc": "Roughness",
						"type": "f"
					},
					{
						"f": "clamp(1.0-2.0*$ao*max(0.5-$(name)_height($uv), 0.0), 0.0, 1.0)",
						"longdesc": "The ambient occlusion",
						"shortdesc": "Ambient occlusion",
						"type": "f"
					}
				],
				"parameters": [
