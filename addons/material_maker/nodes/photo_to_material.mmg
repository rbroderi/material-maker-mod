						"control": "None",
						"default": 1.0,
						"label": "Delight",
						"longdesc": "How much large scale lighting is removed from the albedo",
						"max": 1.0,
						"min": 0.0,
						"name": "delight",
						"shortdesc": "Delight",
						"step": 0.01,
						"type": "float"
					},
					{
