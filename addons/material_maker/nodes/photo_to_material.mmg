					"\t\tfloat w = exp(-0.5*x*x/(sigma*sigma));",
					"\t\tvec2 p = uv+vec2(0.0, 1.0)*x;",
					"\t\tp = $tileable ? fract(p) : vec2(1.0)-abs(vec2(1.0)-mod(p, vec2(2.0)));",
