	"label": "Photo to Material",
	"longdesc": "Generates material maps from a single photo: a delit albedo, and height, normal, roughness and ambient occlusion maps estimated from its details",
	"name": "photo_to_material",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"nodes": [
		{
			"name": "gen_inputs",
			"node_position": {
				"x": -800,
				"y": 0
			},
			"parameters": {},
			"ports": [
				{
					"group_size": 0,
					"longdesc": "The photo of a surface, ideally lit evenly from the front",
					"name": "in",
					"shortdesc": "Photo",
					"type": "rgba"
				}
			],
			"seed_int": 0,
			"type": "ios"
		},
		{
			"name": "luminance",
			"node_position": {
				"x": -600,
				"y": 100
			},
			"parameters": {},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "vec4(0.0)",
						"function": true,
						"label": "",
						"longdesc": "The image",
						"name": "in",
						"shortdesc": "Input",
						"type": "rgba"
					}
				],
				"instance": "",
				"longdesc": "Luminance",
				"name": "Luminance",
				"outputs": [
					{
						"f": "dot($in($uv).rgb, vec3(0.2126, 0.7152, 0.0722))",
						"longdesc": "The luminance",
						"shortdesc": "Luminance",
						"type": "f"
					}
				],
				"parameters": [],
				"shortdesc": "Luminance"
			},
			"type": "shader"
		},
		{
			"name": "luminance_buffer",
			"node_position": {
				"x": -400,
				"y": 100
			},
			"parameters": {
				"size": 9
			},
			"seed_int": 0,
			"type": "buffer",
			"version": 1
		},
		{
			"name": "detail_x",
			"node_position": {
				"x": -200,
				"y": 100
			},
			"parameters": {
				"factor": 1.0,
				"radius": 0.05,
				"tileable": true
			},
			"seed_int": 0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "0.0",
						"function": true,
						"label": "",
						"longdesc": "The image",
						"name": "in",
						"shortdesc": "Input",
						"type": "f"
					}
				],
				"instance": [
					"float $(name)_blur(vec2 uv) {",
					"\tfloat sigma = max(0.5*$radius*$factor, 0.0005);",
					"\t// 65 taps over 3 sigmas each side",
					"\tfloat step = 3.0*sigma/32.0;",
					"\tfloat sum = 0.0;",
					"\tfloat weight_sum = 0.0;",
					"\tfor (int i = -32; i <= 32; ++i) {",
					"\t\tfloat x = float(i)*step;",
					"\t\tfloat w = exp(-0.5*x*x/(sigma*sigma));",
					"\t\tvec2 p = uv+vec2(1.0, 0.0)*x;",
					"\t\tp = $tileable ? fract(p) : vec2(1.0)-abs(vec2(1.0)-mod(p, vec2(2.0)));",
					"\t\tsum += w*$in(p);",
					"\t\tweight_sum += w;",
					"\t}",
					"\treturn sum/weight_sum;",
					"}"
				],
				"longdesc": "Blur",
				"name": "Blur",
				"outputs": [
					{
						"f": "$(name)_blur($uv)",
						"longdesc": "The blurred image",
						"shortdesc": "Output",
						"type": "f"
					}
				],
				"parameters": [
					{
						"control": "None",
						"default": 0.1,
						"label": "Radius",
						"longdesc": "The blur radius",
						"max": 1.0,
						"min": 0.0,
						"name": "radius",
						"shortdesc": "Radius",
						"step": 0.001,
						"type": "float"
					},
					{
						"control": "None",
						"default": 1.0,
						"label": "Factor",
						"longdesc": "Multiplies the radius",
						"max": 4.0,
						"min": 0.0,
						"name": "factor",
						"shortdesc": "Factor",
						"step": 0.001,
						"type": "float"
					},
					{
						"default": false,
						"label": "Tileable",
						"longdesc": "Wraps around the image's edges instead of mirroring",
						"name": "tileable",
						"shortdesc": "Tileable",
						"type": "boolean"
					}
				],
				"shortdesc": "Blur"
			},
			"type": "shader"
		},
