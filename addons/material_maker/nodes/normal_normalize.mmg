{
	"name": "normal_normalize",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"format": 0
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": [
			"// Normal maps store 0.5+0.5*n. z_sign is -1.0 for Material Maker's default format (z is",
			"// inverted) and 1.0 for OpenGL and DirectX normal maps.",
			"vec3 mm_normal_safe_normalize(vec3 n) {",
			"\tfloat l = dot(n, n);",
			"\treturn (l > 1e-12) ? n*inversesqrt(l) : vec3(0.0, 0.0, 1.0);",
			"}",
			"",
			"// Decodes a normal as a unit vector that does not point into the surface (z >= 0)",
			"vec3 mm_normal_decode(vec3 c, float z_sign) {",
			"\tvec3 n = vec3(2.0*c.xy-vec2(1.0), z_sign*(2.0*c.z-1.0));",
			"\tn.z = max(n.z, 0.0);",
			"\treturn mm_normal_safe_normalize(n);",
			"}",
			"",
			"vec3 mm_normal_encode(vec3 n, float z_sign) {",
			"\treturn vec3(0.5)+0.5*vec3(n.xy, z_sign*n.z);",
			"}",
			""
		],
		"inputs": [
			{
				"default": "vec3(0.5, 0.5, $format == 0 ? 0.0 : 1.0)",
				"function": true,
				"label": "",
				"longdesc": "The normal map",
				"name": "in",
				"shortdesc": "Input",
				"type": "rgb"
			}
		],
		"instance": "",
		"longdesc": "Normalizes the vectors of a normal map, for example after blending, filtering or resizing it. Null vectors become flat normals, and normals that point into the surface are moved onto it",
		"name": "Normal Normalize",
		"outputs": [
			{
				"longdesc": "The normalized normal map",
				"rgb": "mm_normal_encode(mm_normal_decode($in($uv), ($format == 0 ? -1.0 : 1.0)), ($format == 0 ? -1.0 : 1.0))",
				"shortdesc": "Output",
				"type": "rgb"
			}
		],
		"parameters": [
			{
				"default": 0,
				"label": "Format",
				"longdesc": "The format of the normal maps. The default format is the one of the Normal Map node's default output (z is inverted). OpenGL and DirectX normal maps store z as is, and the result does not depend on the orientation of x and y, as long as all inputs use the same format",
				"name": "format",
				"shortdesc": "Format",
				"type": "enum",
				"values": [
					{
						"name": "Default",
						"value": "0"
					},
					{
						"name": "OpenGL",
						"value": "1"
					},
					{
						"name": "DirectX",
						"value": "2"
					}
				]
			}
		],
		"shortdesc": "Normal Normalize"
	},
	"type": "shader"
}