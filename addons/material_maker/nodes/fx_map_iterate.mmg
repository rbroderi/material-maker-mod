{
	"name": "fx_map_iterate",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"count": 16.0,
		"x": "r1",
		"y": "r2",
		"scale": "0.1+0.1*r3",
		"rotation": "360.0*r4",
		"value": 1.0,
		"opacity": 1.0,
		"pattern": 0.0,
		"blend": 0,
		"inner_count": 1.0,
		"group_x": 0.5,
		"group_y": 0.5,
		"group_scale": 1.0,
		"group_rotation": 0.0
	},
	"shader_model": {
		"code": "float $(name_uv)_id;\nvec4 $(name_uv)_fx = $(name)_iterate($uv, $(name_uv)_id);",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 1 (its alpha is the coverage of instances)",
				"name": "in1",
				"shortdesc": "Pattern 1",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 2 (its alpha is the coverage of instances)",
				"name": "in2",
				"shortdesc": "Pattern 2",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 3 (its alpha is the coverage of instances)",
				"name": "in3",
				"shortdesc": "Pattern 3",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 4 (its alpha is the coverage of instances)",
				"name": "in4",
				"shortdesc": "Pattern 4",
				"type": "rgba"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A map that expressions can sample with $map(uv)",
				"name": "map",
				"shortdesc": "Map",
				"type": "f"
			}
		],
		"instance": [
			"// Instances are computed by expressions of the group index i (0 to n-1),",
			"// t = i/(n-1), the index in the group j (0 to m-1), u = j/(m-1), the",
			"// per-instance random values r1 to r4, the per-group ones g1 and g2, and seed",
			"vec4 $(name)_pattern(int index, vec2 uv) {",
			"\tif (index <= 0) {",
			"\t\treturn $in1(uv);",
			"\t} else if (index == 1) {",
			"\t\treturn $in2(uv);",
			"\t} else if (index == 2) {",
			"\t\treturn $in3(uv);",
			"\t}",
			"\treturn $in4(uv);",
			"}",
			"",
			"vec4 $(name)_iterate(vec2 uv, out float instance_id) {",
			"\tvec4 result = vec4(0.0);",
			"\tinstance_id = 0.0;",
			"\tint count = clamp(int($count), 0, 256);",
			"\tfloat n = float(count);",
			"\tint inner_count = clamp(int($inner_count), 1, 64);",
			"\tfloat m = float(inner_count);",
			"\tfor (int k = 0; k < count; ++k) {",
			"\t\tfloat i = float(k);",
			"\t\tfloat t = i/max(n-1.0, 1.0);",
			"\t\tfloat g1 = rand(vec2(i*0.137+$seed, 5.83));",
			"\t\tfloat g2 = rand(vec2(i*0.137+$seed, 6.29));",
			"\t\tvec2 group_center = vec2($group_x, $group_y);",
			"\t\tfloat group_scale = $group_scale;",
			"\t\tfloat group_angle = radians($group_rotation);",
			"\t\tmat2 group_rotation = mat2(vec2(cos(group_angle), sin(group_angle)), vec2(-sin(group_angle), cos(group_angle)));",
			"\t\tfor (int l = 0; l < inner_count; ++l) {",
			"\t\t\tfloat j = float(l);",
			"\t\t\tfloat u = j/max(m-1.0, 1.0);",
			"\t\t\tfloat r1 = rand(vec2(i*0.137+j*0.0731+$seed, 0.71));",
			"\t\t\tfloat r2 = rand(vec2(i*0.137+j*0.0731+$seed, 1.93));",
			"\t\t\tfloat r3 = rand(vec2(i*0.137+j*0.0731+$seed, 3.17));",
			"\t\t\tfloat r4 = rand(vec2(i*0.137+j*0.0731+$seed, 4.59));",
			"\t\t\t// Instance in the group's space, then in the image",
			"\t\t\tvec2 p = group_center+group_rotation*((vec2($x, $y)-vec2(0.5))*group_scale);",
			"\t\t\tfloat s = max($scale*group_scale, 0.000001);",
			"\t\t\tfloat a = radians($rotation)+group_angle;",
			"\t\t\t// The nearest copy of the instance, so the result tiles",
			"\t\t\tvec2 d = uv-p;",
			"\t\t\td -= floor(d+vec2(0.5));",
			"\t\t\tvec2 local = mat2(vec2(cos(a), -sin(a)), vec2(sin(a), cos(a)))*d/s;",
			"\t\t\tif (abs(local.x) > 0.5 || abs(local.y) > 0.5) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tvec4 color = $(name)_pattern(int($pattern), local+vec2(0.5));",
			"\t\t\tcolor.rgb *= $value;",
			"\t\t\tfloat opacity = clamp(color.a*$opacity, 0.0, 1.0);",
			"\t\t\tif (opacity <= 0.0) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tif ($blend == 0) {",
			"\t\t\t\tresult = vec4(mix(result.rgb, color.rgb, opacity), opacity+result.a*(1.0-opacity));",
			"\t\t\t} else if ($blend == 1) {",
			"\t\t\t\tresult = vec4(result.rgb+color.rgb*opacity, max(result.a, opacity));",
			"\t\t\t} else {",
			"\t\t\t\tresult = max(result, vec4(color.rgb*opacity, opacity));",
			"\t\t\t}",
			"\t\t\tinstance_id = (i*m+j)/max(n*m-1.0, 1.0);",
			"\t\t}",
			"\t}",
			"\treturn result;",
			"}"
		],
		"longdesc": "Splats instances of patterns whose position, size, rotation, value, opacity and pattern are expressions of the instance index and random values, like Substance Designer's FX-Map Iterate and Switch nodes. Parameters can be edited with the expression and function graph editors. Groups of instances (nested iterations) are placed with their own position, scale and rotation",
		"name": "FX-Map Iterate",
		"outputs": [
			{
				"rgba": "$(name_uv)_fx",
				"longdesc": "The splatted patterns",
				"shortdesc": "Output",
				"type": "rgba"
			},
			{
				"f": "$(name_uv)_id",
				"longdesc": "The position of the topmost instance in the sequence of all instances (0 to 1)",
				"shortdesc": "Instance",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 16.0,
				"label": "Count",
				"longdesc": "The number of instances (up to 256)",
				"max": 256.0,
				"min": 0.0,
				"name": "count",
				"shortdesc": "Count",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Count in group",
				"longdesc": "The number of instances in each group (nested iteration). With 1, each group is a single instance",
				"max": 64.0,
				"min": 1.0,
				"name": "inner_count",
				"shortdesc": "Count in group",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Group X",
				"longdesc": "The x position of each group's center. Can be an expression of i, n, t, g1, g2 and $seed",
				"max": 1.0,
				"min": 0.0,
				"name": "group_x",
				"shortdesc": "Group X",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Group Y",
				"longdesc": "The y position of each group's center. Can be an expression of i, n, t, g1, g2 and $seed",
				"max": 1.0,
				"min": 0.0,
				"name": "group_y",
				"shortdesc": "Group Y",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Group scale",
				"longdesc": "The size of each group: instances are placed in a square of this size around its center. Can be an expression of i, n, t, g1, g2 and $seed",
				"max": 2.0,
				"min": 0.0,
				"name": "group_scale",
				"shortdesc": "Group scale",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Group rotation",
				"longdesc": "The rotation of each group, in degrees. Can be an expression of i, n, t, g1, g2 and $seed",
				"max": 180.0,
				"min": -180.0,
				"name": "group_rotation",
				"shortdesc": "Group rotation",
				"step": 0.1,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": "r1",
				"label": "X",
				"longdesc": "The x position of each instance. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 1.0,
				"min": 0.0,
				"name": "x",
				"shortdesc": "X",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": "r2",
				"label": "Y",
				"longdesc": "The y position of each instance. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 1.0,
				"min": 0.0,
				"name": "y",
				"shortdesc": "Y",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": "0.1+0.1*r3",
				"label": "Scale",
				"longdesc": "The size of each instance. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 1.0,
				"min": 0.0,
				"name": "scale",
				"shortdesc": "Scale",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": "360.0*r4",
				"label": "Rotation",
				"longdesc": "The rotation of each instance, in degrees. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 360.0,
				"min": -360.0,
				"name": "rotation",
				"shortdesc": "Rotation",
				"step": 1.0,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Value",
				"longdesc": "Multiplies the color of each instance. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 1.0,
				"min": 0.0,
				"name": "value",
				"shortdesc": "Value",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Opacity",
				"longdesc": "The opacity of each instance. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 1.0,
				"min": 0.0,
				"name": "opacity",
				"shortdesc": "Opacity",
				"step": 0.01,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Pattern",
				"longdesc": "The pattern input (0 to 3) of each instance, as a Switch node. Can be an expression of i (the group index, from 0), n (the group count), t (i/(n-1)), j (the index in the group), m (the count in the group), u (j/(m-1)), r1, r2, r3 and r4 (random values for the instance), g1 and g2 (random values for the group) and $seed, and use inputs",
				"max": 3.0,
				"min": 0.0,
				"name": "pattern",
				"shortdesc": "Pattern",
				"step": 1.0,
				"type": "float",
				"expression_variables": [
					"i",
					"n",
					"t",
					"j",
					"m",
					"u",
					"r1",
					"r2",
					"r3",
					"r4",
					"g1",
					"g2"
				]
			},
			{
				"default": 0,
				"label": "Blend",
				"longdesc": "How instances are combined (later instances are drawn over earlier ones)",
				"name": "blend",
				"shortdesc": "Blend",
				"type": "enum",
				"values": [
					{
						"name": "Alpha over",
						"value": "0"
					},
					{
						"name": "Add",
						"value": "1"
					},
					{
						"name": "Max",
						"value": "2"
					}
				]
			}
		],
		"shortdesc": "FX-Map Iterate"
	}
}