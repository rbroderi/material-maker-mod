#define PI 3.14159265359
#define TAU 2.0*PI
#define hlsl_atan(x,y) atan2(x, y)
#define mod(x,y) ((x)-(y)*floor((x)/(y)))

inline float4 textureLod(sampler2D tex, float2 uv, float lod) {
    return tex2D(tex, uv);
}

// int vector funtions

inline int2 toint2(int x) {
    return int2(x, x);
}
inline int2 toint2(int x, int y) {
    return int2(x, y);
}
// Copies (and conversions of float vectors), and truncations of larger
// vectors, as GLSL's constructors
inline int2 toint2(int2 v) {
    return v;
}
inline int2 toint2(int3 v) {
    return v.xy;
}
inline int2 toint2(int4 v) {
    return v.xy;
}
inline int3 toint3(int3 v) {
    return v;
}
inline int3 toint3(int4 v) {
    return v.xyz;
}
inline int4 toint4(int4 v) {
    return v;
}

inline int3 toint3(int x) {
    return int3(x, x, x);
}
inline int3 toint3(int x, int y, int z) {
    return int3(x, y, z);
}
inline int3 toint3(int2 xy, int z) {
    return int3(xy.x, xy.y, z);
}
inline int3 toint3(int x, int2 yz) {
    return int3(x, yz.x, yz.y);
}

inline int4 toint4(int x, int y, int z, int w) {
    return int4(x, y, z, w);
}
inline int4 toint4(int x) {
    return int4(x, x, x, x);
}
inline int4 toint4(int x, int3 yzw) {
    return int4(x, yzw.x, yzw.y, yzw.z);
}
inline int4 toint4(int2 xy, int2 zw) {
    return int4(xy.x, xy.y, zw.x, zw.y);
}
inline int4 toint4(int3 xyz, int w) {
    return int4(xyz.x, xyz.y, xyz.z, w);
}
inline int4 toint4(int2 xy, int z, int w) {
    return int4(xy.x, xy.y, z, w);
}
inline int4 toint4(int x, int2 yz, int w) {
    return int4(x, yz.x, yz.y, w);
}
inline int4 toint4(int x, int y, int2 zw) {
    return int4(x, y, zw.x, zw.y);
}

// GLSL bit casts (used by integer hashes)
inline uint floatBitsToUint(float x) {
    return asuint(x);
}
inline int floatBitsToInt(float x) {
    return asint(x);
}
inline float uintBitsToFloat(uint x) {
    return asfloat(x);
}

