// GLSL mat3/mat4 constructors: arguments are columns (column-major), stored
// so that mul(m, v) is GLSL's m*v
inline float3x3 tofloat3x3(float s) {
    return float3x3(s, 0.0, 0.0, 0.0, s, 0.0, 0.0, 0.0, s);
}
inline float3x3 tofloat3x3(float3 c0, float3 c1, float3 c2) {
    return float3x3(c0.x, c1.x, c2.x, c0.y, c1.y, c2.y, c0.z, c1.z, c2.z);
}
inline float3x3 tofloat3x3(float a0, float a1, float a2, float b0, float b1, float b2, float c0, float c1, float c2) {
    return float3x3(a0, b0, c0, a1, b1, c1, a2, b2, c2);
}
inline float4x4 tofloat4x4(float s) {
    return float4x4(s, 0.0, 0.0, 0.0, 0.0, s, 0.0, 0.0, 0.0, 0.0, s, 0.0, 0.0, 0.0, 0.0, s);
}
inline float4x4 tofloat4x4(float4 c0, float4 c1, float4 c2, float4 c3) {
    return float4x4(c0.x, c1.x, c2.x, c3.x, c0.y, c1.y, c2.y, c3.y, c0.z, c1.z, c2.z, c3.z, c0.w, c1.w, c2.w, c3.w);
}
inline float4x4 tofloat4x4(float a0, float a1, float a2, float a3, float b0, float b1, float b2, float b3, float c0, float c1, float c2, float c3, float d0, float d1, float d2, float d3) {
    return float4x4(a0, b0, c0, d0, a1, b1, c1, d1, a2, b2, c2, d2, a3, b3, c3, d3);
}
