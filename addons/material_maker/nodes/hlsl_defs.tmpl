#define PI 3.14159265359
#define TAU 2.0*PI
#define mod(x,y) ((x)-(y)*floor((x)/(y)))

// GLSL atan: two arguments (atan2) or one
inline float hlsl_atan(float y, float x) {
    return atan2(y, x);
}
inline float hlsl_atan(float x) {
    return atan(x);
}
inline float2 hlsl_atan(float2 y, float2 x) {
    return atan2(y, x);
}
inline float2 hlsl_atan(float2 x) {
    return atan(x);
}
inline float3 hlsl_atan(float3 y, float3 x) {
    return atan2(y, x);
}
inline float3 hlsl_atan(float3 x) {
    return atan(x);
}
inline float4 hlsl_atan(float4 y, float4 x) {
    return atan2(y, x);
}
inline float4 hlsl_atan(float4 x) {
    return atan(x);
}

inline float4 textureLod(sampler2D tex, float2 uv, float lod) {
    return tex2D(tex, uv);
}

