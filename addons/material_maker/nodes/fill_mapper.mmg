{
	"name": "fill_mapper",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"mode": 1,
		"scale": 0.9,
		"scale_random": 0.2,
		"rotation_random": 0.0,
		"offset_random": 0.0,
		"value_random": 0.0,
		"probability": 1.0
	},
	"shader_model": {
		"code": "vec4 $(name_uv)_map = $(name)_map($uv);",
		"global": "",
		"inputs": [
			{
				"default": "vec4(0.0)",
				"function": true,
				"label": "",
				"longdesc": "The output of a Flood Fill node",
				"name": "in",
				"shortdesc": "Fill",
				"type": "fill"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "The pattern placed in each area (its alpha is its coverage)",
				"name": "pattern",
				"shortdesc": "Pattern",
				"type": "rgba"
			}
		],
		"instance": [
			"vec4 $(name)_map(vec2 uv) {",
			"\tvec4 bb = $in(uv);",
			"\t// Outlines and areas of zero width or height have no pattern",
			"\tif (bb.z <= 0.0 || bb.w <= 0.0) {",
			"\t\treturn vec4(0.0);",
			"\t}",
			"\t// The area's position is wrapped, so areas get the same random values in every",
			"\t// tile, also with fill data that is not wrapped (e.g. the Bricks node's Brick Fill)",
			"\tvec2 seed = vec2($seed)+fract(bb.xy)*vec2(13.1, 7.7)+bb.zw*vec2(3.3, 19.9);",
			"\tif (rand(seed) >= $probability) {",
			"\t\treturn vec4(0.0);",
			"\t}",
			"\t// Position in the area, from 0 to 1 (centered on the larger side in square mode)",
			"\tvec2 size = bb.zw;",
			"\tif ($mode == 1) {",
			"\t\tsize = vec2(max(bb.z, bb.w));",
			"\t}",
			"\t// Position relative to the area's center, in texture space (fract handles areas",
			"\t// that wrap around the texture's edges)",
			"\tvec2 p = fract(uv-bb.xy)-0.5*bb.zw;",
			"\tp -= (vec2(rand(seed+vec2(1.7, 2.3)), rand(seed+vec2(4.1, 0.9)))-vec2(0.5))*2.0*$offset_random*size;",
			"\t// Rotated in texture space, so stretched patterns are not sheared",
			"\tfloat a = radians($rotation_random*(2.0*rand(seed+vec2(6.1, 3.7))-1.0));",
			"\tp = mat2(vec2(cos(a), -sin(a)), vec2(sin(a), cos(a)))*p;",
			"\tvec2 local = p/size;",
			"\tlocal /= max($scale*(1.0-$scale_random*rand(seed+vec2(9.3, 5.5))), 0.000001);",
			"\tif (abs(local.x) > 0.5 || abs(local.y) > 0.5) {",
			"\t\treturn vec4(0.0);",
			"\t}",
			"\tvec4 color = $pattern(local+vec2(0.5));",
			"\tcolor.rgb *= 1.0-$value_random*rand(seed+vec2(2.9, 8.1));",
			"\treturn color;",
			"}"
		],
		"longdesc": "Places an instance of a pattern in each area of a Flood Fill, with random rotation, size, offset and value per area",
		"name": "Flood Fill Mapper",
		"outputs": [
			{
				"rgba": "$(name_uv)_map",
				"longdesc": "The patterns placed in the areas",
				"shortdesc": "Output",
				"type": "rgba"
			},
			{
				"f": "$(name_uv)_map.a",
				"longdesc": "The coverage of the patterns",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"default": 1,
				"label": "Mode",
				"longdesc": "Stretch fits patterns to the bounding box of each area, Square keeps them square",
				"name": "mode",
				"shortdesc": "Mode",
				"type": "enum",
				"values": [
					{
						"name": "Stretch",
						"value": "0"
					},
					{
						"name": "Square",
						"value": "1"
					}
				]
			},
			{
				"control": "None",
				"default": 0.9,
				"label": "Scale",
				"longdesc": "The size of patterns, relative to their area",
				"max": 2.0,
				"min": 0.0,
				"name": "scale",
				"shortdesc": "Scale",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.2,
				"label": "Scale random",
				"longdesc": "The random reduction of the size of each pattern",
				"max": 1.0,
				"min": 0.0,
				"name": "scale_random",
				"shortdesc": "Scale random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Rotation random",
				"longdesc": "The random rotation of each pattern, in degrees",
				"max": 180.0,
				"min": 0.0,
				"name": "rotation_random",
				"shortdesc": "Rotation random",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Offset random",
				"longdesc": "The random offset of each pattern, relative to its area",
				"max": 0.5,
				"min": 0.0,
				"name": "offset_random",
				"shortdesc": "Offset random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Value random",
				"longdesc": "The random darkening of each pattern",
				"max": 1.0,
				"min": 0.0,
				"name": "value_random",
				"shortdesc": "Value random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Probability",
				"longdesc": "The probability that an area has a pattern",
				"max": 1.0,
				"min": 0.0,
				"name": "probability",
				"shortdesc": "Probability",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Flood Fill Mapper"
	}
}