{
	"name": "posterize_dither",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"dither": 1.0,
		"levels": 4.0,
		"pattern": 1,
		"size": 8
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3($uv.x), 1.0)",
				"label": "",
				"longdesc": "The input image",
				"name": "in",
				"shortdesc": "Input",
				"type": "rgba"
			}
		],
		"instance": [
			"// Ordered dithering threshold in (0, 1) for an integer pixel position:",
			"// the Bayer matrix of size 2^rounds, built recursively from the 2x2 one.",
			"float $(name)_bayer(ivec2 p, int rounds) {",
			"\tint b[4] = int[4](0, 2, 3, 1);",
			"\tint v = 0;",
			"\tfor (int i = 0; i < rounds; ++i) {",
			"\t\tv = 4*v+b[(p.x & 1)+2*(p.y & 1)];",
			"\t\tp >>= 1;",
			"\t}",
			"\treturn (float(v)+0.5)/float(1 << (2*rounds));",
			"}",
			"",
			"vec4 $(name)_posterize(vec4 c, vec2 uv) {",
			"\tfloat steps = max(round($levels)-1.0, 1.0);",
			"\tfloat threshold = mix(0.5, $(name)_bayer(ivec2(floor(uv*$size)), $pattern), $dither);",
			"\treturn vec4(clamp(floor(c.rgb*steps+vec3(threshold))/steps, 0.0, 1.0), c.a);",
			"}"
		],
		"longdesc": "Reduces each color channel of its input to a number of evenly spaced levels, with optional ordered (Bayer) dithering between levels. The alpha channel is not modified.",
		"name": "Dithered Posterize",
		"outputs": [
			{
				"longdesc": "The posterized image",
				"rgba": "$(name)_posterize($in($uv), $uv)",
				"shortdesc": "Output",
				"type": "rgba"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 4.0,
				"label": "Levels",
				"longdesc": "The number of levels of each color channel, including black and white",
				"max": 256.0,
				"min": 2.0,
				"name": "levels",
				"shortdesc": "Levels",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Dither",
				"longdesc": "The amount of dithering. At 0, each value is rounded to the nearest level. At 1, the average of the output over a pattern tile matches the input",
				"max": 1.0,
				"min": 0.0,
				"name": "dither",
				"shortdesc": "Dither",
				"step": 0.01,
				"type": "float"
			},
			{
				"default": 1,
				"label": "Pattern",
				"longdesc": "The size of the Bayer matrix used for dithering. Larger matrices produce more intermediate shades",
				"name": "pattern",
				"shortdesc": "Pattern",
				"type": "enum",
				"values": [
					{
						"name": "Bayer 2x2",
						"value": "1"
					},
					{
						"name": "Bayer 4x4",
						"value": "2"
					},
					{
						"name": "Bayer 8x8",
						"value": "3"
					},
					{
						"name": "Bayer 16x16",
						"value": "4"
					}
				]
			},
			{
				"default": 8,
				"first": 4,
				"label": "Size",
				"last": 13,
				"longdesc": "The resolution of the dithering pattern. Use the resolution of the texture to dither each pixel, or a lower one for a coarser pattern. Higher than the resolution of the texture, the pattern aliases",
				"name": "size",
				"shortdesc": "Size",
				"type": "size"
			}
		],
		"shortdesc": "Dithered Posterize"
	},
	"type": "shader"
}
