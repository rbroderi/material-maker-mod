{
	"name": "posterize_dither",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"levels": 4.0,
		"dither": 1.0,
		"size": 8
	},
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3($uv.x), 1.0)",
				"function": true,
				"label": "",
				"longdesc": "The input image",
				"name": "in",
				"shortdesc": "Input",
				"type": "rgba"
			}
		],
		"instance": [
			"// 4x4 Bayer matrix, as thresholds in (0, 1), for an integer pixel position.",
			"// Built from the 2x2 matrix with integer maths: an index computed with the",
			"// float mod() can be out of the matrix when the division is approximate",
			"float $(name)_bayer(ivec2 p) {",
			"\tint b[4] = int[4](0, 2, 3, 1);",
			"\tint v = 0;",
			"\tfor (int i = 0; i < 2; ++i) {",
			"\t\tv = 4*v+b[(p.x & 1)+2*(p.y & 1)];",
			"\t\tp >>= 1;",
			"\t}",
			"\treturn (float(v)+0.5)/16.0;",
			"}",
			"",
			"vec4 $(name)_posterize(vec2 uv) {",
			"\tvec4 c = $in(uv);",
			"\tfloat steps = max(round($levels)-1.0, 1.0);",
			"\tfloat threshold = mix(0.5, $(name)_bayer(ivec2(floor(uv*$size))), $dither);",
			"\treturn vec4(clamp(floor(c.rgb*steps+vec3(threshold))/steps, 0.0, 1.0), c.a);",
			"}"
		],
		"longdesc": "Reduces the number of levels of each channel, with ordered (Bayer) dithering between levels",
		"name": "Dithered Posterize",
		"outputs": [
			{
				"rgba": "$(name)_posterize($uv)",
				"longdesc": "The posterized image",
				"shortdesc": "Output",
				"type": "rgba"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 4.0,
				"label": "Levels",
				"longdesc": "The number of levels of each color channel, including black and white",
				"max": 32.0,
				"min": 2.0,
				"name": "levels",
				"shortdesc": "Levels",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Dither",
				"longdesc": "The amount of dithering. At 0, each value is rounded to the nearest level. At 1, the average of the output over a pattern tile matches the input",
				"max": 1.0,
				"min": 0.0,
				"name": "dither",
				"shortdesc": "Dither",
				"step": 0.01,
				"type": "float"
			},
			{
				"default": 8,
				"first": 4,
				"label": "Size",
				"last": 13,
				"longdesc": "The resolution used for pixel based effects",
				"name": "size",
				"shortdesc": "Size",
				"type": "size"
			}
		],
		"shortdesc": "Dithered Posterize"
	}
}