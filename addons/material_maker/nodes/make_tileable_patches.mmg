{
	"name": "make_tileable_patches",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"cells": 4.0,
		"softness": 0.35,
		"contrast": 1.0
	},
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3(fract(sin(dot(floor($uv*16.0), vec2(12.9898, 78.233)))*43758.5453)), 1.0)",
				"function": true,
				"label": "",
				"longdesc": "The image",
				"name": "in",
				"shortdesc": "Input",
				"type": "rgba"
			}
		],
		"instance": [
			"// Average of the image (uv is unused, node functions need a parameter)",
			"vec4 $(name)_mean(vec2 uv) {",
			"\tvec4 sum = vec4(0.0);",
			"\tfor (int y = 0; y < 4; ++y) {",
			"\t\tfor (int x = 0; x < 4; ++x) {",
			"\t\t\tvec2 sample_uv = (vec2(float(x), float(y))+vec2(0.5))/4.0;",
			"\t\t\tsum += $in(sample_uv);",
			"\t\t}",
			"\t}",
			"\treturn sum/16.0;",
			"}",
			"",
			"vec4 $(name)_patches(vec2 uv) {",
			"\tvec2 cells = vec2(max(floor($cells), 1.0));",
			"\tint n = int(cells.x);",
			"\tvec2 p = uv*cells;",
			"\tvec2 cell = floor(p);",
			"\tfloat inv_2s2 = 0.5/($softness*$softness);",
			"\tvec2 d[9];",
			"\tvec2 sources[9];",
			"\tfloat d2min = 1e9;",
			"\tfor (int i = 0; i < 9; ++i) {",
			"\t\tvec2 c = cell+vec2(float(i%3-1), float(i/3-1));",
			"\t\t// An integer modulo: a float mod() can return cells instead of 0 (seams)",
			"\t\tivec2 wrapped = ((ivec2(c)%n)+ivec2(n))%n;",
			"\t\tvec2 s = vec2(wrapped)+vec2($seed*7.13, $seed*3.37);",
			"\t\tvec2 center = c+vec2(0.5)+0.5*(vec2(rand(s+vec2(0.13, 0.71)), rand(s+vec2(1.97, 2.31)))-vec2(0.5));",
			"\t\t// Each patch shows a random area of the image, away from its edges",
			"\t\tsources[i] = mix(vec2(0.25), vec2(0.75), vec2(rand(s+vec2(3.71, 4.13)), rand(s+vec2(5.31, 6.97))));",
			"\t\td[i] = p-center;",
			"\t\td2min = min(d2min, dot(d[i], d[i]));",
			"\t}",
			"\tvec4 sum = vec4(0.0);",
			"\tfloat weight_sum = 0.0;",
			"\tfloat weight2_sum = 0.0;",
			"\tfor (int i = 0; i < 9; ++i) {",
			"\t\tfloat d2 = dot(d[i], d[i]);",
			"\t\t// Relative to the nearest patch, so weights never all underflow (black",
			"\t\t// pixels at low softness), and faded out before the distance where a",
			"\t\t// patch leaves the 3x3 neighborhood (seams at high softness)",
			"\t\tfloat w = exp(-(d2-d2min)*inv_2s2)*(1.0-smoothstep(1.0, 1.25, sqrt(d2)));",
			"\t\t// Mirrored out of the image instead of clamped (streaks)",
			"\t\tvec2 source_uv = sources[i]+d[i]/cells;",
			"\t\tsource_uv = vec2(1.0)-abs(vec2(1.0)-mod(source_uv, vec2(2.0)));",
			"\t\tsum += w*$in(source_uv);",
			"\t\tweight_sum += w;",
			"\t\tweight2_sum += w*w;",
			"\t}",
			"\tvec4 average = sum/max(weight_sum, 0.000001);",
			"\tvec4 mean = $(name)_mean(uv);",
			"\tvec4 preserving = mean+(sum-weight_sum*mean)/sqrt(max(weight2_sum, 0.000001));",
			"\treturn clamp(mix(average, preserving, $contrast), vec4(0.0), vec4(1.0));",
			"}"
		],
		"longdesc": "Makes an image tileable by recombining random patches of it, blended with soft edges while keeping its contrast (works best on stochastic textures such as gravel, grass or noise)",
		"name": "Patch Tiling",
		"outputs": [
			{
				"rgba": "$(name)_patches($uv)",
				"longdesc": "The tileable image",
				"shortdesc": "Output",
				"type": "rgba"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 4.0,
				"label": "Patches",
				"longdesc": "The number of patches in each direction",
				"max": 16.0,
				"min": 2.0,
				"name": "cells",
				"shortdesc": "Patches",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.35,
				"label": "Softness",
				"longdesc": "The softness of the transitions between patches",
				"max": 1.0,
				"min": 0.05,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Keep contrast",
				"longdesc": "Keeps the contrast of the image where patches are blended (histogram preserving blending), instead of averaging them",
				"max": 1.0,
				"min": 0.0,
				"name": "contrast",
				"shortdesc": "Keep contrast",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Patch Tiling"
	}
}