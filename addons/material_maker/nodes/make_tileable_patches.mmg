						}
					],
					"longdesc": "How much the patches' centers are moved randomly",
					"name": "jitter",
					"shortdesc": "Jitter",
					"type": "linked_control"
				},
				{
					"label": "Rotation",
					"linked_widgets": [
						{
							"node": "patches",
							"widget": "rotation"
						}
					],
					"longdesc": "The random rotation of the patches (1 is any angle); keep it at 0 for directional images",
					"name": "rotation",
					"shortdesc": "Rotation",
					"type": "linked_control"
				},
				{
					"label": "Keep contrast",
					"linked_widgets": [
						{
