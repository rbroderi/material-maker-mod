{
	"name": "fx_map",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"blend": 0,
		"level_opacity": 0.8,
		"levels": 4.0,
		"offset_random": 0.5,
		"pattern_count": 1.0,
		"pattern_mode": 0,
		"probability": 0.8,
		"rotation_random": 180.0,
		"scale": 1.0,
		"scale_random": 0.3,
		"start_level": 0.0,
		"value_random": 0.3
	},
	"seed_int": 0,
	"shader_model": {
		"code": "float $(name_uv)_id;\nvec4 $(name_uv)_fx = $(name)_fx_map($uv, $(name_uv)_id);",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 1 (its alpha is the coverage of instances)",
				"name": "in1",
				"shortdesc": "Pattern 1",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 2 (its alpha is the coverage of instances)",
				"name": "in2",
				"shortdesc": "Pattern 2",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 3 (its alpha is the coverage of instances)",
				"name": "in3",
				"shortdesc": "Pattern 3",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "Pattern 4 (its alpha is the coverage of instances)",
				"name": "in4",
				"shortdesc": "Pattern 4",
				"type": "rgba"
			}
		],
		"instance": [
			"// Recursive quadrant splatting: level L splits the texture in 2^L x 2^L",
			"// cells, with one (optional) instance per cell.",
			"",
			"// PCG4D integer hash (Jarzynski and Olano 2020): 4 random values, exact on",
			"// every GPU, so a seed always gives the same result",
			"uvec4 $(name)_hash(uvec4 v) {",
			"\tv = v*1664525u+1013904223u;",
			"\tv.x += v.y*v.w;",
			"\tv.y += v.z*v.x;",
			"\tv.z += v.x*v.y;",
			"\tv.w += v.y*v.z;",
			"\tv ^= v >> 16u;",
			"\tv.x += v.y*v.w;",
			"\tv.y += v.z*v.x;",
			"\tv.z += v.x*v.y;",
			"\tv.w += v.y*v.z;",
			"\treturn v;",
			"}",
			"",
			"// Random values in [0, 1)",
			"vec4 $(name)_rand(uvec4 h) {",
			"\treturn vec4(h >> 8u)/16777216.0;",
			"}",
			"",
			"vec4 $(name)_pattern(int index, vec2 uv) {",
			"\tif (index == 0) {",
			"\t\treturn $in1(uv);",
			"\t} else if (index == 1) {",
			"\t\treturn $in2(uv);",
			"\t} else if (index == 2) {",
			"\t\treturn $in3(uv);",
			"\t}",
			"\treturn $in4(uv);",
			"}",
			"",
			"vec4 $(name)_fx_map(vec2 uv, out float instance_id) {",
			"\tvec4 result = vec4(0.0);",
			"\tinstance_id = 0.0;",
			"\tint first_level = clamp(int($start_level), 0, 9);",
			"\tint last_level = clamp(int($levels), 1, 10)-1;",
			"\tint pattern_count = clamp(int($pattern_count), 1, 4);",
			"\tfloat scale = clamp($scale, 0.0, 2.0);",
			"\tfloat offset_random = clamp($offset_random, 0.0, 2.0);",
			"\t// Each pixel checks the cells whose instance can reach it: the half size",
			"\t// of the largest instance (its half diagonal when rotated) plus the",
			"\t// largest offset, in cells, so instances are never cut at cell borders",
			"\tfloat extent = (($rotation_random != 0.0) ? 0.70711 : 0.5)*scale+0.5*offset_random;",
			"\tint r = max(int(ceil(extent-0.5)), 0);",
			"\tuint seed_key = floatBitsToUint($seed);",
			"\tfloat level_opacity = 1.0;",
			"\tfloat best_value = 0.0;",
			"\tfor (int level = first_level; level <= last_level; ++level) {",
			"\t\tint n = 1 << level;",
			"\t\tfloat cells = float(n);",
			"\t\tvec2 cell = floor(uv*cells);",
			"\t\tfor (int dy = -r; dy <= r; ++dy) {",
			"\t\t\tfor (int dx = -r; dx <= r; ++dx) {",
			"\t\t\t\tvec2 c = cell+vec2(float(dx), float(dy));",
			"\t\t\t\t// Random values depend on the wrapped cell (n is a power of 2), so the result tiles",
			"\t\t\t\tivec2 wrapped = ivec2(c) & ivec2(n-1);",
			"\t\t\t\tuvec4 h = $(name)_hash(uvec4(uvec2(wrapped), uint(level), seed_key));",
			"\t\t\t\tvec4 r1 = $(name)_rand(h);",
			"\t\t\t\tif (r1.x >= $probability) {",
			"\t\t\t\t\tcontinue;",
			"\t\t\t\t}",
			"\t\t\t\tvec2 p = (c+vec2(0.5)+(r1.yz-vec2(0.5))*offset_random)/cells;",
			"\t\t\t\tfloat s = scale*(1.0-clamp($scale_random, 0.0, 1.0)*r1.w)/cells;",
			"\t\t\t\t// Quick rejection with the circle around the instance",
			"\t\t\t\tif (dot(uv-p, uv-p) > 0.5*s*s) {",
			"\t\t\t\t\tcontinue;",
			"\t\t\t\t}",
			"\t\t\t\tvec4 r2 = $(name)_rand($(name)_hash(h));",
			"\t\t\t\tfloat a = radians($rotation_random*(2.0*r2.x-1.0));",
			"\t\t\t\tvec2 local = mat2(vec2(cos(a), -sin(a)), vec2(sin(a), cos(a)))*(uv-p)/max(s, 0.000001);",
			"\t\t\t\tif (abs(local.x) > 0.5 || abs(local.y) > 0.5) {",
			"\t\t\t\t\tcontinue;",
			"\t\t\t\t}",
			"\t\t\t\tint pattern;",
			"\t\t\t\tif ($pattern_mode == 0) {",
			"\t\t\t\t\tpattern = min(int(r2.y*float(pattern_count)), pattern_count-1);",
			"\t\t\t\t} else {",
			"\t\t\t\t\tpattern = (level-first_level) % pattern_count;",
			"\t\t\t\t}",
			"\t\t\t\tvec4 color = $(name)_pattern(pattern, local+vec2(0.5));",
			"\t\t\t\tcolor.rgb *= 1.0-$value_random*r2.z;",
			"\t\t\t\tfloat opacity = clamp(color.a*level_opacity, 0.0, 1.0);",
			"\t\t\t\tif (opacity <= 0.0) {",
			"\t\t\t\t\tcontinue;",
			"\t\t\t\t}",
			"\t\t\t\tif ($blend == 0) {",
			"\t\t\t\t\t// Alpha over: finer levels are drawn over coarser ones",
			"\t\t\t\t\tresult = vec4(mix(result.rgb, color.rgb, opacity), opacity+result.a*(1.0-opacity));",
			"\t\t\t\t} else if ($blend == 1) {",
			"\t\t\t\t\tresult = vec4(result.rgb+color.rgb*opacity, max(result.a, opacity));",
			"\t\t\t\t} else {",
			"\t\t\t\t\tresult = max(result, vec4(color.rgb*opacity, opacity));",
			"\t\t\t\t}",
			"\t\t\t\t// The ID is the topmost instance with Alpha over, and the",
			"\t\t\t\t// instance with the highest value with Add and Max",
			"\t\t\t\tfloat value = max(max(color.r, color.g), color.b)*opacity;",
			"\t\t\t\tif ($blend == 0 || value > best_value) {",
			"\t\t\t\t\tbest_value = value;",
			"\t\t\t\t\tinstance_id = r2.w;",
			"\t\t\t\t}",
			"\t\t\t}",
			"\t\t}",
			"\t\tlevel_opacity *= clamp($level_opacity, 0.0, 1.0);",
			"\t}",
			"\treturn result;",
			"}"
		],
		"longdesc": "Recursively splats patterns in quadrants: each level splits the texture in 4 times more cells, with one random instance of a pattern per cell, like Substance Designer's FX-Map with Quadrant nodes",
		"name": "FX-Map",
		"outputs": [
			{
				"longdesc": "The splatted patterns, drawn over black (the alpha channel is their coverage)",
				"rgba": "$(name_uv)_fx",
				"shortdesc": "Output",
				"type": "rgba"
			},
			{
				"f": "$(name_uv)_id",
				"longdesc": "A random value for the instance shown on each pixel (the topmost one with Alpha over, the brightest one with Add and Max)",
				"shortdesc": "Instance ID",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 4.0,
				"label": "Levels",
				"longdesc": "The number of quadrant levels (level n has 2^n x 2^n cells)",
				"max": 10.0,
				"min": 1.0,
				"name": "levels",
				"shortdesc": "Levels",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Start level",
				"longdesc": "The first level that has instances",
				"max": 9.0,
				"min": 0.0,
				"name": "start_level",
				"shortdesc": "Start level",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.8,
				"label": "Level opacity",
				"longdesc": "Multiplies the opacity of each level relative to the previous one",
				"max": 1.0,
				"min": 0.0,
				"name": "level_opacity",
				"shortdesc": "Level opacity",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Scale",
				"longdesc": "The size of instances, relative to their cell",
				"max": 2.0,
				"min": 0.0,
				"name": "scale",
				"shortdesc": "Scale",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.3,
				"label": "Scale random",
				"longdesc": "The random reduction of the size of each instance",
				"max": 1.0,
				"min": 0.0,
				"name": "scale_random",
				"shortdesc": "Scale random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Offset random",
				"longdesc": "The random offset of each instance, relative to its cell",
				"max": 2.0,
				"min": 0.0,
				"name": "offset_random",
				"shortdesc": "Offset random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 180.0,
				"label": "Rotation random",
				"longdesc": "The random rotation of each instance, in degrees",
				"max": 180.0,
				"min": 0.0,
				"name": "rotation_random",
				"shortdesc": "Rotation random",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.8,
				"label": "Probability",
				"longdesc": "The probability that a cell has an instance",
				"max": 1.0,
				"min": 0.0,
				"name": "probability",
				"shortdesc": "Probability",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.3,
				"label": "Value random",
				"longdesc": "The random darkening of each instance",
				"max": 1.0,
				"min": 0.0,
				"name": "value_random",
				"shortdesc": "Value random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Patterns",
				"longdesc": "The number of pattern inputs that are used",
				"max": 4.0,
				"min": 1.0,
				"name": "pattern_count",
				"shortdesc": "Patterns",
				"step": 1.0,
				"type": "float"
			},
			{
				"default": 0,
				"label": "Pattern choice",
				"longdesc": "How the pattern of each instance is chosen",
				"name": "pattern_mode",
				"shortdesc": "Pattern choice",
				"type": "enum",
				"values": [
					{
						"name": "Random",
						"value": "0"
					},
					{
						"name": "By level",
						"value": "1"
					}
				]
			},
			{
				"default": 0,
				"label": "Blend",
				"longdesc": "How instances are combined",
				"name": "blend",
				"shortdesc": "Blend",
				"type": "enum",
				"values": [
					{
						"name": "Alpha over",
						"value": "0"
					},
					{
						"name": "Add",
						"value": "1"
					},
					{
						"name": "Max",
						"value": "2"
					}
				]
			}
		],
		"shortdesc": "FX-Map"
	},
	"type": "shader"
}