{
	"name": "clone_patch",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"radius": 0.1,
		"rotation": 0.0,
		"softness": 0.5,
		"source_x": -0.25,
		"source_y": 0.0,
		"target_x": 0.25,
		"target_y": 0.0
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3(0.5+0.4*sin(31.4159*$uv.x)*sin(18.8496*$uv.y)), 1.0)",
				"function": true,
				"label": "",
				"longdesc": "The image",
				"name": "in",
				"shortdesc": "Input",
				"type": "rgba"
			}
		],
		"instance": [
			"// The offset from the target's center, wrapped so the patch can cross the edges",
			"vec2 $(name)_offset(vec2 uv) {",
			"\tvec2 d = uv-vec2($target_x+0.5, $target_y+0.5);",
			"\treturn d-floor(d+vec2(0.5));",
			"}",
			"",
			"float $(name)_mask(vec2 uv) {",
			"\tfloat r = max($radius, 0.0);",
			"\treturn 1.0-smoothstep(r*(1.0-$softness), r+0.00001, length($(name)_offset(uv)));",
			"}",
			"",
			"vec4 $(name)_clone(vec2 uv) {",
			"\tfloat a = radians($rotation);",
			"\tvec2 d = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a)))*$(name)_offset(uv);",
			"\tvec2 source = fract(vec2($source_x+0.5, $source_y+0.5)+d);",
			"\treturn mix($in(uv), $in(source), $(name)_mask(uv));",
			"}"
		],
		"longdesc": "Copies a circular patch of an image over another area, with soft edges (to remove blemishes from photos)",
		"name": "Clone Patch",
		"outputs": [
			{
				"longdesc": "The image with the cloned patch",
				"rgba": "$(name)_clone($uv)",
				"shortdesc": "Output",
				"type": "rgba"
			},
			{
				"f": "$(name)_mask($uv)",
				"longdesc": "The mask of the patch (1 where the image is replaced)",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "P1.x",
				"default": -0.25,
				"label": "Source X",
				"longdesc": "The center of the copied patch",
				"max": 0.5,
				"min": -0.5,
				"name": "source_x",
				"shortdesc": "Source X",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "P1.y",
				"default": 0.0,
				"label": "Source Y",
				"longdesc": "The center of the copied patch",
				"max": 0.5,
				"min": -0.5,
				"name": "source_y",
				"shortdesc": "Source Y",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "P2.x",
				"default": 0.25,
				"label": "Target X",
				"longdesc": "The center of the area that is replaced",
				"max": 0.5,
				"min": -0.5,
				"name": "target_x",
				"shortdesc": "Target X",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "P2.y",
				"default": 0.0,
				"label": "Target Y",
				"longdesc": "The center of the area that is replaced",
				"max": 0.5,
				"min": -0.5,
				"name": "target_y",
				"shortdesc": "Target Y",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "Radius2.r",
				"default": 0.1,
				"label": "Radius",
				"longdesc": "The radius of the patch",
				"max": 0.5,
				"min": 0.0,
				"name": "radius",
				"shortdesc": "Radius",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Softness",
				"longdesc": "The softness of the patch's edge, relative to its radius",
				"max": 1.0,
				"min": 0.0,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Rotation",
				"longdesc": "The rotation of the copied patch, in degrees",
				"max": 180.0,
				"min": -180.0,
				"name": "rotation",
				"shortdesc": "Rotation",
				"step": 0.1,
				"type": "float"
			}
		],
		"shortdesc": "Clone Patch"
	},
	"type": "shader"
}