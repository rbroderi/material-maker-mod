{
	"name": "histogram_scan",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"position": 0.5,
		"contrast": 0.0
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": "",
		"instance": "",
		"inputs": [
			{
				"default": "0.0",
				"label": "",
				"longdesc": "The input image",
				"name": "in",
				"shortdesc": "Input",
				"type": "f"
			}
		],
		"longdesc": "Selects a range of the input values with a position and increases its contrast. At position 0.5 and contrast 0 the input is unchanged, contrast 1 is a threshold.",
		"name": "Histogram Scan",
		"outputs": [
			{
				"f": "clamp(($in($uv)-(1.0-$position))/max(1.0-$contrast, 0.0001)+0.5, 0.0, 1.0)",
				"longdesc": "The output image",
				"shortdesc": "Output",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.5,
				"label": "Position",
				"longdesc": "The value that is mapped to mid-gray (1 maps dark values to gray, 0 maps light values to gray)",
				"max": 1,
				"min": 0,
				"name": "position",
				"shortdesc": "Position",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Contrast",
				"longdesc": "The contrast increase (1 is a threshold)",
				"max": 1,
				"min": 0,
				"name": "contrast",
				"shortdesc": "Contrast",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Histogram scan"
	},
	"type": "shader"
}