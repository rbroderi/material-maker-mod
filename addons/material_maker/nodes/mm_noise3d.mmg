{
	"name": "mm_noise3d",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": [
			"uint mm_n3_lowbias32(uint x) {",
			"	x ^= x >> 16u;",
			"	x *= 0x7FEB352Du;",
			"	x ^= x >> 15u;",
			"	x *= 0x846CA68Bu;",
			"	x ^= x >> 16u;",
			"	return x;",
			"}",
			"uint mm_n3_salt(uint seed, uint n) {",
			"	return mm_n3_lowbias32(mm_n3_lowbias32(seed)+n*0x9E3779B9u);",
			"}",
			"uint mm_n3_hash_u(int x, int y, int z, uint s) {",
			"	uint h = uint(x)*374761393u + uint(y)*668265263u + uint(z)*2147483629u + mm_n3_lowbias32(s);",
			"	return mm_n3_lowbias32(h);",
			"}",
			"float mm_n3_hash(int x, int y, int z, uint s) {",
			"	return float(mm_n3_hash_u(x, y, z, s) >> 8u)*(1.0/16777216.0);",
			"}",
			"uint mm_n3_seed(float s) {",
			"\tfloat r = floor(s);",
			"\tif (s-r >= 0.5) {",
			"\t\tr += 1.0;",
			"\t}",
			"\treturn uint(int(r));",
			"}",
			"int mm_n3_wrap(int i, int period) {",
			"\tif (period <= 0) {",
			"\t\treturn i;",
			"\t}",
			"\tint r = i-(i/period)*period;",
			"\tif (r < 0) {",
			"\t\tr += period;",
			"\t}",
			"\treturn r;",
			"}",
			"float mm_n3_value_p(vec3 p, uint s, int period) {",
			"\tvec3 c = floor(p);",
			"\tvec3 f = p-c;",
			"\tf = f*f*(3.0-2.0*f);",
			"\tint x0 = int(c.x);",
			"\tint y0 = int(c.y);",
			"\tint z0 = int(c.z);",
			"\tint x1 = mm_n3_wrap(x0+1, period);",
			"\tint y1 = mm_n3_wrap(y0+1, period);",
			"\tint z1 = mm_n3_wrap(z0+1, period);",
			"\tx0 = mm_n3_wrap(x0, period);",
			"\ty0 = mm_n3_wrap(y0, period);",
			"\tz0 = mm_n3_wrap(z0, period);",
			"\tfloat a = mix(mm_n3_hash(x0, y0, z0, s), mm_n3_hash(x1, y0, z0, s), f.x);",
			"\tfloat b = mix(mm_n3_hash(x0, y1, z0, s), mm_n3_hash(x1, y1, z0, s), f.x);",
			"\tfloat c0 = mix(a, b, f.y);",
			"\ta = mix(mm_n3_hash(x0, y0, z1, s), mm_n3_hash(x1, y0, z1, s), f.x);",
			"\tb = mix(mm_n3_hash(x0, y1, z1, s), mm_n3_hash(x1, y1, z1, s), f.x);",
			"\tfloat c1 = mix(a, b, f.y);",
			"\treturn mix(c0, c1, f.z);",
			"}",
			"float mm_n3_value(vec3 p, uint s) {",
			"\treturn mm_n3_value_p(p, s, 0);",
			"}",
			"vec3 mm_n3_vnoise(vec3 p, uint s) {",
			"\treturn vec3(mm_n3_value(p, s), mm_n3_value(p, mm_n3_salt(s, 1u)), mm_n3_value(p, mm_n3_salt(s, 2u)));",
			"}",
			"vec3 mm_n3_grad(int x, int y, int z, uint s) {",
			"\tuint i = (mm_n3_hash_u(x, y, z, s) >> 8u) % 12u;",
			"\tfloat a = ((i & 1u) != 0u) ? -0.70710678 : 0.70710678;",
			"\tfloat b = ((i & 2u) != 0u) ? -0.70710678 : 0.70710678;",
			"\tif (i < 4u) {",
			"\t\treturn vec3(a, b, 0.0);",
			"\t} else if (i < 8u) {",
			"\t\treturn vec3(a, 0.0, b);",
			"\t}",
			"\treturn vec3(0.0, a, b);",
			"}",
			"float mm_n3_perlin_p(vec3 p, uint s, int period) {",
			"\tvec3 c = floor(p);",
			"\tvec3 f = p-c;",
			"\tvec3 w = f*f*f*(f*(f*6.0-15.0)+10.0);",
			"\tint x0 = int(c.x);",
			"\tint y0 = int(c.y);",
			"\tint z0 = int(c.z);",
			"\tint x1 = mm_n3_wrap(x0+1, period);",
			"\tint y1 = mm_n3_wrap(y0+1, period);",
			"\tint z1 = mm_n3_wrap(z0+1, period);",
			"\tx0 = mm_n3_wrap(x0, period);",
			"\ty0 = mm_n3_wrap(y0, period);",
			"\tz0 = mm_n3_wrap(z0, period);",
			"\tfloat a = mix(dot(mm_n3_grad(x0, y0, z0, s), f), dot(mm_n3_grad(x1, y0, z0, s), f-vec3(1.0, 0.0, 0.0)), w.x);",
			"\tfloat b = mix(dot(mm_n3_grad(x0, y1, z0, s), f-vec3(0.0, 1.0, 0.0)), dot(mm_n3_grad(x1, y1, z0, s), f-vec3(1.0, 1.0, 0.0)), w.x);",
			"\tfloat c0 = mix(a, b, w.y);",
			"\ta = mix(dot(mm_n3_grad(x0, y0, z1, s), f-vec3(0.0, 0.0, 1.0)), dot(mm_n3_grad(x1, y0, z1, s), f-vec3(1.0, 0.0, 1.0)), w.x);",
			"\tb = mix(dot(mm_n3_grad(x0, y1, z1, s), f-vec3(0.0, 1.0, 1.0)), dot(mm_n3_grad(x1, y1, z1, s), f-vec3(1.0, 1.0, 1.0)), w.x);",
			"\tfloat c1 = mix(a, b, w.y);",
			"\treturn clamp(mix(c0, c1, w.z)*1.1547005, -1.0, 1.0);",
			"}",
			"float mm_n3_perlin(vec3 p, uint s) {",
			"\treturn mm_n3_perlin_p(p, s, 0);",
			"}",
			"float mm_n3_basis(vec3 p, uint s, int period, int basis) {",
			"\tif (basis == 1) {",
			"\t\treturn 0.5+0.5*mm_n3_perlin_p(p, s, period);",
			"\t}",
			"\treturn mm_n3_value_p(p, s, period);",
			"}",
			"float mm_n3_fbm_ex(vec3 p, uint s, int octaves, float gain, float lacunarity, int period, int basis) {",
			"\tfloat total = 0.0;",
			"\tfloat amp = 1.0;",
			"\tfloat norm = 0.0;",
			"\tfloat f = 1.0;",
			"\tfloat lac = lacunarity;",
			"\tint per = period;",
			"\tif (period > 0) {",
			"\t\tlac = max(floor(lacunarity+0.5), 1.0);",
			"\t}",
			"\tint ilac = int(lac);",
			"\tfor (int o = 0; o < 8; o++) {",
			"\t\tif (o >= octaves) {",
			"\t\t\tbreak;",
			"\t\t}",
			"\t\ttotal += mm_n3_basis(p*f, mm_n3_salt(s, 0x40000000u+uint(o)), per, basis)*amp;",
			"\t\tnorm += amp;",
			"\t\tamp *= gain;",
			"\t\tf *= lac;",
			"\t\tif (period > 0) {",
			"\t\t\tper *= ilac;",
			"\t\t}",
			"\t}",
			"\treturn total/norm;",
			"}",
			"float mm_n3_fbm(vec3 p, uint s, int octaves, float gain, float lacunarity) {",
			"\treturn mm_n3_fbm_ex(p, s, octaves, gain, lacunarity, 0, 0);",
			"}",
			"vec3 mm_n3_vnoise_fbm(vec3 p, uint s, int octaves, float gain) {",
			"\tvec3 total = vec3(0.0);",
			"\tfloat amp = 1.0;",
			"\tfloat norm = 0.0;",
			"\tfloat f = 1.0;",
			"\tfor (int o = 0; o < 8; o++) {",
			"\t\tif (o >= octaves) {",
			"\t\t\tbreak;",
			"\t\t}",
			"\t\ttotal += mm_n3_vnoise(p*f, mm_n3_salt(s, 0x40000000u+uint(o)))*amp;",
			"\t\tnorm += amp;",
			"\t\tamp *= gain;",
			"\t\tf *= 2.03;",
			"\t}",
			"\treturn total/norm;",
			"}",
			"vec3 mm_n3_voronoi_search(vec3 p, uint s, float jitter, int period, int mode) {",
			"\tvec3 c = floor(p);",
			"\tint cx0 = int(c.x);",
			"\tint cy0 = int(c.y);",
			"\tint cz0 = int(c.z);",
			"\tfloat d1 = 1.0e9;",
			"\tfloat d2 = 1.0e9;",
			"\tvec3 best = vec3(0.0);",
			"\tfor (int k = 0; k < 27; k++) {",
			"\t\tif (k >= 27) {",
			"\t\t\tbreak;",
			"\t\t}",
			"\t\tint cx = cx0+(k-3*(k/3))-1;",
			"\t\tint cy = cy0+(k/3-3*(k/9))-1;",
			"\t\tint cz = cz0+k/9-1;",
			"\t\tint wx = mm_n3_wrap(cx, period);",
			"\t\tint wy = mm_n3_wrap(cy, period);",
			"\t\tint wz = mm_n3_wrap(cz, period);",
			"\t\tvec3 h = vec3(mm_n3_hash(wx, wy, wz, s), mm_n3_hash(wx, wy, wz, mm_n3_salt(s, 1u)), mm_n3_hash(wx, wy, wz, mm_n3_salt(s, 2u)));",
			"\t\tvec3 fp = vec3(float(cx), float(cy), float(cz))+0.5+jitter*(h-0.5);",
			"\t\tfloat d = length(fp-p);",
			"\t\tif (d < d1) {",
			"\t\t\td2 = d1;",
			"\t\t\td1 = d;",
			"\t\t\tbest = vec3(float(wx), float(wy), float(wz));",
			"\t\t} else if (d < d2) {",
			"\t\t\td2 = d;",
			"\t\t}",
			"\t}",
			"\tif (mode == 0) {",
			"\t\treturn vec3(d1, d2, 0.0);",
			"\t}",
			"\treturn best;",
			"}",
			"float mm_n3_voronoi(vec3 p, uint s, float jitter) {",
			"\treturn mm_n3_voronoi_search(p, s, jitter, 0, 0).x;",
			"}",
			"float mm_n3_cell_random(vec3 cell, uint s) {",
			"\treturn mm_n3_hash(int(cell.x), int(cell.y), int(cell.z), mm_n3_salt(s, 6u));",
			"}",
			"vec3 mm_n3_cell_color(vec3 cell, uint s) {",
			"\tint x = int(cell.x);",
			"\tint y = int(cell.y);",
			"\tint z = int(cell.z);",
			"\treturn vec3(mm_n3_hash(x, y, z, mm_n3_salt(s, 3u)), mm_n3_hash(x, y, z, mm_n3_salt(s, 4u)), mm_n3_hash(x, y, z, mm_n3_salt(s, 5u)));",
			"}"
		],
		"inputs": [],
		"longdesc": "Shared integer hash noise functions of the 3D noise nodes (not in the library)",
		"name": "Noise 3D functions",
		"outputs": [
			{
				"longdesc": "Unused",
				"shortdesc": "Output",
				"tex3d_gs": "0.0",
				"type": "tex3d_gs"
			}
		],
		"parameters": [],
		"shortdesc": "Noise 3D functions"
	},
	"type": "shader"
}