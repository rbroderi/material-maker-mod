{
	"generic_size": 1,
	"name": "tex3d_domain_warp",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"amount": 0.1,
		"gain": 0.5,
		"octaves": 2,
		"offset_x": 0,
		"offset_y": 0,
		"offset_z": 0,
		"scale_x": 4,
		"scale_y": 4,
		"scale_z": 4,
		"seed_offset": 0
	},
	"seed_int": 0,
	"shader_model": {
		"code": [
			"uint $(name_uv)_s = mm_n3_seed($seed_in($uv)+$seed_offset);",
			"vec3 $(name_uv)_p = $uv.xyz*vec3($scale_x, $scale_y, $scale_z)+vec3($offset_x, $offset_y, $offset_z);"
		],
		"global": "",
		"includes": [
			"mm_noise3d"
		],
		"inputs": [
			{
				"default": "vec3(sin($uv.xyz*20.0)*0.5+0.5)",
				"label": "",
				"longdesc": "The input 3D texture to be warped",
				"name": "in#",
				"shortdesc": "Input#",
				"type": "tex3d"
			},
			{
				"default": "0.0",
				"label": "Seed",
				"longdesc": "The integer seed of the noise (0 to 16777215). The seed offset parameter is added to it",
				"name": "seed_in",
				"shortdesc": "Seed",
				"type": "tex3d_gs"
			}
		],
		"longdesc": "Displaces the position at which its input is evaluated with seeded 3D noise, in metres",
		"name": "Domain warp 3D",
		"outputs": [
			{
				"longdesc": "The warped 3D texture",
				"shortdesc": "Output#",
				"tex3d": "$in#(vec4($uv.xyz+$amount*(2.0*mm_n3_vnoise_fbm($(name_uv)_p, $(name_uv)_s, int($octaves), $gain)-1.0), $uv.w))",
				"type": "tex3d"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 8,
				"label": "",
				"longdesc": "Number of noise features per metre along the X axis",
				"max": 1000,
				"min": 0.001,
				"name": "scale_x",
				"shortdesc": "Scale X",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8,
				"label": "",
				"longdesc": "Number of noise features per metre along the Y axis",
				"max": 1000,
				"min": 0.001,
				"name": "scale_y",
				"shortdesc": "Scale Y",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8,
				"label": "",
				"longdesc": "Number of noise features per metre along the Z axis",
				"max": 1000,
				"min": 0.001,
				"name": "scale_z",
				"shortdesc": "Scale Z",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0,
				"label": "",
				"longdesc": "Shift of the noise lattice along X, in lattice cells",
				"max": 1000,
				"min": -1000,
				"name": "offset_x",
				"shortdesc": "Offset X",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0,
				"label": "",
				"longdesc": "Shift of the noise lattice along Y, in lattice cells",
				"max": 1000,
				"min": -1000,
				"name": "offset_y",
				"shortdesc": "Offset Y",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0,
				"label": "",
				"longdesc": "Shift of the noise lattice along Z, in lattice cells",
				"max": 1000,
				"min": -1000,
				"name": "offset_z",
				"shortdesc": "Offset Z",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0,
				"label": "",
				"longdesc": "Added to the seed input to get the integer seed of the noise",
				"max": 1000,
				"min": 0,
				"name": "seed_offset",
				"shortdesc": "Seed offset",
				"step": 1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.1,
				"label": "",
				"longdesc": "The maximum displacement in metres",
				"max": 10,
				"min": 0,
				"name": "amount",
				"shortdesc": "Amount",
				"step": 0.001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 2,
				"label": "",
				"longdesc": "The number of noise layers of the displacement",
				"max": 8,
				"min": 1,
				"name": "octaves",
				"shortdesc": "Octaves",
				"step": 1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "",
				"longdesc": "The amplitude factor between two octaves",
				"max": 1,
				"min": 0,
				"name": "gain",
				"shortdesc": "Gain",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Domain warp 3D"
	},
	"type": "shader"
}