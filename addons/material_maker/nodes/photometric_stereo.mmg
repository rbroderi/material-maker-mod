{
	"name": "photometric_stereo",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"elevation": 45.0,
		"strength": 1.0,
		"srgb": true
	},
	"shader_model": {
		"code": "vec4 $(name_uv)_ps = $(name)_solve($uv);",
		"global": "",
		"inputs": [
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the right",
				"name": "east",
				"shortdesc": "East",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the top",
				"name": "north",
				"shortdesc": "North",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the left",
				"name": "west",
				"shortdesc": "West",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the bottom",
				"name": "south",
				"shortdesc": "South",
				"type": "f"
			}
		],
		"instance": [
			"// Lambertian photometric stereo with 4 lights at the same elevation, from",
			"// the right, top, left and bottom of the image. The least squares solution",
			"// for g = albedo*normal (x right, y down, z towards the camera) is:",
			"float $(name)_to_linear(float c) {",
			"\tc = max(c, 0.0);",
			"\treturn $srgb ? (c <= 0.04045 ? c/12.92 : pow((c+0.055)/1.055, 2.4)) : c;",
			"}",
			"",
			"float $(name)_from_linear(float c) {",
			"\tc = max(c, 0.0);",
			"\treturn $srgb ? (c <= 0.0031308 ? 12.92*c : 1.055*pow(c, 1.0/2.4)-0.055) : c;",
			"}",
			"",
			"vec4 $(name)_solve(vec2 uv) {",
			"\tfloat e = radians(clamp($elevation, 5.0, 85.0));",
			"\tfloat i_east = $(name)_to_linear($east(uv));",
			"\tfloat i_north = $(name)_to_linear($north(uv));",
			"\tfloat i_west = $(name)_to_linear($west(uv));",
			"\tfloat i_south = $(name)_to_linear($south(uv));",
			"\tvec3 g = vec3((i_east-i_west)/(2.0*cos(e)), (i_south-i_north)/(2.0*cos(e)), (i_east+i_north+i_west+i_south)/(4.0*sin(e)));",
			"\tfloat albedo = length(g);",
			"\tvec3 n = albedo > 0.00001 ? g/albedo : vec3(0.0, 0.0, 1.0);",
			"\t// Normals that point into the surface (noise, shadows) are moved onto it",
			"\tn.z = max(n.z, 0.001);",
			"\tn.xy *= $strength;",
			"\tn = normalize(n);",
			"\treturn vec4(n, albedo);",
			"}"
		],
		"longdesc": "Reconstructs a normal map and an albedo map from 4 photos of a surface lit from the right, top, left and bottom, with lights at the same elevation (photometric stereo)",
		"name": "Photometric Stereo",
		"outputs": [
			{
				"longdesc": "The normal map",
				"rgb": "vec3(0.5)+0.5*vec3(-$(name_uv)_ps.x, -$(name_uv)_ps.y, -$(name_uv)_ps.z)",
				"shortdesc": "Normal",
				"type": "rgb"
			},
			{
				"f": "$(name)_from_linear($(name_uv)_ps.w)",
				"longdesc": "The albedo (diffuse reflectance)",
				"shortdesc": "Albedo",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 45.0,
				"label": "Elevation",
				"longdesc": "The elevation of the lights, in degrees above the surface",
				"max": 85.0,
				"min": 5.0,
				"name": "elevation",
				"shortdesc": "Elevation",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Strength",
				"longdesc": "Multiplies the slopes of the normal map",
				"max": 4.0,
				"min": 0.0,
				"name": "strength",
				"shortdesc": "Strength",
				"step": 0.01,
				"type": "float"
			},
			{
				"default": true,
				"label": "sRGB photos",
				"longdesc": "Set it for photos in sRGB (most photos and image files): they are linearized first, as Lambert's law needs linear values, and the albedo is converted back to sRGB",
				"name": "srgb",
				"shortdesc": "sRGB photos",
				"type": "boolean"
			}
		],
		"shortdesc": "Photometric Stereo"
	}
}