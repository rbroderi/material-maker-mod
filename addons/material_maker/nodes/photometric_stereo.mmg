{
	"name": "photometric_stereo",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"elevation": 45.0,
		"strength": 1.0
	},
	"shader_model": {
		"code": "vec4 $(name_uv)_ps = $(name)_solve($uv);",
		"global": "",
		"inputs": [
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the right",
				"name": "east",
				"shortdesc": "East",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the top",
				"name": "north",
				"shortdesc": "North",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the left",
				"name": "west",
				"shortdesc": "West",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A photo of the surface lit from the bottom",
				"name": "south",
				"shortdesc": "South",
				"type": "f"
			}
		],
		"instance": [
			"// Lambertian photometric stereo with 4 lights at the same elevation, from",
			"// the right, top, left and bottom of the image. The least squares solution",
			"// for g = albedo*normal (x right, y down, z towards the camera) is:",
			"vec4 $(name)_solve(vec2 uv) {",
			"\tfloat e = radians(clamp($elevation, 5.0, 85.0));",
			"\tfloat i_east = $east(uv);",
			"\tfloat i_north = $north(uv);",
			"\tfloat i_west = $west(uv);",
			"\tfloat i_south = $south(uv);",
			"\tvec3 g = vec3((i_east-i_west)/(2.0*cos(e)), (i_south-i_north)/(2.0*cos(e)), (i_east+i_north+i_west+i_south)/(4.0*sin(e)));",
			"\tfloat albedo = length(g);",
			"\tvec3 n = albedo > 0.00001 ? g/albedo : vec3(0.0, 0.0, 1.0);",
			"\tn.xy *= $strength;",
			"\tn = normalize(n);",
			"\treturn vec4(n, albedo);",
			"}"
		],
		"longdesc": "Reconstructs a normal map and an albedo map from 4 photos of a surface lit from the right, top, left and bottom, with lights at the same elevation (photometric stereo)",
		"name": "Photometric Stereo",
		"outputs": [
			{
				"longdesc": "The normal map",
				"rgb": "vec3(0.5)+0.5*vec3(-$(name_uv)_ps.x, -$(name_uv)_ps.y, -$(name_uv)_ps.z)",
				"shortdesc": "Normal",
				"type": "rgb"
			},
			{
				"f": "$(name_uv)_ps.w",
				"longdesc": "The albedo (diffuse reflectance)",
				"shortdesc": "Albedo",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 45.0,
				"label": "Elevation",
				"longdesc": "The elevation of the lights, in degrees above the surface",
				"max": 85.0,
				"min": 5.0,
				"name": "elevation",
				"shortdesc": "Elevation",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Strength",
				"longdesc": "Multiplies the slopes of the normal map",
				"max": 4.0,
				"min": 0.0,
				"name": "strength",
				"shortdesc": "Strength",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Photometric Stereo"
	}
}