{
	"name": "weathering_dirt",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"amount": 0.5,
		"softness": 0.1,
		"curvature_weight": 0.5,
		"noise_scale": 8.0,
		"noise_amount": 0.5
	},
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "1.0",
				"function": true,
				"label": "",
				"longdesc": "An ambient occlusion map (dark in cavities)",
				"name": "ao",
				"shortdesc": "Ambient occlusion",
				"type": "f"
			},
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A curvature map (0.5 is flat, brighter is convex), e.g. from the Curvature or Mesh Map nodes",
				"name": "curvature",
				"shortdesc": "Curvature",
				"type": "f"
			}
		],
		"instance": [
			"float $(name)_mask(vec2 uv) {",
			"\tfloat noise = mm_weathering_fbm(uv, $noise_scale, 5, $seed)-0.5;",
			"\tfloat cavity = (1.0-$ao(uv))+$curvature_weight*max(0.5-$curvature(uv), 0.0)*2.0;",
			"\treturn smoothstep(1.0-$amount, 1.0-$amount+$softness+0.0001, cavity+noise*$noise_amount);",
			"}"
		],
		"longdesc": "Generates a mask of dirt accumulated in cavities and concave areas, from ambient occlusion and curvature maps, broken up by noise",
		"name": "Dirt",
		"outputs": [
			{
				"f": "$(name)_mask($uv)",
				"longdesc": "The weathering mask (1 where the effect is present)",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.5,
				"label": "Amount",
				"longdesc": "The amount of the effect",
				"max": 1.0,
				"min": 0.0,
				"name": "amount",
				"shortdesc": "Amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.1,
				"label": "Softness",
				"longdesc": "The softness of the mask's edges",
				"max": 1.0,
				"min": 0.0,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Curvature weight",
				"longdesc": "How much concave areas (from the curvature map) get dirt",
				"max": 1.0,
				"min": 0.0,
				"name": "curvature_weight",
				"shortdesc": "Curvature weight",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Noise scale",
				"longdesc": "The scale of the noise that breaks up the mask",
				"max": 64.0,
				"min": 1.0,
				"name": "noise_scale",
				"shortdesc": "Noise scale",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Noise amount",
				"longdesc": "How much the noise breaks up the mask",
				"max": 1.0,
				"min": 0.0,
				"name": "noise_amount",
				"shortdesc": "Noise amount",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Dirt",
		"includes": [
			"weathering_grunge"
		]
	}
}