			"shader_model": {
				"code": [
					"vec3 $(name_uv)_in = $in(fract($uv));",
					"vec3 $(name_uv)_tiled = $(name_uv)_in.xy != vec2(0.0) ? $(name_uv)_in + vec3(floor($uv), 0.0) : $(name_uv)_in;"
				],
				"global": "",
