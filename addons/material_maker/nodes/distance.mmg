		{
			"name": "distance_output",
			"node_position": {
				"x": 290.156524658203,
				"y": -232.873168945312
			},
			"parameters": {
				"distance": 0.0,
				"tiled": true,
				"max_distance": 0.1
			},
			"seed": -16657.0,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "vec3(0.0)",
						"function": true,
						"label": "",
						"name": "in",
						"type": "rgb"
					},
					{
						"default": "0.0",
						"function": true,
						"label": "",
						"name": "mask",
						"type": "f"
					},
					{
						"default": "vec4(1.0)",
						"function": true,
						"label": "",
						"name": "source",
						"type": "rgba"
					}
				],
				"instance": [
					"// Returns the center of the nearest white pixel of the mask (xy) and the distance to it (z)",
					"vec3 $(name)_nearest(vec2 uv, bool tiled) {",
					"\tif (tiled) {",
					"\t\tuv = fract(uv);",
					"\t}",
					"\tvec2 custom_uv = $in(uv).xy;",
					"\tvec2 diff = custom_uv != vec2(0.0) ? custom_uv - uv : vec2(1.0);",
					"\t$distance",
					"\treturn vec3(custom_uv, distance);",
					"}",
					"",
					"float $(name)_falloff(vec2 uv, bool tiled) {",
					"\tvec2 mask_uv = tiled ? fract(uv) : clamp(uv, 0.0, 1.0);",
					"\tif ($mask(mask_uv) >= 0.5) {",
					"\t\treturn 1.0;",
					"\t}",
					"\treturn clamp(1.0-$(name)_nearest(uv, tiled).z/max($max_distance, 0.00001), 0.0, 1.0);",
					"}",
					"",
					"vec4 $(name)_color(vec2 uv, bool tiled) {",
					"\tvec2 mask_uv = tiled ? fract(uv) : clamp(uv, 0.0, 1.0);",
					"\tif ($mask(mask_uv) >= 0.5) {",
					"\t\treturn $source(mask_uv);",
					"\t}",
					"\tvec3 nearest = $(name)_nearest(uv, tiled);",
					"\tif (nearest.z > $max_distance) {",
					"\t\treturn vec4(0.0, 0.0, 0.0, 1.0);",
					"\t}",
					"\treturn $source(tiled ? fract(nearest.xy) : nearest.xy);",
					"}"
				],
				"name": "Distance",
				"outputs": [
					{
						"f": "$(name)_falloff($uv, $tiled)",
						"longdesc": "1 in the white areas of the mask, fading to 0 at the maximum distance",
						"shortdesc": "Distance",
						"type": "f"
					},
					{
						"rgba": "$(name)_color($uv, $tiled)",
						"longdesc": "The colors of the source image, propagated from the white areas of the mask up to the maximum distance",
						"shortdesc": "Color",
						"type": "rgba"
					}
				],
				"parameters": [
					{
						"default": false,
						"label": "Tiled",
						"name": "tiled",
						"type": "boolean"
					},
					{
						"default": 0.0,
						"label": "",
						"name": "distance",
						"type": "enum",
						"values": [
							{
								"name": "Euclidean",
								"value": "float distance = length(diff);"
							},
							{
								"name": "Manhattan",
								"value": "float distance = abs(diff.x) + abs(diff.y);"
							},
							{
								"name": "Chebyshev",
								"value": "float distance = abs(diff.x) > abs(diff.y) ? abs(diff.x) : abs(diff.y);"
							}
						]
					},
					{
						"control": "None",
						"default": 0.1,
						"label": "Max distance",
						"longdesc": "The distance at which the gradient reaches 0 and colors stop propagating",
						"max": 1.0,
						"min": 0.0,
						"name": "max_distance",
						"shortdesc": "Max distance",
						"step": 0.001,
						"type": "float"
					}
				]
			},
			"type": "shader"
		}
