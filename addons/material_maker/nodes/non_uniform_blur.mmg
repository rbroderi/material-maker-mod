		{
			"name": "non_uniform_blur",
			"node_position": {
				"x": -358.725463867188,
				"y": -84.178955078125
			},
			"parameters": {
				"size": 10.0,
				"intensity": 10.0,
				"anisotropy": 0.0,
				"angle": 0.0,
				"samples": 32.0,
				"blades": 0.0,
				"blade_rotation": 0.0
			},
			"seed": -47470.0,
			"seed_locked": true,
			"shader_model": {
				"code": "",
				"global": "",
				"inputs": [
					{
						"default": "vec4(1.0)",
						"function": true,
						"label": "",
						"name": "in",
						"type": "rgba"
					},
					{
						"default": "1.0",
						"function": true,
						"label": "",
						"name": "amount",
						"type": "f"
					}
				],
				"instance": [
					"vec4 $(name)_fct(vec2 uv) {",
					"\tfloat radius = max($intensity*$amount(uv), 0.0)/$size;",
					"\tif (radius <= 0.0) {",
					"\t\treturn $in(uv);",
					"\t}",
					"\tfloat a = $angle*0.01745329251;",
					"\tmat2 rotation = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a)));",
					"\tvec2 axes = radius*vec2(1.0, 1.0-0.99*$anisotropy);",
					"\tfloat count = clamp(floor($samples), 1.0, 256.0);",
					"\tvec4 rv = vec4(0.0);",
					"\t// Vogel disc: samples spread evenly over the disc using the golden angle",
					"\tfor (float i = 0.0; i < 256.0; i += 1.0) {",
					"\t\tif (i >= count) {",
					"\t\t\tbreak;",
					"\t\t}",
					"\t\tfloat t = i*2.39996322973;",
					"\t\tvec2 offset = vec2(cos(t), sin(t))*sqrt((i+0.5)/count);",
					"\t\tif ($blades >= 3.0) {",
					"\t\t\t// Polygonal aperture: the radius in this direction is the polygon's",
					"\t\t\tfloat sector = 6.28318530718/floor($blades);",
					"\t\t\tfloat angle = mod(t-$blade_rotation*0.01745329251, sector)-0.5*sector;",
					"\t\t\toffset *= cos(0.5*sector)/cos(angle);",
					"\t\t}",
					"\t\trv += $in(uv+rotation*(offset*axes));",
					"\t}",
					"\treturn rv/count;",
					"}"
				],
				"name": "Non-Uniform Blur",
				"outputs": [
					{
						"rgba": "$(name)_fct($uv)",
						"type": "rgba"
					}
				],
				"parameters": [
					{
						"default": 10.0,
						"first": 4.0,
						"label": "Size",
						"last": 13.0,
						"name": "size",
						"type": "size"
					},
