{
	"name": "atlas_scatter",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"blend": 0,
		"columns": 2.0,
		"count": 8.0,
		"drop": 0.0,
		"offset_random": 0.6,
		"rotation_random": 180.0,
		"rows": 2.0,
		"scale": 1.0,
		"scale_random": 0.3,
		"value_random": 0.2
	},
	"seed_int": 0,
	"shader_model": {
		"code": "float $(name_uv)_id;\nvec4 $(name_uv)_s = $(name)_scatter($uv, $(name_uv)_id);",
		"global": [
			"// Shared by the atlas nodes (Atlas Scatter, Atlas Island Scatter)",
			"",
			"// Integer hash (PCG3D, Jarzynski and Olano 2020): the same values on every GPU",
			"uvec3 mm_atlas_pcg3d(uvec3 v) {",
			"\tv = v*1664525u+1013904223u;",
			"\tv.x += v.y*v.z;",
			"\tv.y += v.z*v.x;",
			"\tv.z += v.x*v.y;",
			"\tv ^= v >> 16u;",
			"\tv.x += v.y*v.z;",
			"\tv.y += v.z*v.x;",
			"\tv.z += v.x*v.y;",
			"\treturn v;",
			"}",
			"",
			"// Three random values in [0, 1) for a cell of a grid of count x count cells",
			"// (wrapped, so scatters tile), a seed and a salt",
			"vec3 mm_atlas_rand3(vec2 cell, float count, float seed, uint salt) {",
			"\tuvec2 c = uvec2(mod(cell, vec2(count)));",
			"\tuvec3 h = mm_atlas_pcg3d(uvec3(c.x, c.y+(salt << 16u), floatBitsToUint(seed)));",
			"\treturn vec3(h >> 8u)/16777216.0;",
			"}",
			"",
			"// Composites src over dst (straight alpha)",
			"vec4 mm_atlas_over(vec4 dst, vec4 src) {",
			"\tfloat a = src.a+dst.a*(1.0-src.a);",
			"\tif (a <= 0.0) {",
			"\t\treturn vec4(0.0);",
			"\t}",
			"\treturn vec4((src.rgb*src.a+dst.rgb*dst.a*(1.0-src.a))/a, a);",
			"}",
			"",
			"// The number of neighbor cells on each side whose instances can cover a cell,",
			"// for instances of size scale (relative to a cell) that may be rotated, and",
			"// moved by up to offset/2 cells from their cell's center",
			"int mm_atlas_reach(float scale, bool rotated, float offset) {",
			"\tfloat extent = (rotated ? 0.70711 : 0.5)*max(scale, 0.0);",
			"\treturn int(clamp(floor(extent+0.5*clamp(offset, 0.0, 1.0)+0.5), 0.0, 2.0));",
			"}"
		],
		"inputs": [
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length(fract($uv*2.0)-vec2(0.5)), 0.0, 1.0))",
				"function": true,
				"label": "",
				"longdesc": "The atlas: a grid of images, indexed from the top left corner, row by row",
				"name": "atlas",
				"shortdesc": "Atlas",
				"type": "rgba"
			}
		],
		"instance": [
			"vec4 $(name)_scatter(vec2 uv, out float instance) {",
			"\tfloat count = max(floor($count), 1.0);",
			"\tvec2 p = uv*count;",
			"\tvec2 cell = floor(p);",
			"\tint reach = mm_atlas_reach($scale, $rotation_random > 0.0, $offset_random);",
			"\t// Instances covering this point, sorted by their random depth",
			"\tfloat depths[25];",
			"\tvec4 colors[25];",
			"\tfloat ids[25];",
			"\tint n = 0;",
			"\tfor (int dy = -reach; dy <= reach; ++dy) {",
			"\t\tfor (int dx = -reach; dx <= reach; ++dx) {",
			"\t\t\tvec2 c = cell+vec2(float(dx), float(dy));",
			"\t\t\tvec3 r1 = mm_atlas_rand3(c, count, $seed, 1u);",
			"\t\t\tvec3 r2 = mm_atlas_rand3(c, count, $seed, 2u);",
			"\t\t\tvec3 r3 = mm_atlas_rand3(c, count, $seed, 3u);",
			"\t\t\tif (r3.x < $drop) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tfloat s = $scale*(1.0-$scale_random*r1.z);",
			"\t\t\tif (s <= 0.0) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tvec2 center = c+vec2(0.5)+(r1.xy-vec2(0.5))*$offset_random;",
			"\t\t\tfloat a = radians($rotation_random*(2.0*r2.x-1.0));",
			"\t\t\tvec2 local = mat2(vec2(cos(a), sin(a)), vec2(-sin(a), cos(a)))*(p-center)/s+vec2(0.5);",
			"\t\t\tif (any(lessThan(local, vec2(0.0))) || any(greaterThanEqual(local, vec2(1.0)))) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tvec2 grid = max(floor(vec2($columns, $rows)), vec2(1.0));",
			"\t\t\tfloat index = min(floor(r2.y*grid.x*grid.y), grid.x*grid.y-1.0);",
			"\t\t\tfloat row = floor((index+0.5)/grid.x);",
			"\t\t\tvec2 atlas_cell = vec2(index-row*grid.x, row);",
			"\t\t\t// Keeps the aspect ratio of the atlas's cells",
			"\t\t\tfloat aspect = grid.y/grid.x;",
			"\t\t\tvec2 l = local;",
			"\t\t\tif (aspect < 1.0) {",
			"\t\t\t\tl.x = (l.x-0.5)/aspect+0.5;",
			"\t\t\t} else {",
			"\t\t\t\tl.y = (l.y-0.5)*aspect+0.5;",
			"\t\t\t}",
			"\t\t\tif (any(lessThan(l, vec2(0.0))) || any(greaterThanEqual(l, vec2(1.0)))) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tvec4 color = $atlas((atlas_cell+l)/grid);",
			"\t\t\tif (color.a <= 0.0) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tcolor.rgb *= 1.0-$value_random*r2.z;",
			"\t\t\tint i = n;",
			"\t\t\twhile (i > 0 && depths[i-1] > r3.y) {",
			"\t\t\t\tdepths[i] = depths[i-1];",
			"\t\t\t\tcolors[i] = colors[i-1];",
			"\t\t\t\tids[i] = ids[i-1];",
			"\t\t\t\t--i;",
			"\t\t\t}",
			"\t\t\tdepths[i] = r3.y;",
			"\t\t\tcolors[i] = color;",
			"\t\t\tids[i] = r3.z;",
			"\t\t\t++n;",
			"\t\t}",
			"\t}",
			"\tvec4 result = vec4(0.0);",
			"\tinstance = 0.0;",
			"\tfloat best = -1.0;",
			"\tfor (int i = 0; i < n; ++i) {",
			"\t\tif ($blend == 0) {",
			"\t\t\tresult = mm_atlas_over(result, colors[i]);",
			"\t\t\tinstance = ids[i];",
			"\t\t} else {",
			"\t\t\tvec4 premultiplied = vec4(colors[i].rgb*colors[i].a, colors[i].a);",
			"\t\t\tfloat v = dot(premultiplied.rgb, vec3(1.0/3.0));",
			"\t\t\tif (v > best) {",
			"\t\t\t\tbest = v;",
			"\t\t\t\tinstance = ids[i];",
			"\t\t\t}",
			"\t\t\tresult = max(result, premultiplied);",
			"\t\t}",
			"\t}",
			"\treturn result;",
			"}"
		],
		"longdesc": "Scatters random images of an atlas whose images are on a grid, at most one per cell of a grid, with random offset, scale, rotation and value",
		"name": "Atlas Scatter",
		"outputs": [
			{
				"longdesc": "The scattered instances",
				"rgba": "$(name_uv)_s",
				"shortdesc": "Output",
				"type": "rgba"
			},
			{
				"f": "$(name_uv)_s.a",
				"longdesc": "The coverage of the instances (the output's alpha)",
				"shortdesc": "Mask",
				"type": "f"
			},
			{
				"f": "$(name_uv)_id",
				"longdesc": "A random value for each instance (of the one on top), 0 where there is none",
				"shortdesc": "Instance",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 2.0,
				"label": "Columns",
				"longdesc": "The number of columns of the atlas",
				"max": 16.0,
				"min": 1.0,
				"name": "columns",
				"shortdesc": "Columns",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 2.0,
				"label": "Rows",
				"longdesc": "The number of rows of the atlas",
				"max": 16.0,
				"min": 1.0,
				"name": "rows",
				"shortdesc": "Rows",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Count",
				"longdesc": "The number of cells of the grid on each side (at most one instance per cell)",
				"max": 64.0,
				"min": 1.0,
				"name": "count",
				"shortdesc": "Count",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Scale",
				"longdesc": "The size of instances (their longest side), relative to their cell",
				"max": 2.0,
				"min": 0.0,
				"name": "scale",
				"shortdesc": "Scale",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.3,
				"label": "Scale random",
				"longdesc": "The random reduction of the size of each instance",
				"max": 1.0,
				"min": 0.0,
				"name": "scale_random",
				"shortdesc": "Scale random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 180.0,
				"label": "Rotation random",
				"longdesc": "The random rotation of each instance (up to this angle either way, in degrees)",
				"max": 180.0,
				"min": 0.0,
				"name": "rotation_random",
				"shortdesc": "Rotation random",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.6,
				"label": "Offset random",
				"longdesc": "The random offset of each instance from its cell's center, relative to the cell",
				"max": 1.0,
				"min": 0.0,
				"name": "offset_random",
				"shortdesc": "Offset random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.2,
				"label": "Value random",
				"longdesc": "The random darkening of each instance",
				"max": 1.0,
				"min": 0.0,
				"name": "value_random",
				"shortdesc": "Value random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Drop",
				"longdesc": "The proportion of cells left empty",
				"max": 1.0,
				"min": 0.0,
				"name": "drop",
				"shortdesc": "Drop",
				"step": 0.01,
				"type": "float"
			},
			{
				"default": 0,
				"label": "Blend",
				"longdesc": "How overlapping instances are combined:\n- Normal: alpha blending, in a random order\n- Max: the maximum of the instances (premultiplied by their alpha), for height maps",
				"name": "blend",
				"shortdesc": "Blend",
				"type": "enum",
				"values": [
					{
						"name": "Normal",
						"value": "0"
					},
					{
						"name": "Max",
						"value": "1"
					}
				]
			}
		],
		"shortdesc": "Atlas Scatter"
	},
	"type": "shader"
}