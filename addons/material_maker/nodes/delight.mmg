					"name": "radius",
					"shortdesc": "Radius",
					"type": "linked_control"
				},
				{
					"label": "Tileable",
					"linked_widgets": [
						{
							"node": "blur_x",
							"widget": "tileable"
						},
						{
							"node": "blur_y",
							"widget": "tileable"
						}
					],
					"longdesc": "Set it for tileable images, so the lighting is estimated across the edges",
					"name": "tileable",
					"shortdesc": "Tileable",
					"type": "linked_control"
				},
				{
					"label": "Strength",
					"linked_widgets": [
						{
							"node": "delight",
							"widget": "strength"
						}
					],
					"longdesc": "The strength of the correction",
					"name": "strength",
					"shortdesc": "Strength",
					"type": "linked_control"
				},
				{
					"label": "Brightness",
					"linked_widgets": [
						{
							"node": "delight",
							"widget": "brightness"
						}
					],
					"longdesc": "The brightness of the result, relative to the photo's average brightness",
					"name": "brightness",
					"shortdesc": "Brightness",
					"type": "linked_control"
				}
			]
		}
	],
