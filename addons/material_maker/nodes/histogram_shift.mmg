{
	"name": "histogram_shift",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"position": 0.0
	},
	"seed_int": 0,
	"shader_model": {
		"code": "float $(name_uv)_shifted = clamp($in($uv), 0.0, 1.0)+$position;",
		"global": "",
		"instance": "",
		"inputs": [
			{
				"default": "0.0",
				"label": "",
				"longdesc": "The input image",
				"name": "in",
				"shortdesc": "Input",
				"type": "f"
			}
		],
		"longdesc": "Shifts the input values, wrapping them around so the result stays between 0 and 1.",
		"name": "Histogram Shift",
		"outputs": [
			{
				"f": "$(name_uv)_shifted-max(ceil($(name_uv)_shifted)-1.0, 0.0)",
				"longdesc": "The output image",
				"shortdesc": "Output",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.0,
				"label": "Position",
				"longdesc": "The value added to the input",
				"max": 1,
				"min": 0,
				"name": "position",
				"shortdesc": "Position",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Histogram shift"
	},
	"type": "shader"
}