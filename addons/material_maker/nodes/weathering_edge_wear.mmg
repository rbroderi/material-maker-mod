{
	"name": "weathering_edge_wear",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"amount": 0.5,
		"softness": 0.1,
		"noise_scale": 8.0,
		"noise_amount": 0.5,
		"ao_weight": 0.5
	},
	"shader_model": {
		"code": "",
		"global": "",
		"inputs": [
			{
				"default": "0.5",
				"function": true,
				"label": "",
				"longdesc": "A curvature map (0.5 is flat, brighter is convex, darker is concave), e.g. from the Smooth Curvature or Mesh Map nodes",
				"name": "curvature",
				"shortdesc": "Curvature",
				"type": "f"
			},
			{
				"default": "1.0",
				"function": true,
				"label": "",
				"longdesc": "An ambient occlusion map (white where open, dark in cavities), e.g. from the Occlusion or Mesh Map nodes",
				"name": "ao",
				"shortdesc": "Ambient occlusion",
				"type": "f"
			}
		],
		"instance": [
			"float $(name)_mask(vec2 uv) {",
			"\tfloat noise = mm_weathering_fbm(uv, $noise_scale, 5, $seed)-0.5;",
			"\tfloat edges = clamp(($curvature(uv)-0.5)*2.0, 0.0, 1.0);",
			"\tedges *= mix(1.0, clamp($ao(uv), 0.0, 1.0), $ao_weight);",
			"\treturn mm_weathering_threshold(edges+noise*$noise_amount, $amount, $softness);",
			"}"
		],
		"longdesc": "Generates a mask of worn edges from a curvature map, kept out of occluded areas by an ambient occlusion map, and broken up by noise",
		"name": "Edge Wear",
		"outputs": [
			{
				"f": "$(name)_mask($uv)",
				"longdesc": "The weathering mask (1 where the effect is present)",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.5,
				"label": "Amount",
				"longdesc": "The amount of the effect: 0 gives an empty mask, 1 a full mask",
				"max": 1.0,
				"min": 0.0,
				"name": "amount",
				"shortdesc": "Amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.1,
				"label": "Softness",
				"longdesc": "The softness of the mask's edges",
				"max": 1.0,
				"min": 0.0,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Occlusion weight",
				"longdesc": "How much occluded areas (from the ambient occlusion map) are protected from wear",
				"max": 1.0,
				"min": 0.0,
				"name": "ao_weight",
				"shortdesc": "Occlusion weight",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Noise scale",
				"longdesc": "The scale of the noise that breaks up the mask (rounded to a whole number so the mask tiles)",
				"max": 64.0,
				"min": 1.0,
				"name": "noise_scale",
				"shortdesc": "Noise scale",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Noise amount",
				"longdesc": "How much the noise breaks up the mask",
				"max": 1.0,
				"min": 0.0,
				"name": "noise_amount",
				"shortdesc": "Noise amount",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Edge Wear",
		"includes": [
			"weathering_grunge"
		]
	}
}