{
	"name": "weathering_grunge",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"amount": 0.5,
		"noise_amount": 0.5,
		"noise_scale": 8.0,
		"softness": 0.1,
		"speckles": 0.3
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": [
			"// Shared by the weathering nodes (Edge Wear, Dirt, Grunge, Moss, Dust, Water Level)",
			"",
			"// Integer hash (PCG3D, Jarzynski and Olano 2020): the same values on every GPU",
			"uint mm_weathering_hash(uvec3 v) {",
			"\tv = v*1664525u+1013904223u;",
			"\tv.x += v.y*v.z;",
			"\tv.y += v.z*v.x;",
			"\tv.z += v.x*v.y;",
			"\tv ^= v >> 16u;",
			"\tv.x += v.y*v.z;",
			"\tv.y += v.z*v.x;",
			"\tv.z += v.x*v.y;",
			"\treturn v.x;",
			"}",
			"",
			"// A seed key from the node's seed",
			"uint mm_weathering_seed(float seed, uint salt) {",
			"\treturn mm_weathering_hash(uvec3(floatBitsToUint(seed), salt, 0x5eedu));",
			"}",
			"",
			"// A random value in [0, 1) for each lattice point, repeating every period points",
			"float mm_weathering_lattice(vec2 p, float period, uint seed) {",
			"\tuvec2 w = uvec2(mod(p, period));",
			"\treturn float(mm_weathering_hash(uvec3(w, seed)) >> 8u)/16777216.0;",
			"}",
			"",
			"// Value noise in [0, 1], tileable when uv*period covers whole cells",
			"float mm_weathering_noise(vec2 p, float period, uint seed) {",
			"\tvec2 i = floor(p);",
			"\tvec2 f = p-i;",
			"\tf = f*f*(3.0-2.0*f);",
			"\tfloat a = mm_weathering_lattice(i, period, seed);",
			"\tfloat b = mm_weathering_lattice(i+vec2(1.0, 0.0), period, seed);",
			"\tfloat c = mm_weathering_lattice(i+vec2(0.0, 1.0), period, seed);",
			"\tfloat d = mm_weathering_lattice(i+vec2(1.0, 1.0), period, seed);",
			"\treturn mix(mix(a, b, f.x), mix(c, d, f.x), f.y);",
			"}",
			"",
			"// Fractal value noise in [0, 1]. The scale is rounded to a whole number of",
			"// cells so the noise always tiles",
			"float mm_weathering_fbm(vec2 uv, float scale, int octaves, uint seed) {",
			"\tfloat period = max(floor(scale+0.5), 1.0);",
			"\tfloat value = 0.0;",
			"\tfloat amplitude = 0.5;",
			"\tfloat total = 0.0;",
			"\tfor (int i = 0; i < octaves; ++i) {",
			"\t\tvalue += amplitude*mm_weathering_noise(uv*period, period, seed+uint(i)*0x9e3779b9u);",
			"\t\ttotal += amplitude;",
			"\t\tamplitude *= 0.5;",
			"\t\tperiod *= 2.0;",
			"\t}",
			"\treturn value/total;",
			"}",
			"",
			"// Turns a value in [0, 1] into a mask: amount 0 gives an empty mask,",
			"// amount 1 a full mask, and softness the width of the transition",
			"float mm_weathering_threshold(float v, float amount, float softness) {",
			"\tfloat s = max(softness, 0.001);",
			"\tfloat t = mix(1.0, -s, clamp(amount, 0.0, 1.0));",
			"\treturn smoothstep(t, t+s, clamp(v, 0.0, 1.0));",
			"}",
			"",
			"// Decodes Material Maker's normal maps (flat is (0.5, 0.5, 0.0)) into a unit",
			"// vector: x is the slope towards the right of the image (the surface faces",
			"// left when it is positive), y the slope towards its bottom (the surface faces",
			"// up when it is positive), and z points out of the surface",
			"vec3 mm_weathering_normal(vec3 c) {",
			"\tvec3 n = vec3(2.0*c.xy-vec2(1.0), 1.0-2.0*c.z);",
			"\treturn n/max(length(n), 0.000001);",
			"}",
			""
		],
		"inputs": [],
		"instance": [
			"float $(name)_mask(vec2 uv) {",
			"\tfloat noise = mm_weathering_fbm(uv, $noise_scale, 5, mm_weathering_seed($seed, 1u))-0.5;",
			"\tfloat stains = mm_weathering_fbm(uv, $noise_scale*0.5, 6, mm_weathering_seed($seed, 2u));",
			"\tfloat grunge = mm_weathering_threshold(stains+noise*$noise_amount, $amount, $softness);",
			"\tfloat specks_noise = mm_weathering_noise(uv*floor($noise_scale*16.0+0.5), floor($noise_scale*16.0+0.5), mm_weathering_seed($seed, 3u));",
			"\tfloat specks = ($speckles > 0.0) ? smoothstep(1.0-0.35*$speckles, 1.0-0.3*$speckles, specks_noise) : 0.0;",
			"\treturn max(grunge, specks);",
			"}"
		],
		"longdesc": "Generates a procedural grunge mask: layered noise with stains and speckles",
		"name": "Grunge",
		"outputs": [
			{
				"f": "$(name)_mask($uv)",
				"longdesc": "The weathering mask (1 where the effect is present)",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.5,
				"label": "Amount",
				"longdesc": "The amount of the effect: 0 gives an empty mask, 1 a full mask",
				"max": 1.0,
				"min": 0.0,
				"name": "amount",
				"shortdesc": "Amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.1,
				"label": "Softness",
				"longdesc": "The softness of the mask's edges",
				"max": 1.0,
				"min": 0.0,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.3,
				"label": "Speckles",
				"longdesc": "The amount of small speckles, added to the mask (even when Amount is 0)",
				"max": 1.0,
				"min": 0.0,
				"name": "speckles",
				"shortdesc": "Speckles",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Noise scale",
				"longdesc": "The scale of the noise that breaks up the mask (rounded to a whole number so the mask tiles)",
				"max": 64.0,
				"min": 1.0,
				"name": "noise_scale",
				"shortdesc": "Noise scale",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Noise amount",
				"longdesc": "How much the noise breaks up the mask",
				"max": 1.0,
				"min": 0.0,
				"name": "noise_amount",
				"shortdesc": "Noise amount",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Grunge"
	},
	"type": "shader"
}