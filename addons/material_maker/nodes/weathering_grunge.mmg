{
	"name": "weathering_grunge",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"amount": 0.5,
		"softness": 0.1,
		"speckles": 0.3,
		"noise_scale": 8.0,
		"noise_amount": 0.5
	},
	"shader_model": {
		"code": "",
		"global": "// Tileable value noise and fBm for weathering masks\nfloat mm_weathering_noise(vec2 p, float period) {\n\tvec2 i = floor(p);\n\tvec2 f = fract(p);\n\tf = f*f*(3.0-2.0*f);\n\tfloat a = rand(mod(i, period));\n\tfloat b = rand(mod(i+vec2(1.0, 0.0), period));\n\tfloat c = rand(mod(i+vec2(0.0, 1.0), period));\n\tfloat d = rand(mod(i+vec2(1.0, 1.0), period));\n\treturn mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\n}\n\nfloat mm_weathering_fbm(vec2 uv, float scale, int octaves, float seed) {\n\tfloat value = 0.0;\n\tfloat amplitude = 0.5;\n\tfloat total = 0.0;\n\tfor (int i = 0; i < octaves; ++i) {\n\t\tvalue += amplitude*mm_weathering_noise(uv*scale+vec2(seed*13.7, seed*7.3), scale);\n\t\ttotal += amplitude;\n\t\tamplitude *= 0.5;\n\t\tscale *= 2.0;\n\t}\n\treturn value/total;\n}\n",
		"inputs": [],
		"instance": [
			"float $(name)_mask(vec2 uv) {",
			"\tfloat noise = mm_weathering_fbm(uv, $noise_scale, 5, $seed)-0.5;",
			"\tfloat stains = mm_weathering_fbm(uv, $noise_scale*0.5, 6, $seed+3.1);",
			"\tfloat specks = step(1.0-$speckles*0.2, mm_weathering_noise(uv*$noise_scale*16.0, $noise_scale*16.0));",
			"\tfloat grunge = stains+noise*$noise_amount*0.5;",
			"\treturn max(smoothstep(1.0-$amount, 1.0-$amount+$softness+0.0001, grunge), specks);",
			"}"
		],
		"longdesc": "Generates a procedural grunge mask: layered noise with stains and speckles",
		"name": "Grunge",
		"outputs": [
			{
				"f": "$(name)_mask($uv)",
				"longdesc": "The weathering mask (1 where the effect is present)",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.5,
				"label": "Amount",
				"longdesc": "The amount of the effect",
				"max": 1.0,
				"min": 0.0,
				"name": "amount",
				"shortdesc": "Amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.1,
				"label": "Softness",
				"longdesc": "The softness of the mask's edges",
				"max": 1.0,
				"min": 0.0,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.3,
				"label": "Speckles",
				"longdesc": "The amount of small speckles",
				"max": 1.0,
				"min": 0.0,
				"name": "speckles",
				"shortdesc": "Speckles",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Noise scale",
				"longdesc": "The scale of the noise that breaks up the mask",
				"max": 64.0,
				"min": 1.0,
				"name": "noise_scale",
				"shortdesc": "Noise scale",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Noise amount",
				"longdesc": "How much the noise breaks up the mask",
				"max": 1.0,
				"min": 0.0,
				"name": "noise_amount",
				"shortdesc": "Noise amount",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Grunge"
	}
}