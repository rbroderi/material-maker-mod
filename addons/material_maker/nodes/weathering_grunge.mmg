{
	"name": "weathering_grunge",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"amount": 0.5,
		"softness": 0.1,
		"speckles": 0.3,
		"noise_scale": 8.0,
		"noise_amount": 0.5
	},
	"shader_model": {
		"code": "",
		"global": [
			"// Shared by the weathering nodes (Edge Wear, Dirt, Grunge, Moss, Dust, Water Level)",
			"",
			"// i modulo n in [0, n), also for negative i. Integer maths: the float mod()",
			"// divides approximately on GPUs and can return n instead of 0, which breaks",
			"// tiling when n is not a power of two (GLSL's % is undefined for negatives)",
			"int mm_weathering_wrap(int i, int n) {",
			"\treturn (i >= 0) ? i%n : n-1-(-1-i)%n;",
			"}",
			"",
			"// Tileable value noise, repeating every period cells (rounded to a whole number)",
			"float mm_weathering_noise(vec2 p, float period) {",
			"\tvec2 i = floor(p);",
			"\tvec2 f = p-i;",
			"\tf = f*f*(3.0-2.0*f);",
			"\tint n = max(int(floor(period+0.5)), 1);",
			"\tivec2 i0 = ivec2(i);",
			"\tvec2 w0 = vec2(float(mm_weathering_wrap(i0.x, n)), float(mm_weathering_wrap(i0.y, n)));",
			"\tvec2 w1 = vec2(float(mm_weathering_wrap(i0.x+1, n)), float(mm_weathering_wrap(i0.y+1, n)));",
			"\tfloat a = rand(w0);",
			"\tfloat b = rand(vec2(w1.x, w0.y));",
			"\tfloat c = rand(vec2(w0.x, w1.y));",
			"\tfloat d = rand(w1);",
			"\treturn mix(mix(a, b, f.x), mix(c, d, f.x), f.y);",
			"}",
			"",
			"// Fractal value noise in [0, 1]. The scale is rounded to a whole number of",
			"// cells so the noise always tiles",
			"float mm_weathering_fbm(vec2 uv, float scale, int octaves, float seed) {",
			"\tfloat period = max(floor(scale+0.5), 1.0);",
			"\tfloat value = 0.0;",
			"\tfloat amplitude = 0.5;",
			"\tfloat total = 0.0;",
			"\tfor (int i = 0; i < octaves; ++i) {",
			"\t\tvalue += amplitude*mm_weathering_noise(uv*period+vec2(seed*13.7, seed*7.3), period);",
			"\t\ttotal += amplitude;",
			"\t\tamplitude *= 0.5;",
			"\t\tperiod *= 2.0;",
			"\t}",
			"\treturn value/total;",
			"}",
			"",
			"// Turns a value in [0, 1] into a mask: amount 0 gives an empty mask,",
			"// amount 1 a full mask, and softness the width of the transition",
			"float mm_weathering_threshold(float v, float amount, float softness) {",
			"\tfloat s = max(softness, 0.001);",
			"\tfloat t = mix(1.0, -s, clamp(amount, 0.0, 1.0));",
			"\treturn smoothstep(t, t+s, clamp(v, 0.0, 1.0));",
			"}",
			"",
			"// Decodes Material Maker's normal maps (flat is (0.5, 0.5, 0.0)) into a unit",
			"// vector: x is the slope towards the right of the image (the surface faces",
			"// left when it is positive), y the slope towards its bottom (the surface faces",
			"// up when it is positive), and z points out of the surface",
			"vec3 mm_weathering_normal(vec3 c) {",
			"\tvec3 n = vec3(2.0*c.xy-vec2(1.0), 1.0-2.0*c.z);",
			"\treturn n/max(length(n), 0.000001);",
			"}",
			""
		],
		"inputs": [],
		"instance": [
			"float $(name)_mask(vec2 uv) {",
			"\tfloat noise = mm_weathering_fbm(uv, $noise_scale, 5, $seed)-0.5;",
			"\tfloat stains = mm_weathering_fbm(uv, $noise_scale*0.5, 6, $seed+3.1);",
			"\tfloat specks_period = max(floor($noise_scale*16.0+0.5), 1.0);",
			"\tfloat specks = step(1.0-$speckles*0.2, mm_weathering_noise(uv*specks_period, specks_period));",
			"\tfloat grunge = mm_weathering_threshold(stains+noise*$noise_amount*0.5, $amount, $softness);",
			"\treturn max(grunge, specks);",
			"}"
		],
		"longdesc": "Generates a procedural grunge mask: layered noise with stains and speckles",
		"name": "Grunge",
		"outputs": [
			{
				"f": "$(name)_mask($uv)",
				"longdesc": "The weathering mask (1 where the effect is present)",
				"shortdesc": "Mask",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 0.5,
				"label": "Amount",
				"longdesc": "The amount of the effect: 0 gives an empty mask, 1 a full mask",
				"max": 1.0,
				"min": 0.0,
				"name": "amount",
				"shortdesc": "Amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.1,
				"label": "Softness",
				"longdesc": "The softness of the mask's edges",
				"max": 1.0,
				"min": 0.0,
				"name": "softness",
				"shortdesc": "Softness",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.3,
				"label": "Speckles",
				"longdesc": "The amount of small speckles, added to the mask (even when Amount is 0)",
				"max": 1.0,
				"min": 0.0,
				"name": "speckles",
				"shortdesc": "Speckles",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Noise scale",
				"longdesc": "The scale of the noise that breaks up the mask (rounded to a whole number so the mask tiles)",
				"max": 64.0,
				"min": 1.0,
				"name": "noise_scale",
				"shortdesc": "Noise scale",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Noise amount",
				"longdesc": "How much the noise breaks up the mask",
				"max": 1.0,
				"min": 0.0,
				"name": "noise_amount",
				"shortdesc": "Noise amount",
				"step": 0.01,
				"type": "float"
			}
		],
		"shortdesc": "Grunge"
	}
}