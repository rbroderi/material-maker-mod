{
	"name": "tile_sampler",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"seed_int": 0,
	"type": "shader",
	"parameters": {
		"x_count": 8.0,
		"y_count": 8.0,
		"scale": 0.8,
		"scale_random": 0.0,
		"rotation": 0.0,
		"rotation_random": 0.0,
		"position_random": 0.0,
		"row_offset": 0.0,
		"displacement": 0.0,
		"drop": 0.0,
		"value_random": 0.0,
		"pattern_count": 1.0,
		"pattern_mode": 0,
		"symmetry": 0,
		"blend": 0
	},
	"shader_model": {
		"code": "float $(name_uv)_id;\nvec4 $(name_uv)_ts = $(name)_sample($uv, $(name_uv)_id);",
		"global": "",
		"inputs": [
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0)*4.0)",
				"function": true,
				"label": "",
				"longdesc": "Pattern 1 (its alpha is the coverage of instances)",
				"name": "in1",
				"shortdesc": "Pattern 1",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0)*4.0)",
				"function": true,
				"label": "",
				"longdesc": "Pattern 2",
				"name": "in2",
				"shortdesc": "Pattern 2",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0)*4.0)",
				"function": true,
				"label": "",
				"longdesc": "Pattern 3",
				"name": "in3",
				"shortdesc": "Pattern 3",
				"type": "rgba"
			},
			{
				"default": "vec4(vec3(1.0), clamp(1.0-2.0*length($uv-vec2(0.5)), 0.0, 1.0)*4.0)",
				"function": true,
				"label": "",
				"longdesc": "Pattern 4",
				"name": "in4",
				"shortdesc": "Pattern 4",
				"type": "rgba"
			},
			{
				"default": "1.0",
				"function": true,
				"label": "",
				"longdesc": "The probability that an instance is kept, sampled at its position",
				"name": "mask",
				"shortdesc": "Mask",
				"type": "f"
			},
			{
				"default": "1.0",
				"function": true,
				"label": "",
				"longdesc": "Multiplies the scale of instances (from 0 to 1), sampled at their position",
				"name": "scale_map",
				"shortdesc": "Scale map",
				"type": "f"
			},
			{
				"default": "0.0",
				"function": true,
				"label": "",
				"longdesc": "Adds a rotation (1 is a full turn), sampled at the position of instances",
				"name": "rotation_map",
				"shortdesc": "Rotation map",
				"type": "f"
			},
			{
				"default": "0.0",
				"function": true,
				"label": "",
				"longdesc": "Selects the pattern of instances (with the By map pattern selection)",
				"name": "pattern_map",
				"shortdesc": "Pattern map",
				"type": "f"
			},
			{
				"default": "vec3(0.5)",
				"function": true,
				"label": "",
				"longdesc": "A vector map (red and green, 0.5 is no displacement) that moves instances, sampled at their position",
				"name": "displacement_map",
				"shortdesc": "Displacement map",
				"type": "rgb"
			}
		],
		"instance": [
			"// Integer hash (exact on every GPU, so a seed always gives the same layout)",
			"uint $(name)_hash(uint x) {",
			"\tx ^= x >> 16u;",
			"\tx *= 0x7feb352du;",
			"\tx ^= x >> 15u;",
			"\tx *= 0x846ca68bu;",
			"\tx ^= x >> 16u;",
			"\treturn x;",
			"}",
			"",
			"// A random value in [0, 1) for an instance key and an index",
			"float $(name)_rand(uint key, uint i) {",
			"\treturn float($(name)_hash(key+i*0x9e3779b9u) >> 8u)/16777216.0;",
			"}",
			"",
			"// Wraps a cell index into [0, n) (% is undefined for negative values in GLSL)",
			"int $(name)_wrap(int i, int n) {",
			"\treturn (i >= 0) ? (i % n) : (n-1-((-i-1) % n));",
			"}",
			"",
			"vec4 $(name)_pattern(int index, vec2 uv) {",
			"\tif (index <= 0) {",
			"\t\treturn $in1(uv);",
			"\t} else if (index == 1) {",
			"\t\treturn $in2(uv);",
			"\t} else if (index == 2) {",
			"\t\treturn $in3(uv);",
			"\t}",
			"\treturn $in4(uv);",
			"}",
			"",
			"vec4 $(name)_sample(vec2 uv, out float instance_id) {",
			"\tivec2 n = ivec2(max(floor(vec2($x_count, $y_count)), vec2(1.0)));",
			"\tvec2 count = vec2(n);",
			"\tivec2 cell = ivec2(floor(uv*count));",
			"\tfloat max_scale = max($scale, 0.0001);",
			"\t// Only the cells whose instance can reach this pixel are checked: half diagonal of the",
			"\t// largest instance plus the largest offset of its center, in cells (at most 8 cells away)",
			"\tfloat reach = 0.70711*max_scale+0.5*$position_random+0.5;",
			"\tfloat displacement = clamp($displacement, 0.0, 1.0);",
			"\tint rx = min(int(floor(reach+$row_offset+0.5*displacement*count.x)), 8);",
			"\tint ry = min(int(floor(reach+0.5*displacement*count.y)), 8);",
			"\tuint seed_key = $(name)_hash(floatBitsToUint($seed));",
			"\tint pattern_count = clamp(int($pattern_count), 1, 4);",
			"\tvec4 result = vec4(0.0);",
			"\tinstance_id = 0.0;",
			"\t// Height ordered blending: the 8 highest instances that cover the pixel, highest first",
			"\tvec4 layer_color[8];",
			"\tfloat layer_height[8];",
			"\tint layers = 0;",
			"\tfor (int dy = -ry; dy <= ry; ++dy) {",
			"\t\tfor (int dx = -rx; dx <= rx; ++dx) {",
			"\t\t\tivec2 c = cell+ivec2(dx, dy);",
			"\t\t\t// Random values depend on the wrapped cell, so the result tiles",
			"\t\t\tint wx = $(name)_wrap(c.x, n.x);",
			"\t\t\tint wy = $(name)_wrap(c.y, n.y);",
			"\t\t\tuint key = $(name)_hash(uint(wy)+seed_key);",
			"\t\t\tkey = $(name)_hash(uint(wx)+key);",
			"\t\t\tfloat row_offset = float(wy & 1)*$row_offset;",
			"\t\t\tvec2 jitter = vec2($(name)_rand(key, 0u), $(name)_rand(key, 1u))-vec2(0.5);",
			"\t\t\tvec2 center = (vec2(c)+vec2(0.5+row_offset, 0.5)+$position_random*jitter)/count;",
			"\t\t\tvec2 map_uv = fract(center);",
			"\t\t\tcenter += displacement*(clamp($displacement_map(map_uv).xy, vec2(0.0), vec2(1.0))-vec2(0.5));",
			"\t\t\tif ($(name)_rand(key, 2u) >= $mask(map_uv)*(1.0-$drop)) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tfloat scale = max(max_scale*clamp($scale_map(map_uv), 0.0, 1.0)*(1.0-$scale_random*$(name)_rand(key, 3u)), 0.0001);",
			"\t\t\tfloat a = radians($rotation+360.0*$rotation_map(map_uv)+180.0*$rotation_random*(2.0*$(name)_rand(key, 4u)-1.0));",
			"\t\t\tvec2 local = mat2(vec2(cos(a), -sin(a)), vec2(sin(a), cos(a)))*((uv-center)*count)/scale+vec2(0.5);",
			"\t\t\tif ($symmetry == 1 || $symmetry == 3) {",
			"\t\t\t\tlocal.x = $(name)_rand(key, 5u) < 0.5 ? 1.0-local.x : local.x;",
			"\t\t\t}",
			"\t\t\tif ($symmetry == 2 || $symmetry == 3) {",
			"\t\t\t\tlocal.y = $(name)_rand(key, 6u) < 0.5 ? 1.0-local.y : local.y;",
			"\t\t\t} else if ($symmetry == 4) {",
			"\t\t\t\tint quarter = int(floor($(name)_rand(key, 5u)*4.0));",
			"\t\t\t\tlocal = quarter == 1 ? vec2(local.y, 1.0-local.x) : (quarter == 2 ? vec2(1.0)-local : (quarter == 3 ? vec2(1.0-local.y, local.x) : local));",
			"\t\t\t}",
			"\t\t\tif (any(lessThan(local, vec2(0.0))) || any(greaterThan(local, vec2(1.0)))) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tint index = int(floor($(name)_rand(key, 7u)*float(pattern_count)));",
			"\t\t\tif ($pattern_mode == 1) {",
			"\t\t\t\tindex = int(floor(clamp($pattern_map(map_uv), 0.0, 0.9999)*float(pattern_count)));",
			"\t\t\t} else if ($pattern_mode == 2) {",
			"\t\t\t\tindex = (wx+wy*n.x) % pattern_count;",
			"\t\t\t}",
			"\t\t\tvec4 color = $(name)_pattern(index, local);",
			"\t\t\tcolor.rgb *= 1.0-$value_random*$(name)_rand(key, 8u);",
			"\t\t\tfloat alpha = clamp(color.a, 0.0, 1.0);",
			"\t\t\tif (alpha <= 0.0) {",
			"\t\t\t\tcontinue;",
			"\t\t\t}",
			"\t\t\tfloat height = $(name)_rand(key, 9u);",
			"\t\t\tif ($blend == 0) {",
			"\t\t\t\tif (dot(color.rgb, vec3(1.0))*alpha > dot(result.rgb, vec3(1.0))) {",
			"\t\t\t\t\tinstance_id = height;",
			"\t\t\t\t}",
			"\t\t\t\tresult = vec4(max(result.rgb, color.rgb*alpha), max(result.a, alpha));",
			"\t\t\t} else if ($blend == 1) {",
			"\t\t\t\tif (layers < 8 || height > layer_height[7]) {",
			"\t\t\t\t\tint i = min(layers, 7);",
			"\t\t\t\t\twhile (i > 0 && layer_height[i-1] < height) {",
			"\t\t\t\t\t\tlayer_color[i] = layer_color[i-1];",
			"\t\t\t\t\t\tlayer_height[i] = layer_height[i-1];",
			"\t\t\t\t\t\t--i;",
			"\t\t\t\t\t}",
			"\t\t\t\t\tlayer_color[i] = vec4(color.rgb, alpha);",
			"\t\t\t\t\tlayer_height[i] = height;",
			"\t\t\t\t\tlayers = min(layers+1, 8);",
			"\t\t\t\t}",
			"\t\t\t} else if ($blend == 2) {",
			"\t\t\t\tresult = vec4(mix(result.rgb, color.rgb, alpha), alpha+result.a*(1.0-alpha));",
			"\t\t\t\tinstance_id = height;",
			"\t\t\t} else {",
			"\t\t\t\tresult += vec4(color.rgb*alpha, alpha);",
			"\t\t\t\tinstance_id = height;",
			"\t\t\t}",
			"\t\t}",
			"\t}",
			"\tif ($blend == 1 && layers > 0) {",
			"\t\t// Stacks the instances from the lowest to the highest",
			"\t\tfor (int i = layers-1; i >= 0; --i) {",
			"\t\t\tresult = vec4(mix(result.rgb, layer_color[i].rgb, layer_color[i].a), layer_color[i].a+result.a*(1.0-layer_color[i].a));",
			"\t\t}",
			"\t\tinstance_id = layer_height[0];",
			"\t}",
			"\treturn vec4(result.rgb, min(result.a, 1.0));",
			"}"
		],
		"longdesc": "Places pattern instances on a grid, with random or map driven position, scale, rotation, pattern choice, symmetry and value, and several ways to stack overlapping instances. The result tiles.",
		"name": "Tile Sampler",
		"outputs": [
			{
				"rgba": "$(name_uv)_ts",
				"longdesc": "The sampled patterns",
				"shortdesc": "Output",
				"type": "rgba"
			},
			{
				"f": "$(name_uv)_id",
				"longdesc": "A random value for each instance (of the instance that is shown)",
				"shortdesc": "Instance",
				"type": "f"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 8.0,
				"label": "X count",
				"longdesc": "The number of columns",
				"max": 64.0,
				"min": 1.0,
				"name": "x_count",
				"shortdesc": "X count",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8.0,
				"label": "Y count",
				"longdesc": "The number of rows",
				"max": 64.0,
				"min": 1.0,
				"name": "y_count",
				"shortdesc": "Y count",
				"step": 1.0,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.8,
				"label": "Scale",
				"longdesc": "The size of instances, relative to a cell",
				"max": 2.0,
				"min": 0.0,
				"name": "scale",
				"shortdesc": "Scale",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Scale random",
				"longdesc": "The random reduction of the scale",
				"max": 1.0,
				"min": 0.0,
				"name": "scale_random",
				"shortdesc": "Scale random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Rotation",
				"longdesc": "The rotation of instances, in degrees",
				"max": 180.0,
				"min": -180.0,
				"name": "rotation",
				"shortdesc": "Rotation",
				"step": 0.1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Rotation random",
				"longdesc": "The random rotation of instances (1 is up to half a turn either way)",
				"max": 1.0,
				"min": 0.0,
				"name": "rotation_random",
				"shortdesc": "Rotation random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Position random",
				"longdesc": "The random offset of instances in their cell",
				"max": 1.0,
				"min": 0.0,
				"name": "position_random",
				"shortdesc": "Position random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Row offset",
				"longdesc": "The offset of odd rows, in cells (0.5 for bricks, with an even number of rows)",
				"max": 1.0,
				"min": 0.0,
				"name": "row_offset",
				"shortdesc": "Row offset",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Displacement",
				"longdesc": "The amount of displacement by the displacement map (1 moves instances by up to half the texture)",
				"max": 1.0,
				"min": 0.0,
				"name": "displacement",
				"shortdesc": "Displacement",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Drop",
				"longdesc": "The proportion of instances that are removed at random",
				"max": 1.0,
				"min": 0.0,
				"name": "drop",
				"shortdesc": "Drop",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Value random",
				"longdesc": "The random darkening of instances",
				"max": 1.0,
				"min": 0.0,
				"name": "value_random",
				"shortdesc": "Value random",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Patterns",
				"longdesc": "The number of pattern inputs that are used",
				"max": 4.0,
				"min": 1.0,
				"name": "pattern_count",
				"shortdesc": "Patterns",
				"step": 1.0,
				"type": "float"
			},
			{
				"default": 0,
				"label": "Pattern selection",
				"longdesc": "How the pattern of each instance is chosen",
				"name": "pattern_mode",
				"shortdesc": "Pattern selection",
				"type": "enum",
				"values": [
					{
						"name": "Random",
						"value": "0"
					},
					{
						"name": "By map",
						"value": "1"
					},
					{
						"name": "Sequence",
						"value": "2"
					}
				]
			},
			{
				"default": 0,
				"label": "Symmetry",
				"longdesc": "Random symmetries applied to instances",
				"name": "symmetry",
				"shortdesc": "Symmetry",
				"type": "enum",
				"values": [
					{
						"name": "None",
						"value": "0"
					},
					{
						"name": "Random mirror X",
						"value": "1"
					},
					{
						"name": "Random mirror Y",
						"value": "2"
					},
					{
						"name": "Random mirror X and Y",
						"value": "3"
					},
					{
						"name": "Random 90 degree rotation",
						"value": "4"
					}
				]
			},
			{
				"default": 0,
				"label": "Blend",
				"longdesc": "How overlapping instances are combined: Max keeps the brightest, Height ordered stacks them in the order of a random height (the highest on top), Alpha over stacks them row by row, Add sums them",
				"name": "blend",
				"shortdesc": "Blend",
				"type": "enum",
				"values": [
					{
						"name": "Max",
						"value": "0"
					},
					{
						"name": "Height ordered",
						"value": "1"
					},
					{
						"name": "Alpha over",
						"value": "2"
					},
					{
						"name": "Add",
						"value": "3"
					}
				]
			}
		],
		"shortdesc": "Tile Sampler"
	}
}