{
	"export": {},
	"name": "material_car_paint",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"ambient_scale": 1.0,
		"coeff0": 0.0,
		"coeff1": 0.0,
		"coeff2": 0.0,
		"color_table_scale": 1.0,
		"diffuse": 0.1,
		"f0_0": 0.5,
		"f0_1": 0.5,
		"f0_2": 0.5,
		"flake_intensity": 1.0,
		"flake_max_theta_f": 8,
		"flake_max_theta_i": 12,
		"flake_scale": 1.0,
		"flake_theta_f_slices": 24,
		"flake_theta_i_slices": 24,
		"flake_tiling": 4.0,
		"ior": 1.5,
		"refraction": true,
		"spread0": 0.2,
		"spread1": 0.2,
		"spread2": 0.2
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"custom": "",
		"exports": {
			"Godot/Godot 4": {
				"export_extension": "tres",
				"files": [
					{
						"file_name": "$(path_prefix).tres",
						"prompt_overwrite": true,
						"template": [
							"[gd_resource type=\"ShaderMaterial\" load_steps=2 format=2]",
							"[ext_resource path=\"$(file_prefix).gdshader\" type=\"Shader\" id=1]",
							"$begin_buffers",
							"[ext_resource path=\"$(file_prefix)_texture_$(buffer_index).png\" type=\"Texture\" id=$(expr:$(buffer_index)+1)]",
							"$end_buffers",
							"[resource]",
							"shader = ExtResource( 1 )",
							"$begin_buffers",
							"shader_parameter/texture_$(buffer_index) = ExtResource( $(expr:$(buffer_index)+1) )",
							"$end_buffers",
							""
						],
						"type": "template"
					},
					{
						"file_name": "$(path_prefix).gdshader",
						"prompt_overwrite": false,
						"template": [
							"shader_type spatial;",
							"render_mode blend_mix,cull_back,diffuse_burley,specular_schlick_ggx;",
							"",
							"uniform vec3 uv1_offset = vec3(0.0, 0.0, 0.0);",
							"uniform vec3 uv1_scale = vec3(1.0, 1.0, 1.0);",
							"uniform float variation = 0.0;",
							"",
							"varying float elapsed_time;",
							"varying vec2 mm_car_paint_uv;",
							"",
							"void vertex() {",
							"\telapsed_time = TIME;",
							"\tUV = UV*uv1_scale.xy+uv1_offset.xy;",
							"}",
							"",
							"// X-Rite CarPaint2: a clear coat over Lambert and Cook-Torrance lobes,",
							"// tinted by a color table indexed by the half vector angle (theta H) and",
							"// the light-half vector angle (theta D), and flakes (a BTF indexed by",
							"// theta F = theta H and theta I = theta D)",
							"vec3 mm_car_paint_linear(vec3 c) {",
							"\treturn mix(pow((c + vec3(0.055)) * (1.0 / (1.0 + 0.055)),vec3(2.4)),c * (1.0 / 12.92),lessThan(c,vec3(0.04045)));",
							"}",
							"",
							"float mm_car_paint_fresnel(float cos_i, float ior) {",
							"\tcos_i = clamp(cos_i, 0.0, 1.0);",
							"\tfloat cos_t = sqrt(max(1.0-(1.0-cos_i*cos_i)/(ior*ior), 0.0));",
							"\tfloat rs = (cos_i-ior*cos_t)/(cos_i+ior*cos_t);",
							"\tfloat rp = (ior*cos_i-cos_t)/(ior*cos_i+cos_t);",
							"\treturn 0.5*(rs*rs+rp*rp);",
							"}",
							"",
							"// Cook-Torrance lobe: Beckmann distribution (not normalized, as in the",
							"// AxF model) and Schlick's Fresnel",
							"float mm_car_paint_lobe(float nh, float vh, float coeff, float spread, float f0) {",
							"\tfloat c2 = nh*nh;",
							"\tfloat d = exp((c2-1.0)/(c2*spread*spread))/(spread*spread*c2*c2);",
							"\treturn coeff*d*(f0+(1.0-f0)*pow(1.0-vh, 5.0));",
							"}",
							"",
							"// Flake values are stored with square root companding around 0.5",
							"vec3 mm_car_paint_flake(vec3 e) {",
							"\tvec3 v = 2.0*(e-vec3(0.5));",
							"\treturn sign(v)*v*v;",
							"}",
							"",
							"$definitions float_uniform_to_const,rename_buffers",
							"",
							"void fragment() {",
							"\tfloat _seed_variation_ = variation;",
							"\tvec4 _controlled_variation_ = vec4(0.0);",
							"\tvec2 uv = fract(UV);",
							"\tmm_car_paint_uv = UV;",
							"\tfloat theta_v = acos(clamp(dot(NORMAL, VIEW), 0.0, 1.0));",
							"$begin_generate rename_buffers",
							"\t// Ambient light: reflectance under uniform lighting for this view angle",
							"\tALBEDO = mm_car_paint_linear($ambient(vec2(clamp(theta_v/(0.5*PI), 0.0, 1.0), 0.5)).rgb)*$ambient_scale;",
							"$end_generate",
							"\tMETALLIC = 0.0;",
							"\tSPECULAR = 0.0;",
							"\tROUGHNESS = 1.0;",
							"\t// The clear coat reflects the environment",
							"\tCLEARCOAT = 1.0;",
							"\tCLEARCOAT_ROUGHNESS = 0.0;",
							"}",
							"",
							"void light() {",
							"\tvec3 N = NORMAL;",
							"\tfloat nl = dot(N, LIGHT);",
							"\tfloat nv = dot(N, VIEW);",
							"\tif (nl > 0.001 && nv > 0.001) {",
							"\t\tvec3 radiance = LIGHT_COLOR*ATTENUATION*nl;",
							"\t\t// Parameters (input code is generated at the start of blocks, so",
							"\t\t// textures are sampled at coordinates computed before them)",
							"\t\tfloat ior;",
							"\t\tbool refraction;",
							"\t\tvec3 lobe0;",
							"\t\tvec3 lobe1;",
							"\t\tvec3 lobe2;",
							"\t\tvec4 flake_grid;",
							"\t\tfloat flake_tiling;",
							"$begin_generate rename_buffers",
							"\t\tior = $ior;",
							"\t\trefraction = $refraction;",
							"\t\tlobe0 = vec3($coeff0, $spread0, $f0_0);",
							"\t\tlobe1 = vec3($coeff1, $spread1, $f0_1);",
							"\t\tlobe2 = vec3($coeff2, $spread2, $f0_2);",
							"\t\tflake_grid = vec4($flake_theta_f_slices, $flake_theta_i_slices, max($flake_max_theta_f, 1.0), max($flake_max_theta_i, 1.0));",
							"\t\tflake_tiling = $flake_tiling;",
							"$end_generate",
							"\t\t// Light and view directions below the clear coat",
							"\t\tvec3 l2 = LIGHT;",
							"\t\tvec3 v2 = VIEW;",
							"\t\tif (refraction) {",
							"\t\t\tl2 = -refract(-LIGHT, N, 1.0/ior);",
							"\t\t\tv2 = -refract(-VIEW, N, 1.0/ior);",
							"\t\t}",
							"\t\tvec3 h = normalize(l2+v2);",
							"\t\tfloat nh = clamp(dot(N, h), 0.0001, 1.0);",
							"\t\tfloat vh = clamp(dot(v2, h), 0.0001, 1.0);",
							"\t\tfloat nl2 = clamp(dot(N, l2), 0.001, 1.0);",
							"\t\tfloat nv2 = clamp(dot(N, v2), 0.001, 1.0);",
							"\t\tfloat theta_h = acos(nh);",
							"\t\tfloat theta_d = acos(clamp(dot(l2, h), -1.0, 1.0));",
							"\t\tfloat g = min(1.0, min(2.0*nh*nv2/vh, 2.0*nh*nl2/vh));",
							"\t\tfloat specular = mm_car_paint_lobe(nh, vh, lobe0.x, lobe0.y, lobe0.z);",
							"\t\tspecular += mm_car_paint_lobe(nh, vh, lobe1.x, lobe1.y, lobe1.z);",
							"\t\tspecular += mm_car_paint_lobe(nh, vh, lobe2.x, lobe2.y, lobe2.z);",
							"\t\tspecular *= g/(PI*nl2*nv2);",
							"\t\tvec2 table_uv = clamp(vec2(theta_h, theta_d)/(0.5*PI), vec2(0.0), vec2(1.0))*(63.0/64.0)+vec2(0.5/64.0);",
							"\t\t// Flakes: bilinear interpolation of the 4 nearest angular slices",
							"\t\tvec2 bins = vec2(theta_h, theta_d)/(0.5*PI)*flake_grid.xy;",
							"\t\tvec2 bin0 = floor(bins);",
							"\t\tvec2 w = bins-bin0;",
							"\t\tvec2 grid = flake_grid.zw;",
							"\t\tvec2 cell_uv = clamp(fract(mm_car_paint_uv*flake_tiling), vec2(0.002), vec2(0.998));",
							"\t\tvec2 flake_uv00 = (bin0+cell_uv)/grid;",
							"\t\tvec2 flake_uv10 = (bin0+vec2(1.0, 0.0)+cell_uv)/grid;",
							"\t\tvec2 flake_uv01 = (bin0+vec2(0.0, 1.0)+cell_uv)/grid;",
							"\t\tvec2 flake_uv11 = (bin0+vec2(1.0)+cell_uv)/grid;",
							"\t\tvec4 flake_weights = vec4((1.0-w.x)*(1.0-w.y), w.x*(1.0-w.y), (1.0-w.x)*w.y, w.x*w.y);",
							"\t\tflake_weights *= vec4(",
							"\t\t\tfloat(bin0.x < grid.x && bin0.y < grid.y),",
							"\t\t\tfloat(bin0.x+1.0 < grid.x && bin0.y < grid.y),",
							"\t\t\tfloat(bin0.x < grid.x && bin0.y+1.0 < grid.y),",
							"\t\t\tfloat(bin0.x+1.0 < grid.x && bin0.y+1.0 < grid.y));",
							"\t\tvec3 brdf;",
							"$begin_generate rename_buffers",
							"\t\tvec3 color = mm_car_paint_linear($color_table(table_uv).rgb)*$color_table_scale;",
							"\t\tbrdf = ($diffuse/PI+specular)*color;",
							"\t\tvec3 flakes = flake_weights.x*mm_car_paint_flake($flakes(flake_uv00).rgb);",
							"\t\tflakes += flake_weights.y*mm_car_paint_flake($flakes(flake_uv10).rgb);",
							"\t\tflakes += flake_weights.z*mm_car_paint_flake($flakes(flake_uv01).rgb);",
							"\t\tflakes += flake_weights.w*mm_car_paint_flake($flakes(flake_uv11).rgb);",
							"\t\tbrdf += flakes*$flake_scale*$flake_intensity;",
							"$end_generate",
							"\t\t// Light crosses the clear coat twice",
							"\t\tfloat transmission = (1.0-mm_car_paint_fresnel(nl, ior))*(1.0-mm_car_paint_fresnel(nv, ior));",
							"\t\tSPECULAR_LIGHT += max(brdf, vec3(0.0))*transmission*radiance;",
							"\t\t// Highlight of the clear coat (smooth GGX)",
							"\t\tvec3 hc = normalize(LIGHT+VIEW);",
							"\t\tfloat a2 = 0.0004;",
							"\t\tfloat nhc = max(dot(N, hc), 0.0);",
							"\t\tfloat dc = a2/(PI*pow(nhc*nhc*(a2-1.0)+1.0, 2.0));",
							"\t\tSPECULAR_LIGHT += vec3(dc*0.25/(nl*nv)*mm_car_paint_fresnel(max(dot(VIEW, hc), 0.0), ior))*radiance;",
							"\t}",
							"}",
							""
						],
						"type": "template"
					},
					{
						"file_name": "$(path_prefix)_texture_$(buffer_index).png",
						"type": "buffers"
					}
				]
			}
		},
		"global": "",
		"inputs": [
			{
				"default": "vec3(1.0)",
				"label": "Color table",
				"longdesc": "BRDF color: theta H (0 to 90 degrees) along U, theta D along V, sRGB encoded, divided by the color table scale",
				"name": "color_table",
				"type": "rgb"
			},
			{
				"default": "vec3(0.5)",
				"label": "Flakes",
				"longdesc": "Flake atlas: one patch per (theta F column, theta I row) slice, encoded around 0.5",
				"name": "flakes",
				"type": "rgb"
			},
			{
				"default": "vec3(0.5)",
				"label": "Ambient",
				"longdesc": "Reflectance under uniform lighting, for view angles from 0 to 90 degrees along U, sRGB encoded, divided by the ambient scale",
				"name": "ambient",
				"type": "rgb"
			}
		],
		"instance": "",
		"longdesc": "Measured car paint (X-Rite AxF CarPaint2): a clear coat over a Lambert diffuse and 3 Cook-Torrance lobes tinted by an angular color table, with angle dependent flakes. Created by importing AxF car paints (python/axf2ptex.py, or the AxF import plugin). The 3D preview renders direct lights with the measured model, and the environment with its average reflectance and the clear coat.",
		"name": "Car Paint Material",
		"outputs": [],
		"parameters": [
			{
				"control": "None",
				"default": 0.1,
				"label": "Diffuse",
				"longdesc": "Albedo of the Lambert diffuse part (tinted by the color table)",
				"max": 1.0,
				"min": 0.0,
				"name": "diffuse",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Lobe 1 coefficient",
				"longdesc": "Weight of the Cook-Torrance lobe",
				"max": 1.0,
				"min": 0.0,
				"name": "coeff0",
				"step": 1e-05,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.2,
				"label": "Lobe 1 spread",
				"longdesc": "Roughness of the lobe (Beckmann slope)",
				"max": 1.0,
				"min": 0.001,
				"name": "spread0",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Lobe 1 F0",
				"longdesc": "Fresnel reflectance of the lobe at normal incidence",
				"max": 1.0,
				"min": 0.0,
				"name": "f0_0",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Lobe 2 coefficient",
				"longdesc": "Weight of the Cook-Torrance lobe",
				"max": 1.0,
				"min": 0.0,
				"name": "coeff1",
				"step": 1e-05,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.2,
				"label": "Lobe 2 spread",
				"longdesc": "Roughness of the lobe (Beckmann slope)",
				"max": 1.0,
				"min": 0.001,
				"name": "spread1",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Lobe 2 F0",
				"longdesc": "Fresnel reflectance of the lobe at normal incidence",
				"max": 1.0,
				"min": 0.0,
				"name": "f0_1",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.0,
				"label": "Lobe 3 coefficient",
				"longdesc": "Weight of the Cook-Torrance lobe",
				"max": 1.0,
				"min": 0.0,
				"name": "coeff2",
				"step": 1e-05,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.2,
				"label": "Lobe 3 spread",
				"longdesc": "Roughness of the lobe (Beckmann slope)",
				"max": 1.0,
				"min": 0.001,
				"name": "spread2",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.5,
				"label": "Lobe 3 F0",
				"longdesc": "Fresnel reflectance of the lobe at normal incidence",
				"max": 1.0,
				"min": 0.0,
				"name": "f0_2",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.5,
				"label": "Clear coat IOR",
				"longdesc": "Index of refraction of the clear coat",
				"max": 3.0,
				"min": 1.0,
				"name": "ior",
				"step": 0.01,
				"type": "float"
			},
			{
				"default": true,
				"label": "Refraction",
				"longdesc": "Light and view directions are refracted by the clear coat",
				"name": "refraction",
				"type": "boolean"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Color table scale",
				"longdesc": "The color table's values are multiplied by this scale",
				"max": 10.0,
				"min": 0.0,
				"name": "color_table_scale",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Ambient scale",
				"longdesc": "The ambient reflectance's values are multiplied by this scale",
				"max": 10.0,
				"min": 0.0,
				"name": "ambient_scale",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Flake scale",
				"longdesc": "Largest value of the flake BTF (its texture is encoded relatively to it)",
				"max": 50.0,
				"min": 0.0,
				"name": "flake_scale",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 1.0,
				"label": "Flake intensity",
				"longdesc": "Multiplies the flakes' sparkle",
				"max": 4.0,
				"min": 0.0,
				"name": "flake_intensity",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 4.0,
				"label": "Flake tiling",
				"longdesc": "Repetitions of the flake patches across the UV space",
				"max": 100.0,
				"min": 0.1,
				"name": "flake_tiling",
				"step": 0.1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 24,
				"label": "Theta F slices",
				"longdesc": "Number of flake BTF slices from 0 to 90 degrees of theta F",
				"max": 90,
				"min": 1,
				"name": "flake_theta_f_slices",
				"step": 1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 24,
				"label": "Theta I slices",
				"longdesc": "Number of flake BTF slices from 0 to 90 degrees of theta I",
				"max": 90,
				"min": 1,
				"name": "flake_theta_i_slices",
				"step": 1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 8,
				"label": "Theta F columns",
				"longdesc": "Columns of the flake atlas (theta F slices that have flakes)",
				"max": 90,
				"min": 0,
				"name": "flake_max_theta_f",
				"step": 1,
				"type": "float"
			},
			{
				"control": "None",
				"default": 12,
				"label": "Theta I rows",
				"longdesc": "Rows of the flake atlas (theta I slices that have flakes)",
				"max": 90,
				"min": 0,
				"name": "flake_max_theta_i",
				"step": 1,
				"type": "float"
			}
		],
		"preview_shader": [
			"shader_type spatial;",
			"render_mode blend_mix,cull_back,diffuse_burley,specular_schlick_ggx;",
			"",
			"uniform vec3 uv1_offset = vec3(0.0, 0.0, 0.0);",
			"uniform vec3 uv1_scale = vec3(1.0, 1.0, 1.0);",
			"uniform float variation = 0.0;",
			"",
			"varying float elapsed_time;",
			"varying vec2 mm_car_paint_uv;",
			"",
			"void vertex() {",
			"\telapsed_time = TIME;",
			"\tUV = UV*uv1_scale.xy+uv1_offset.xy;",
			"}",
			"",
			"// X-Rite CarPaint2: a clear coat over Lambert and Cook-Torrance lobes,",
			"// tinted by a color table indexed by the half vector angle (theta H) and",
			"// the light-half vector angle (theta D), and flakes (a BTF indexed by",
			"// theta F = theta H and theta I = theta D)",
			"vec3 mm_car_paint_linear(vec3 c) {",
			"\treturn mix(pow((c + vec3(0.055)) * (1.0 / (1.0 + 0.055)),vec3(2.4)),c * (1.0 / 12.92),lessThan(c,vec3(0.04045)));",
			"}",
			"",
			"float mm_car_paint_fresnel(float cos_i, float ior) {",
			"\tcos_i = clamp(cos_i, 0.0, 1.0);",
			"\tfloat cos_t = sqrt(max(1.0-(1.0-cos_i*cos_i)/(ior*ior), 0.0));",
			"\tfloat rs = (cos_i-ior*cos_t)/(cos_i+ior*cos_t);",
			"\tfloat rp = (ior*cos_i-cos_t)/(ior*cos_i+cos_t);",
			"\treturn 0.5*(rs*rs+rp*rp);",
			"}",
			"",
			"// Cook-Torrance lobe: Beckmann distribution (not normalized, as in the",
			"// AxF model) and Schlick's Fresnel",
			"float mm_car_paint_lobe(float nh, float vh, float coeff, float spread, float f0) {",
			"\tfloat c2 = nh*nh;",
			"\tfloat d = exp((c2-1.0)/(c2*spread*spread))/(spread*spread*c2*c2);",
			"\treturn coeff*d*(f0+(1.0-f0)*pow(1.0-vh, 5.0));",
			"}",
			"",
			"// Flake values are stored with square root companding around 0.5",
			"vec3 mm_car_paint_flake(vec3 e) {",
			"\tvec3 v = 2.0*(e-vec3(0.5));",
			"\treturn sign(v)*v*v;",
			"}",
			"",
			"$definitions",
			"",
			"void fragment() {",
			"\tfloat _seed_variation_ = variation;",
			"\tvec4 _controlled_variation_ = vec4(0.0);",
			"\tvec2 uv = fract(UV);",
			"\tmm_car_paint_uv = UV;",
			"\tfloat theta_v = acos(clamp(dot(NORMAL, VIEW), 0.0, 1.0));",
			"$begin_generate",
			"\t// Ambient light: reflectance under uniform lighting for this view angle",
			"\tALBEDO = mm_car_paint_linear($ambient(vec2(clamp(theta_v/(0.5*PI), 0.0, 1.0), 0.5)).rgb)*$ambient_scale;",
			"$end_generate",
			"\tMETALLIC = 0.0;",
			"\tSPECULAR = 0.0;",
			"\tROUGHNESS = 1.0;",
			"\t// The clear coat reflects the environment",
			"\tCLEARCOAT = 1.0;",
			"\tCLEARCOAT_ROUGHNESS = 0.0;",
			"}",
			"",
			"void light() {",
			"\tvec3 N = NORMAL;",
			"\tfloat nl = dot(N, LIGHT);",
			"\tfloat nv = dot(N, VIEW);",
			"\tif (nl > 0.001 && nv > 0.001) {",
			"\t\tvec3 radiance = LIGHT_COLOR*ATTENUATION*nl;",
			"\t\t// Parameters (input code is generated at the start of blocks, so",
			"\t\t// textures are sampled at coordinates computed before them)",
			"\t\tfloat ior;",
			"\t\tbool refraction;",
			"\t\tvec3 lobe0;",
			"\t\tvec3 lobe1;",
			"\t\tvec3 lobe2;",
			"\t\tvec4 flake_grid;",
			"\t\tfloat flake_tiling;",
			"$begin_generate",
			"\t\tior = $ior;",
			"\t\trefraction = $refraction;",
			"\t\tlobe0 = vec3($coeff0, $spread0, $f0_0);",
			"\t\tlobe1 = vec3($coeff1, $spread1, $f0_1);",
			"\t\tlobe2 = vec3($coeff2, $spread2, $f0_2);",
			"\t\tflake_grid = vec4($flake_theta_f_slices, $flake_theta_i_slices, max($flake_max_theta_f, 1.0), max($flake_max_theta_i, 1.0));",
			"\t\tflake_tiling = $flake_tiling;",
			"$end_generate",
			"\t\t// Light and view directions below the clear coat",
			"\t\tvec3 l2 = LIGHT;",
			"\t\tvec3 v2 = VIEW;",
			"\t\tif (refraction) {",
			"\t\t\tl2 = -refract(-LIGHT, N, 1.0/ior);",
			"\t\t\tv2 = -refract(-VIEW, N, 1.0/ior);",
			"\t\t}",
			"\t\tvec3 h = normalize(l2+v2);",
			"\t\tfloat nh = clamp(dot(N, h), 0.0001, 1.0);",
			"\t\tfloat vh = clamp(dot(v2, h), 0.0001, 1.0);",
			"\t\tfloat nl2 = clamp(dot(N, l2), 0.001, 1.0);",
			"\t\tfloat nv2 = clamp(dot(N, v2), 0.001, 1.0);",
			"\t\tfloat theta_h = acos(nh);",
			"\t\tfloat theta_d = acos(clamp(dot(l2, h), -1.0, 1.0));",
			"\t\tfloat g = min(1.0, min(2.0*nh*nv2/vh, 2.0*nh*nl2/vh));",
			"\t\tfloat specular = mm_car_paint_lobe(nh, vh, lobe0.x, lobe0.y, lobe0.z);",
			"\t\tspecular += mm_car_paint_lobe(nh, vh, lobe1.x, lobe1.y, lobe1.z);",
			"\t\tspecular += mm_car_paint_lobe(nh, vh, lobe2.x, lobe2.y, lobe2.z);",
			"\t\tspecular *= g/(PI*nl2*nv2);",
			"\t\tvec2 table_uv = clamp(vec2(theta_h, theta_d)/(0.5*PI), vec2(0.0), vec2(1.0))*(63.0/64.0)+vec2(0.5/64.0);",
			"\t\t// Flakes: bilinear interpolation of the 4 nearest angular slices",
			"\t\tvec2 bins = vec2(theta_h, theta_d)/(0.5*PI)*flake_grid.xy;",
			"\t\tvec2 bin0 = floor(bins);",
			"\t\tvec2 w = bins-bin0;",
			"\t\tvec2 grid = flake_grid.zw;",
			"\t\tvec2 cell_uv = clamp(fract(mm_car_paint_uv*flake_tiling), vec2(0.002), vec2(0.998));",
			"\t\tvec2 flake_uv00 = (bin0+cell_uv)/grid;",
			"\t\tvec2 flake_uv10 = (bin0+vec2(1.0, 0.0)+cell_uv)/grid;",
			"\t\tvec2 flake_uv01 = (bin0+vec2(0.0, 1.0)+cell_uv)/grid;",
			"\t\tvec2 flake_uv11 = (bin0+vec2(1.0)+cell_uv)/grid;",
			"\t\tvec4 flake_weights = vec4((1.0-w.x)*(1.0-w.y), w.x*(1.0-w.y), (1.0-w.x)*w.y, w.x*w.y);",
			"\t\tflake_weights *= vec4(",
			"\t\t\tfloat(bin0.x < grid.x && bin0.y < grid.y),",
			"\t\t\tfloat(bin0.x+1.0 < grid.x && bin0.y < grid.y),",
			"\t\t\tfloat(bin0.x < grid.x && bin0.y+1.0 < grid.y),",
			"\t\t\tfloat(bin0.x+1.0 < grid.x && bin0.y+1.0 < grid.y));",
			"\t\tvec3 brdf;",
			"$begin_generate",
			"\t\tvec3 color = mm_car_paint_linear($color_table(table_uv).rgb)*$color_table_scale;",
			"\t\tbrdf = ($diffuse/PI+specular)*color;",
			"\t\tvec3 flakes = flake_weights.x*mm_car_paint_flake($flakes(flake_uv00).rgb);",
			"\t\tflakes += flake_weights.y*mm_car_paint_flake($flakes(flake_uv10).rgb);",
			"\t\tflakes += flake_weights.z*mm_car_paint_flake($flakes(flake_uv01).rgb);",
			"\t\tflakes += flake_weights.w*mm_car_paint_flake($flakes(flake_uv11).rgb);",
			"\t\tbrdf += flakes*$flake_scale*$flake_intensity;",
			"$end_generate",
			"\t\t// Light crosses the clear coat twice",
			"\t\tfloat transmission = (1.0-mm_car_paint_fresnel(nl, ior))*(1.0-mm_car_paint_fresnel(nv, ior));",
			"\t\tSPECULAR_LIGHT += max(brdf, vec3(0.0))*transmission*radiance;",
			"\t\t// Highlight of the clear coat (smooth GGX)",
			"\t\tvec3 hc = normalize(LIGHT+VIEW);",
			"\t\tfloat a2 = 0.0004;",
			"\t\tfloat nhc = max(dot(N, hc), 0.0);",
			"\t\tfloat dc = a2/(PI*pow(nhc*nhc*(a2-1.0)+1.0, 2.0));",
			"\t\tSPECULAR_LIGHT += vec3(dc*0.25/(nl*nv)*mm_car_paint_fresnel(max(dot(VIEW, hc), 0.0), ior))*radiance;",
			"\t}",
			"}",
			""
		],
		"shortdesc": "Car Paint Material"
	},
	"type": "material_export"
}
