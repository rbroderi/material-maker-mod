{
	"export_extension": "tres",
	"files": [
		{
			"file_name": "$(path_prefix).tres",
			"prompt_overwrite": true,
			"template": [
				"[gd_resource type=\"ShaderMaterial\" format=3]",
				"",
				"[ext_resource type=\"Shader\" path=\"$(file_prefix).gdshader\" id=\"1\"]",
				"$begin_buffers",
				"[ext_resource type=\"Texture2D\" path=\"$(file_prefix)_texture_$(buffer_index).png\" id=\"$(expr:$(buffer_index)+1)\"]",
				"$end_buffers",
				"",
				"[resource]",
				"shader = ExtResource(\"1\")",
				"$begin_buffers",
				"shader_parameter/texture_$(buffer_index) = ExtResource(\"$(expr:$(buffer_index)+1)\")",
				"$end_buffers",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix).gdshader",
			"prompt_overwrite": false,
			"template": [
				"shader_type spatial;",
				"render_mode blend_mix,cull_back,diffuse_burley,specular_schlick_ggx",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				",depth_prepass_alpha",
				"$fi",
				";",
				"",
				"// Procedural material generated by Material Maker: the graph is computed in",
				"// this shader (buffers, if any, are textures)",
				"",
				"uniform vec3 uv1_scale = vec3(1.0, 1.0, 1.0);",
				"uniform vec3 uv1_offset = vec3(0.0, 0.0, 0.0);",
				"uniform int depth_min_layers = 8;",
				"uniform int depth_max_layers = 32;",
				"uniform vec2 depth_flip = vec2(1.0);",
				"varying float elapsed_time;",
				"",
				"$definitions array_uniform_to_const,rename_buffers",
				"",
				"void vertex() {",
				"\telapsed_time = TIME;",
				"\tUV = UV*uv1_scale.xy+uv1_offset.xy;",
				"}",
				"",
				"void fragment() {",
				"\tfloat _seed_variation_ = 0.0;",
				"\tvec4 _controlled_variation_ = vec4(0.0);",
				"\tvec2 uv = fract(UV);",
				"$if $(connected:depth_tex)",
				"\t{",
				"$begin_generate rename_buffers",
				"\t\tfloat depth_scale = 0.2*$depth_scale;",
				"$end_generate",
				"\t\tvec3 view_dir = normalize(VIEW*mat3(TANGENT*depth_flip.x,-BINORMAL*depth_flip.y,NORMAL));",
				"\t\tfloat num_layers = mix(float(depth_max_layers),float(depth_min_layers), abs(dot(vec3(0.0, 0.0, 1.0), view_dir)));",
				"\t\tfloat layer_depth = 1.0 / num_layers;",
				"\t\tvec2 P = view_dir.xy * depth_scale;",
				"\t\tvec2 delta = P / num_layers / dot(VIEW, NORMAL);",
				"\t\tvec2 ofs = uv;",
				"\t\t// Each generated block declares variables, so it has its own scope",
				"\t\tfloat depth;",
				"\t\t{",
				"$begin_generate rename_buffers",
				"\t\t\tdepth = $depth_tex(ofs);",
				"$end_generate",
				"\t\t}",
				"\t\tfloat current_depth = 0.0;",
				"\t\twhile (current_depth < depth) {",
				"\t\t\tofs -= delta;",
				"$begin_generate rename_buffers",
				"\t\t\tdepth = $depth_tex(ofs);",
				"$end_generate",
				"\t\t\tcurrent_depth += layer_depth;",
				"\t\t}",
				"\t\tvec2 prev_ofs = ofs + delta;",
				"\t\tfloat after_depth = depth - current_depth;",
				"\t\tfloat before_depth;",
				"\t\t{",
				"$begin_generate rename_buffers",
				"\t\t\tbefore_depth = $depth_tex(prev_ofs) - current_depth + layer_depth;",
				"$end_generate",
				"\t\t}",
				"\t\tfloat weight = after_depth / (after_depth - before_depth);",
				"\t\tuv = mix(ofs, prev_ofs, weight);",
				"\t}",
				"$fi",
				"$begin_generate rename_buffers",
				"\tvec3 albedo_tex = $albedo_tex(uv);",
				"\talbedo_tex = mix(pow((albedo_tex+vec3(0.055))/1.055, vec3(2.4)), albedo_tex/12.92, lessThan(albedo_tex, vec3(0.04045)));",
				"\tALBEDO = albedo_tex*$albedo_color.rgb;",
				"$if $(connected:metallic_tex)",
				"\tMETALLIC = $metallic*$metallic_tex(uv);",
				"$else",
				"\tMETALLIC = $metallic;",
				"$fi",
				"\tROUGHNESS = $roughness*$roughness_tex(uv);",
				"\tSPECULAR = 0.5;",
				"\tNORMAL_MAP = $normal_tex(uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0);",
				"\tNORMAL_MAP_DEPTH = $normal;",
				"\tvec3 emission_tex = $emission_tex(uv);",
				"\tEMISSION = mix(pow((emission_tex+vec3(0.055))/1.055, vec3(2.4)), emission_tex/12.92, lessThan(emission_tex, vec3(0.04045)))*$emission_energy;",
				"\tAO = $ao_tex(uv);",
				"\tAO_LIGHT_AFFECT = $ao;",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"\tALPHA = $opacity_tex(uv);",
				"$fi",
				"$if $(connected:sss_tex)",
				"\tSSS_STRENGTH = $sss*$sss_tex(uv);",
				"$fi",
				"$if $(param:coat) > 0.0",
				"\tCLEARCOAT = $coat*$coat_tex(uv);",
				"\tCLEARCOAT_ROUGHNESS = $coat_roughness*$coat_roughness_tex(uv);",
				"$fi",
				"$if $(param:anisotropy) > 0.0",
				"\tANISOTROPY = $anisotropy*$anisotropy_tex(uv);",
				"$fi",
				"$if $(param:sheen) > 0.0",
				"\tRIM = $sheen*$sheen_tex(uv);",
				"\tRIM_TINT = 0.5;",
				"$fi",
				"$if $(param:transmission) > 0.0",
				"\tBACKLIGHT = vec3($transmission*$transmission_tex(uv));",
				"$fi",
				"$end_generate",
				"}",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).png",
			"type": "buffers"
		}
	],
	"material": "material",
	"name": "Godot/Godot 4 Shader"
}
