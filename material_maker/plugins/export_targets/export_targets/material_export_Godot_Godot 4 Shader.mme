{
	"export_extension": "tres",
	"files": [
		{
			"file_name": "$(path_prefix).tres",
			"prompt_overwrite": true,
			"template": "[gd_resource type=\"ShaderMaterial\" format=3]\n\n[ext_resource type=\"Shader\" path=\"$(file_prefix).gdshader\" id=\"1\"]\n$begin_buffers\n[ext_resource type=\"Texture2D\" path=\"$(file_prefix)_texture_$(buffer_index).png\" id=\"$(expr:$(buffer_index)+1)\"]\n$end_buffers\n\n[resource]\nshader = ExtResource(\"1\")\n$begin_buffers\nshader_parameter/texture_$(buffer_index) = ExtResource(\"$(expr:$(buffer_index)+1)\")\n$end_buffers\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix).gdshader",
			"prompt_overwrite": false,
			"template": "shader_type spatial;\nrender_mode blend_mix,cull_back,diffuse_burley,specular_schlick_ggx\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n,depth_prepass_alpha\n$fi\n;\n\n// Procedural material generated by Material Maker: the graph is computed in\n// this shader (buffers, if any, are textures)\n\nuniform vec3 uv1_scale = vec3(1.0, 1.0, 1.0);\nuniform vec3 uv1_offset = vec3(0.0, 0.0, 0.0);\nuniform int depth_min_layers = 8;\nuniform int depth_max_layers = 32;\nuniform vec2 depth_flip = vec2(1.0);\nvarying float elapsed_time;\n\n$definitions array_uniform_to_const,rename_buffers\n\nvoid vertex() {\n\telapsed_time = TIME;\n\tUV = UV*uv1_scale.xy+uv1_offset.xy;\n}\n\nvoid fragment() {\n\tfloat _seed_variation_ = 0.0;\n\tvec4 _controlled_variation_ = vec4(0.0);\n\tvec2 uv = fract(UV);\n$if $(connected:depth_tex)\n\t{\n$begin_generate rename_buffers\n\t\tfloat depth_scale = 0.2*$depth_scale;\n$end_generate\n\t\tvec3 view_dir = normalize(VIEW*mat3(TANGENT*depth_flip.x,-BINORMAL*depth_flip.y,NORMAL));\n\t\tfloat num_layers = mix(float(depth_max_layers),float(depth_min_layers), abs(dot(vec3(0.0, 0.0, 1.0), view_dir)));\n\t\tfloat layer_depth = 1.0 / num_layers;\n\t\tvec2 P = view_dir.xy * depth_scale;\n\t\tvec2 delta = P / num_layers / dot(VIEW, NORMAL);\n\t\tvec2 ofs = uv;\n\t\t// Each generated block declares variables, so it has its own scope\n\t\tfloat depth;\n\t\t{\n$begin_generate rename_buffers\n\t\t\tdepth = $depth_tex(ofs);\n$end_generate\n\t\t}\n\t\tfloat current_depth = 0.0;\n\t\twhile (current_depth < depth) {\n\t\t\tofs -= delta;\n$begin_generate rename_buffers\n\t\t\tdepth = $depth_tex(ofs);\n$end_generate\n\t\t\tcurrent_depth += layer_depth;\n\t\t}\n\t\tvec2 prev_ofs = ofs + delta;\n\t\tfloat after_depth = depth - current_depth;\n\t\tfloat before_depth;\n\t\t{\n$begin_generate rename_buffers\n\t\t\tbefore_depth = $depth_tex(prev_ofs) - current_depth + layer_depth;\n$end_generate\n\t\t}\n\t\tfloat weight = after_depth / (after_depth - before_depth);\n\t\tuv = mix(ofs, prev_ofs, weight);\n\t}\n$fi\n$begin_generate rename_buffers\n\tvec3 albedo_tex = $albedo_tex(uv);\n\talbedo_tex = mix(pow((albedo_tex+vec3(0.055))/1.055, vec3(2.4)), albedo_tex/12.92, lessThan(albedo_tex, vec3(0.04045)));\n\tALBEDO = albedo_tex*$albedo_color.rgb;\n$if $(connected:metallic_tex)\n\tMETALLIC = $metallic*$metallic_tex(uv);\n$else\n\tMETALLIC = $metallic;\n$fi\n\tROUGHNESS = $roughness*$roughness_tex(uv);\n\tSPECULAR = 0.5;\n\tNORMAL_MAP = $normal_tex(uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0);\n\tNORMAL_MAP_DEPTH = $normal;\n\tvec3 emission_tex = $emission_tex(uv);\n\tEMISSION = mix(pow((emission_tex+vec3(0.055))/1.055, vec3(2.4)), emission_tex/12.92, lessThan(emission_tex, vec3(0.04045)))*$emission_energy;\n\tAO = $ao_tex(uv);\n\tAO_LIGHT_AFFECT = $ao;\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n\tALPHA = $opacity_tex(uv);\n$fi\n$if $(connected:sss_tex)\n\tSSS_STRENGTH = $sss*$sss_tex(uv);\n$fi\n$if $(connected:coat_tex) or $(connected:coat_roughness_tex)\n\tCLEARCOAT = $coat*$coat_tex(uv);\n\tCLEARCOAT_ROUGHNESS = $coat_roughness*$coat_roughness_tex(uv);\n$fi\n$if $(connected:anisotropy_tex)\n\tANISOTROPY = $anisotropy*$anisotropy_tex(uv);\n$fi\n$if $(connected:sheen_tex)\n\tRIM = $sheen*$sheen_tex(uv);\n\tRIM_TINT = 0.5;\n$fi\n$if $(connected:transmission_tex)\n\tBACKLIGHT = vec3($transmission*$transmission_tex(uv));\n$fi\n$end_generate\n}\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).png",
			"type": "buffers"
		}
	],
	"material": "material",
	"name": "Godot/Godot 4 Shader"
}
