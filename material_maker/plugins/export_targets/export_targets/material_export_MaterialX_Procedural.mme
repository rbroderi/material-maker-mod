{
	"export_extension": "mtlx",
	"files": [
		{
			"file_name": "$(path_prefix).mtlx",
			"template": [
				"<?xml version=\"1.0\"?>",
				"<!-- Procedural material generated by Material Maker: the graph is a custom node",
				"     whose GLSL implementation ($(file_prefix).glsl) is next to this file (add",
				"     this directory to the search path of MaterialX's GLSL shader generator).",
				"     Textures the graph reads (iterate buffers, images...) are inputs of the node",
				"     ($(file_prefix)_texture_*.exr). Other shading languages (OSL, MDL...) use its",
				"     node graph implementation, that reads textures baked from the graph",
				"     ($(file_prefix)_baked_*.png). -->",
				"<materialx version=\"1.39\">",
				"  <nodedef name=\"ND_mm_procedural\" node=\"mm_procedural\">",
				"    <input name=\"texcoord\" type=\"vector2\" defaultgeomprop=\"UV0\" />",
				"$begin_buffers",
				"    <input name=\"mm_texture_$(buffer_index)\" type=\"filename\" value=\"$(file_prefix)_texture_$(buffer_index).exr\" />",
				"$end_buffers",
				"    <output name=\"base_color\" type=\"color3\" />",
				"    <output name=\"metallic\" type=\"float\" />",
				"    <output name=\"roughness\" type=\"float\" />",
				"    <output name=\"normal\" type=\"vector3\" />",
				"    <output name=\"emission\" type=\"color3\" />",
				"    <output name=\"opacity\" type=\"float\" />",
				"  </nodedef>",
				"  <implementation name=\"IM_mm_procedural_genglsl\" nodedef=\"ND_mm_procedural\" target=\"genglsl\" file=\"$(file_prefix).glsl\" function=\"mm_procedural\" />",
				"  <nodegraph name=\"NG_mm_procedural\" nodedef=\"ND_mm_procedural\">",
				"    <image name=\"base_color_image\" type=\"color3\">",
				"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_base_color.png\" colorspace=\"srgb_texture\" />",
				"      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />",
				"    </image>",
				"    <multiply name=\"base_color_tint\" type=\"color3\">",
				"      <input name=\"in1\" type=\"color3\" nodename=\"base_color_image\" />",
				"      <input name=\"in2\" type=\"color3\" value=\"$(param:albedo_color.r), $(param:albedo_color.g), $(param:albedo_color.b)\" />",
				"    </multiply>",
				"    <image name=\"metallic_image\" type=\"float\">",
				"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_metallic.png\" colorspace=\"raw\" />",
				"      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />",
				"    </image>",
				"    <image name=\"roughness_image\" type=\"float\">",
				"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_roughness.png\" colorspace=\"raw\" />",
				"      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />",
				"    </image>",
				"    <image name=\"normal_image\" type=\"vector3\">",
				"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_normal.png\" />",
				"      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />",
				"    </image>",
				"    <image name=\"emission_image\" type=\"color3\">",
				"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_emission.png\" colorspace=\"srgb_texture\" />",
				"      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />",
				"    </image>",
				"    <multiply name=\"emission_energy\" type=\"color3\">",
				"      <input name=\"in1\" type=\"color3\" nodename=\"emission_image\" />",
				"      <input name=\"in2\" type=\"float\" value=\"$(param:emission_energy)\" />",
				"    </multiply>",
				"    <image name=\"opacity_image\" type=\"float\">",
				"      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_opacity.png\" colorspace=\"raw\" />",
				"      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />",
				"    </image>",
				"    <output name=\"base_color\" type=\"color3\" nodename=\"base_color_tint\" />",
				"    <output name=\"metallic\" type=\"float\" nodename=\"metallic_image\" />",
				"    <output name=\"roughness\" type=\"float\" nodename=\"roughness_image\" />",
				"    <output name=\"normal\" type=\"vector3\" nodename=\"normal_image\" />",
				"    <output name=\"emission\" type=\"color3\" nodename=\"emission_energy\" />",
				"    <output name=\"opacity\" type=\"float\" nodename=\"opacity_image\" />",
				"  </nodegraph>",
				"  <nodegraph name=\"NG_material\">",
				"    <mm_procedural name=\"procedural\" type=\"multioutput\" />",
				"    <normalmap name=\"normalmap\" type=\"vector3\">",
				"      <input name=\"in\" type=\"vector3\" nodename=\"procedural\" output=\"normal\" />",
				"      <input name=\"scale\" type=\"float\" value=\"$(param:normal)\" />",
				"    </normalmap>",
				"    <output name=\"base_color_output\" type=\"color3\" nodename=\"procedural\" output=\"base_color\" />",
				"    <output name=\"metallic_output\" type=\"float\" nodename=\"procedural\" output=\"metallic\" />",
				"    <output name=\"roughness_output\" type=\"float\" nodename=\"procedural\" output=\"roughness\" />",
				"    <output name=\"normal_output\" type=\"vector3\" nodename=\"normalmap\" />",
				"    <output name=\"emission_output\" type=\"color3\" nodename=\"procedural\" output=\"emission\" />",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"    <convert name=\"opacity\" type=\"color3\">",
				"      <input name=\"in\" type=\"float\" nodename=\"procedural\" output=\"opacity\" />",
				"    </convert>",
				"    <output name=\"opacity_output\" type=\"color3\" nodename=\"opacity\" />",
				"$fi",
				"  </nodegraph>",
				"  <standard_surface name=\"SR_$(file_prefix)\" type=\"surfaceshader\">",
				"    <input name=\"base_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"base_color_output\" />",
				"    <input name=\"metalness\" type=\"float\" nodegraph=\"NG_material\" output=\"metallic_output\" />",
				"    <input name=\"specular_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"roughness_output\" />",
				"    <input name=\"normal\" type=\"vector3\" nodegraph=\"NG_material\" output=\"normal_output\" />",
				"    <input name=\"emission\" type=\"float\" value=\"1.0\" />",
				"    <input name=\"emission_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"emission_output\" />",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"    <input name=\"opacity\" type=\"color3\" nodegraph=\"NG_material\" output=\"opacity_output\" />",
				"$fi",
				"  </standard_surface>",
				"  <surfacematerial name=\"$(file_prefix)\" type=\"material\">",
				"    <input name=\"surfaceshader\" type=\"surfaceshader\" nodename=\"SR_$(file_prefix)\" />",
				"  </surfacematerial>",
				"</materialx>",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix).glsl",
			"template": [
				"// Procedural material generated by Material Maker: implementation of the",
				"// mm_procedural MaterialX node (genglsl)",
				"$inline_buffers",
				"// Textures (iterate buffers, images...) are the node's filename inputs, that",
				"// MaterialX declares as uniforms named after the node (procedural)",
				"$begin_buffers",
				"#define $(buffer_name) procedural_mm_texture_$(buffer_index)",
				"$end_buffers",
				"float elapsed_time = 0.0;",
				"$definitions uniform_to_global",
				"",
				"void mm_procedural(vec2 texcoord,",
				"$begin_buffers",
				"\tsampler2D mm_texture_$(buffer_index),",
				"$end_buffers",
				"\tout vec3 base_color, out float metallic, out float roughness, out vec3 normal, out vec3 emission, out float opacity)",
				"{",
				"\tfloat _seed_variation_ = 0.0;",
				"\tvec4 _controlled_variation_ = vec4(0.0);",
				"\t// MaterialX's texture coordinates start at the bottom left of images",
				"\tvec2 uv = fract(vec2(texcoord.x, 1.0-texcoord.y));",
				"$begin_generate",
				"\tvec3 albedo_tex = $albedo_tex(uv);",
				"\tbase_color = mix(pow((albedo_tex+vec3(0.055))/1.055, vec3(2.4)), albedo_tex/12.92, lessThan(albedo_tex, vec3(0.04045)))*$albedo_color.rgb;",
				"$if $(connected:metallic_tex)",
				"\tmetallic = $metallic*$metallic_tex(uv);",
				"$else",
				"\tmetallic = $metallic;",
				"$fi",
				"\troughness = $roughness*$roughness_tex(uv);",
				"$if $(connected:normal_tex)",
				"\tnormal = $normal_tex(uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0);",
				"$else",
				"\tnormal = vec3(0.5, 0.5, 1.0);",
				"$fi",
				"\tvec3 emission_tex = $emission_tex(uv);",
				"\temission = mix(pow((emission_tex+vec3(0.055))/1.055, vec3(2.4)), emission_tex/12.92, lessThan(emission_tex, vec3(0.04045)))*$emission_energy;",
				"\topacity = $opacity_tex(uv);",
				"$end_generate",
				"}",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr",
			"type": "buffers"
		},
		{
			"expression": "rgb=$albedo_tex($uv)",
			"file_name": "$(path_prefix)_baked_base_color.png",
			"type": "texture"
		},
		{
			"expression": "f=$metallic*$metallic_tex($uv)",
			"file_name": "$(path_prefix)_baked_metallic.png",
			"type": "texture"
		},
		{
			"expression": "f=$roughness*$roughness_tex($uv)",
			"file_name": "$(path_prefix)_baked_roughness.png",
			"type": "texture"
		},
		{
			"conditions": "$(connected:normal_tex)",
			"expression": "rgb=$normal_tex($uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0)",
			"file_name": "$(path_prefix)_baked_normal.png",
			"type": "texture"
		},
		{
			"conditions": "not $(connected:normal_tex)",
			"expression": "rgb=vec3(0.5, 0.5, 1.0)",
			"file_name": "$(path_prefix)_baked_normal.png",
			"type": "texture"
		},
		{
			"expression": "rgb=$emission_tex($uv)",
			"file_name": "$(path_prefix)_baked_emission.png",
			"type": "texture"
		},
		{
			"expression": "f=$opacity_tex($uv)",
			"file_name": "$(path_prefix)_baked_opacity.png",
			"type": "texture"
		}
	],
	"material": "material",
	"name": "MaterialX/Procedural"
}
