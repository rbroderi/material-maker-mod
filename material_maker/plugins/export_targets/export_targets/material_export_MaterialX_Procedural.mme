{
	"export_extension": "mtlx",
	"files": [
		{
			"file_name": "$(path_prefix).mtlx",
			"template": "<?xml version=\"1.0\"?>\n<!-- Procedural material generated by Material Maker: the graph is a custom node\n     whose GLSL implementation ($(file_prefix).glsl) is next to this file (add\n     this directory to the search path of MaterialX's GLSL shader generator).\n     Other shading languages (OSL, MDL...) use its nodegraph implementation,\n     that reads the textures baked from the graph ($(file_prefix)_baked_*.png). -->\n<materialx version=\"1.39\">\n  <nodedef name=\"ND_mm_procedural\" node=\"mm_procedural\">\n    <input name=\"texcoord\" type=\"vector2\" defaultgeomprop=\"UV0\" />\n$begin_buffers\n    <input name=\"mm_texture_$(buffer_index)\" type=\"filename\" value=\"$(file_prefix)_texture_$(buffer_index).exr\" />\n$end_buffers\n    <output name=\"base_color\" type=\"color3\" />\n    <output name=\"metallic\" type=\"float\" />\n    <output name=\"roughness\" type=\"float\" />\n    <output name=\"normal\" type=\"vector3\" />\n    <output name=\"emission\" type=\"color3\" />\n    <output name=\"opacity\" type=\"float\" />\n  </nodedef>\n  <implementation name=\"IM_mm_procedural_genglsl\" nodedef=\"ND_mm_procedural\" target=\"genglsl\" file=\"$(file_prefix).glsl\" function=\"mm_procedural\" />\n  <nodegraph name=\"NG_mm_procedural\" nodedef=\"ND_mm_procedural\">\n    <tiledimage name=\"base_color_image\" type=\"color3\">\n      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_base_color.png\" colorspace=\"srgb_texture\" />\n      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />\n    </tiledimage>\n    <tiledimage name=\"metallic_image\" type=\"float\">\n      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_metallic.png\" />\n      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />\n    </tiledimage>\n    <tiledimage name=\"roughness_image\" type=\"float\">\n      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_roughness.png\" />\n      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />\n    </tiledimage>\n    <tiledimage name=\"normal_image\" type=\"vector3\">\n      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_normal.png\" />\n      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />\n    </tiledimage>\n    <tiledimage name=\"emission_image\" type=\"color3\">\n      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_emission.png\" colorspace=\"srgb_texture\" />\n      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />\n    </tiledimage>\n    <multiply name=\"emission_energy\" type=\"color3\">\n      <input name=\"in1\" type=\"color3\" nodename=\"emission_image\" />\n      <input name=\"in2\" type=\"float\" value=\"$(param:emission_energy)\" />\n    </multiply>\n    <tiledimage name=\"opacity_image\" type=\"float\">\n      <input name=\"file\" type=\"filename\" value=\"$(file_prefix)_baked_opacity.png\" />\n      <input name=\"texcoord\" type=\"vector2\" interfacename=\"texcoord\" />\n    </tiledimage>\n    <output name=\"base_color\" type=\"color3\" nodename=\"base_color_image\" />\n    <output name=\"metallic\" type=\"float\" nodename=\"metallic_image\" />\n    <output name=\"roughness\" type=\"float\" nodename=\"roughness_image\" />\n    <output name=\"normal\" type=\"vector3\" nodename=\"normal_image\" />\n    <output name=\"emission\" type=\"color3\" nodename=\"emission_energy\" />\n    <output name=\"opacity\" type=\"float\" nodename=\"opacity_image\" />\n  </nodegraph>\n  <nodegraph name=\"NG_material\">\n    <mm_procedural name=\"procedural\" type=\"multioutput\" />\n    <normalmap name=\"normalmap\" type=\"vector3\">\n      <input name=\"in\" type=\"vector3\" nodename=\"procedural\" output=\"normal\" />\n      <input name=\"scale\" type=\"float\" value=\"$(param:normal)\" />\n    </normalmap>\n    <output name=\"base_color_output\" type=\"color3\" nodename=\"procedural\" output=\"base_color\" />\n    <output name=\"metallic_output\" type=\"float\" nodename=\"procedural\" output=\"metallic\" />\n    <output name=\"roughness_output\" type=\"float\" nodename=\"procedural\" output=\"roughness\" />\n    <output name=\"normal_output\" type=\"vector3\" nodename=\"normalmap\" />\n    <output name=\"emission_output\" type=\"color3\" nodename=\"procedural\" output=\"emission\" />\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n    <convert name=\"opacity\" type=\"color3\">\n      <input name=\"in\" type=\"float\" nodename=\"procedural\" output=\"opacity\" />\n    </convert>\n    <output name=\"opacity_output\" type=\"color3\" nodename=\"opacity\" />\n$fi\n  </nodegraph>\n  <standard_surface name=\"SR_$(file_prefix)\" type=\"surfaceshader\">\n    <input name=\"base_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"base_color_output\" />\n    <input name=\"metalness\" type=\"float\" nodegraph=\"NG_material\" output=\"metallic_output\" />\n    <input name=\"specular_roughness\" type=\"float\" nodegraph=\"NG_material\" output=\"roughness_output\" />\n    <input name=\"normal\" type=\"vector3\" nodegraph=\"NG_material\" output=\"normal_output\" />\n    <input name=\"emission\" type=\"float\" value=\"1.0\" />\n    <input name=\"emission_color\" type=\"color3\" nodegraph=\"NG_material\" output=\"emission_output\" />\n$if $(connected:opacity_tex) and $(param:flags_transparent)\n    <input name=\"opacity\" type=\"color3\" nodegraph=\"NG_material\" output=\"opacity_output\" />\n$fi\n  </standard_surface>\n  <surfacematerial name=\"$(file_prefix)\" type=\"material\">\n    <input name=\"surfaceshader\" type=\"surfaceshader\" nodename=\"SR_$(file_prefix)\" />\n  </surfacematerial>\n</materialx>\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix).glsl",
			"template": "// Procedural material generated by Material Maker: implementation of the\n// mm_procedural MaterialX node (genglsl)\n$inline_buffers\n// Textures (iterate buffers, images...) are the node's filename inputs,\n// declared by MaterialX as uniforms named after the node (procedural)\n$begin_buffers\n#define $(buffer_name) procedural_mm_texture_$(buffer_index)\n$end_buffers\nfloat elapsed_time = 0.0;\n$definitions uniform_to_global\n\nvoid mm_procedural(vec2 texcoord,\n$begin_buffers\n\tsampler2D mm_texture_$(buffer_index),\n$end_buffers\n\tout vec3 base_color, out float metallic, out float roughness, out vec3 normal, out vec3 emission, out float opacity)\n{\n\tfloat _seed_variation_ = 0.0;\n\tvec4 _controlled_variation_ = vec4(0.0);\n\t// MaterialX's texture coordinates start at the bottom left of images\n\tvec2 uv = fract(vec2(texcoord.x, 1.0-texcoord.y));\n$begin_generate\n\tvec3 albedo_tex = $albedo_tex(uv);\n\tbase_color = mix(pow((albedo_tex+vec3(0.055))/1.055, vec3(2.4)), albedo_tex/12.92, lessThan(albedo_tex, vec3(0.04045)))*$albedo_color.rgb;\n$if $(connected:metallic_tex)\n\tmetallic = $metallic*$metallic_tex(uv);\n$else\n\tmetallic = $metallic;\n$fi\n\troughness = $roughness*$roughness_tex(uv);\n$if $(connected:normal_tex)\n\tnormal = $normal_tex(uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0);\n$else\n\t// Without a normal map, a flat normal (the Material node's default would\n\t// be a null normal for MaterialX's normalmap node)\n\tnormal = vec3(0.5, 0.5, 1.0);\n$fi\n\tvec3 emission_tex = $emission_tex(uv);\n\temission = mix(pow((emission_tex+vec3(0.055))/1.055, vec3(2.4)), emission_tex/12.92, lessThan(emission_tex, vec3(0.04045)))*$emission_energy;\n\topacity = $opacity_tex(uv);\n$end_generate\n}\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr",
			"type": "buffers"
		},
		{
			"expression": "rgb=$albedo_tex($uv)*$albedo_color.rgb",
			"file_name": "$(path_prefix)_baked_base_color.png",
			"options": {
				"srgb": true
			},
			"type": "texture"
		},
		{
			"conditions": "$(connected:metallic_tex)",
			"expression": "f=$metallic*$metallic_tex($uv)",
			"file_name": "$(path_prefix)_baked_metallic.png",
			"type": "texture"
		},
		{
			"conditions": "not $(connected:metallic_tex)",
			"expression": "f=$metallic_tex($uv)",
			"file_name": "$(path_prefix)_baked_metallic.png",
			"type": "texture"
		},
		{
			"expression": "f=$roughness*$roughness_tex($uv)",
			"file_name": "$(path_prefix)_baked_roughness.png",
			"type": "texture"
		},
		{
			"conditions": "$(connected:normal_tex)",
			"expression": "rgb=$normal_tex($uv)*vec3(-1.0, 1.0, -1.0)+vec3(1.0, 0.0, 1.0)",
			"file_name": "$(path_prefix)_baked_normal.png",
			"type": "texture"
		},
		{
			"conditions": "not $(connected:normal_tex)",
			"expression": "rgb=vec3(0.5, 0.5, 1.0)",
			"file_name": "$(path_prefix)_baked_normal.png",
			"type": "texture"
		},
		{
			"expression": "rgb=$emission_tex($uv)",
			"file_name": "$(path_prefix)_baked_emission.png",
			"options": {
				"srgb": true
			},
			"type": "texture"
		},
		{
			"expression": "f=$opacity_tex($uv)",
			"file_name": "$(path_prefix)_baked_opacity.png",
			"type": "texture"
		}
	],
	"material": "material",
	"name": "MaterialX/Procedural"
}
