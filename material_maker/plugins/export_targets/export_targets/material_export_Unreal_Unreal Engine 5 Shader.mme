{
	"export_extension": "py",
	"files": [
		{
			"file_name": "$(path_prefix).py",
			"prompt_overwrite": false,
			"template": [
				"import unreal",
				"import sys",
				"sys.path.append('$(material_maker_path)$(path_separator)export')",
				"import mm",
				"from importlib import reload",
				"reload(mm)",
				"# Procedural material generated by Material Maker: the graph is computed in a",
				"# Custom node (buffers, if any, are EXR textures)",
				"mat = mm.Material('$(file_prefix)', True)",
				"mat.clear()",
				"Custom_0 = mat.add_node('Custom', -264, 80)",
				"Custom_0.set_editor_property('code', mm.read_text_file('$(path_prefix).shader'))",
				"Custom_0.set_editor_property('output_type', unreal.CustomMaterialOutputType.CMOT_FLOAT4)",
				"Custom_0.set_editor_property('additional_outputs', [ mm.custom_output('metallic', 1), mm.custom_output('roughness', 1), mm.custom_output('normal', 3), mm.custom_output('emission', 3), mm.custom_output('occlusion', 1), mm.custom_output('opacity', 1)])",
				"inputs = [mm.custom_input('TexCoords'), mm.custom_input('Time')]",
				"$begin_buffers",
				"inputs.append(mm.custom_input('texture_$(buffer_index)'))",
				"$end_buffers",
				"Custom_0.set_editor_property('inputs', inputs)",
				"TextureCoordinate_0 = mat.add_node('TextureCoordinate', -472, 80)",
				"Time_0 = mat.add_node('Time', -456, 180)",
				"$begin_buffers",
				"Texture_$(buffer_index) = mat.add_node('TextureObject', -456, $(expr:110+170*$(buffer_index)))",
				"Texture_$(buffer_index)_asset = mm.import_texture('$(path_prefix)_texture_$(buffer_index).exr', '/Game/Textures')",
				"Texture_$(buffer_index)_asset.set_editor_property('srgb', False)",
				"Texture_$(buffer_index)_asset.set_editor_property('compression_settings', unreal.TextureCompressionSettings.TC_HDR)",
				"Texture_$(buffer_index)_asset.set_editor_property('mip_gen_settings', unreal.TextureMipGenSettings.TMGS_NO_MIPMAPS)",
				"unreal.EditorAssetLibrary.save_loaded_asset(Texture_$(buffer_index)_asset)",
				"Texture_$(buffer_index).set_editor_property('texture', Texture_$(buffer_index)_asset)",
				"$end_buffers",
				"mat.connect_property(Custom_0, 'return', unreal.MaterialProperty.MP_BASE_COLOR)",
				"mat.connect_property(Custom_0, 'metallic', unreal.MaterialProperty.MP_METALLIC)",
				"mat.connect_property(Custom_0, 'roughness', unreal.MaterialProperty.MP_ROUGHNESS)",
				"mat.connect_property(Custom_0, 'normal', unreal.MaterialProperty.MP_NORMAL)",
				"mat.connect_property(Custom_0, 'emission', unreal.MaterialProperty.MP_EMISSIVE_COLOR)",
				"mat.connect_property(Custom_0, 'occlusion', unreal.MaterialProperty.MP_AMBIENT_OCCLUSION)",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"mat.set_editor_property('blend_mode', unreal.BlendMode.BLEND_TRANSLUCENT)",
				"mat.connect_property(Custom_0, 'opacity', unreal.MaterialProperty.MP_OPACITY)",
				"$fi",
				"mat.connect_nodes(TextureCoordinate_0, '', Custom_0, 'TexCoords')",
				"mat.connect_nodes(Time_0, '', Custom_0, 'Time')",
				"$begin_buffers",
				"mat.connect_nodes(Texture_$(buffer_index), '', Custom_0, 'texture_$(buffer_index)')",
				"$end_buffers",
				"mat.save()",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr",
			"type": "buffers"
		},
		{
			"file_name": "$(path_prefix).shader",
			"template": [
				"struct Functions {",
				"\tfloat Time;",
				"$begin_buffers",
				"\tTexture2D texture_$(buffer_index);",
				"\tSamplerState texture_$(buffer_index)Sampler;",
				"$end_buffers",
				"",
				"$definitions hlsl_base,rename_buffers,unreal5,sample_level_0",
				"\tfloat4 generated_shader(float2 uv, float _time,",
				"$begin_buffers",
				"\t\t\t\t\t\t\tTexture2D _texture_$(buffer_index), SamplerState _texture_$(buffer_index)Sampler,",
				"$end_buffers",
				"\t\t\t\t\t\t\tout float metallic, out float roughness, out float3 normal, out float3 emission, out float occlusion, out float opacity) {",
				"\t\tfloat _seed_variation_ = 0.0;",
				"\t\tfloat4 _controlled_variation_ = float4(0.0, 0.0, 0.0, 0.0);",
				"\t\tTime = _time;",
				"$begin_buffers",
				"\t\ttexture_$(buffer_index) = _texture_$(buffer_index);",
				"\t\ttexture_$(buffer_index)Sampler = _texture_$(buffer_index)Sampler;",
				"$end_buffers",
				"\t\tuv = frac(uv);",
				"$begin_generate hlsl_base,rename_buffers,unreal5,sample_level_0",
				"\t\tfloat3 albedo_tex = $albedo_tex(uv);",
				"\t\talbedo_tex = lerp(pow((albedo_tex+float3(0.055, 0.055, 0.055))/1.055, float3(2.4, 2.4, 2.4)), albedo_tex/12.92, float3(albedo_tex < float3(0.04045, 0.04045, 0.04045)));",
				"\t\tfloat4 rv = float4(albedo_tex*$albedo_color.rgb, 1.0);",
				"$if $(connected:metallic_tex)",
				"\t\tmetallic = $metallic*$metallic_tex(uv);",
				"$else",
				"\t\tmetallic = $metallic;",
				"$fi",
				"\t\troughness = $roughness*$roughness_tex(uv);",
				"\t\t// Material Maker's normal convention to Unreal's tangent space (DirectX, Y down)",
				"\t\tfloat3 n = ($normal_tex(uv)*float3(-1.0, 1.0, -1.0)+float3(1.0, 0.0, 1.0))*2.0-float3(1.0, 1.0, 1.0);",
				"\t\tnormal = normalize(float3(n.x*$normal, -n.y*$normal, n.z));",
				"\t\tfloat3 emission_tex = $emission_tex(uv);",
				"\t\temission = lerp(pow((emission_tex+float3(0.055, 0.055, 0.055))/1.055, float3(2.4, 2.4, 2.4)), emission_tex/12.92, float3(emission_tex < float3(0.04045, 0.04045, 0.04045)))*$emission_energy;",
				"\t\tocclusion = lerp(1.0, $ao_tex(uv), $ao);",
				"\t\topacity = $opacity_tex(uv);",
				"\t\treturn rv;",
				"$end_generate",
				"\t}",
				"};",
				"Functions f;",
				"float4 albedo = f.generated_shader(TexCoords, Time,",
				"$begin_buffers",
				"\t\t\t\t\t\t\t\t   texture_$(buffer_index), texture_$(buffer_index)Sampler,",
				"$end_buffers",
				"\t\t\t\t\t\t\t\t   metallic, roughness, normal, emission, occlusion, opacity);",
				"return albedo;",
				""
			],
			"type": "template"
		},
		{
			"file_name": "clipboard",
			"template": [
				"\"$(path_prefix).py\"",
				""
			],
			"type": "template"
		}
	],
	"material": "material",
	"name": "Unreal/Unreal Engine 5 Shader"
}
