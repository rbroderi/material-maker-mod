{
	"export_extension": "py",
	"files": [
		{
			"file_name": "$(path_prefix).py",
			"prompt_overwrite": false,
			"template": "import unreal\nimport sys\nsys.path.append('$(material_maker_path)$(path_separator)export')\nimport mm\nfrom importlib import reload\nreload(mm)\n# Procedural material generated by Material Maker: the graph is computed in a\n# Custom node (buffers, if any, are textures)\nmat = mm.Material('$(file_prefix)', True)\nmat.clear()\nCustom_0 = mat.add_node('Custom', -264, 80)\nCustom_0.set_editor_property('code', mm.read_text_file('$(path_prefix).shader'))\nCustom_0.set_editor_property('output_type', unreal.CustomMaterialOutputType.CMOT_FLOAT4)\nCustom_0.set_editor_property('additional_outputs', [ mm.custom_output('metallic', 1), mm.custom_output('roughness', 1), mm.custom_output('normal', 3), mm.custom_output('emission', 3), mm.custom_output('occlusion', 1), mm.custom_output('opacity', 1)])\ninputs = [mm.custom_input('TexCoords'), mm.custom_input('Time')]\n$begin_buffers\ninputs.append(mm.custom_input('texture_$(buffer_index)'))\n$end_buffers\nCustom_0.set_editor_property('inputs', inputs)\nTextureCoordinate_0 = mat.add_node('TextureCoordinate', -472, 80)\nTime_0 = mat.add_node('Time', -456, 180)\n$begin_buffers\nTexture_$(buffer_index) = mat.add_node('TextureObject', -456, $(expr:110+170*$(buffer_index)))\nTexture_$(buffer_index).set_editor_property('texture', mm.import_texture('$(path_prefix)_texture_$(buffer_index).png', '/Game/Textures'))\n$end_buffers\nmat.connect_property(Custom_0, 'return', unreal.MaterialProperty.MP_BASE_COLOR)\nmat.connect_property(Custom_0, 'metallic', unreal.MaterialProperty.MP_METALLIC)\nmat.connect_property(Custom_0, 'roughness', unreal.MaterialProperty.MP_ROUGHNESS)\nmat.connect_property(Custom_0, 'normal', unreal.MaterialProperty.MP_NORMAL)\nmat.connect_property(Custom_0, 'emission', unreal.MaterialProperty.MP_EMISSIVE_COLOR)\nmat.connect_property(Custom_0, 'occlusion', unreal.MaterialProperty.MP_AMBIENT_OCCLUSION)\n$if $(connected:opacity_tex) and $(param:flags_transparent)\nmat.set_editor_property('blend_mode', unreal.BlendMode.BLEND_TRANSLUCENT)\nmat.connect_property(Custom_0, 'opacity', unreal.MaterialProperty.MP_OPACITY)\n$fi\nmat.connect_nodes(TextureCoordinate_0, '', Custom_0, 'TexCoords')\nmat.connect_nodes(Time_0, '', Custom_0, 'Time')\n$begin_buffers\nmat.connect_nodes(Texture_$(buffer_index), '', Custom_0, 'texture_$(buffer_index)')\n$end_buffers\nmat.save()\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).png",
			"type": "buffers"
		},
		{
			"file_name": "$(path_prefix).shader",
			"template": "struct Functions {\n\tfloat Time;\n$begin_buffers\n\tTexture2D texture_$(buffer_index);\n\tSamplerState texture_$(buffer_index)Sampler;\n$end_buffers\n\n$definitions hlsl_base,rename_buffers,unreal5\n\tfloat4 generated_shader(float2 uv, float _time,\n$begin_buffers\n\t\t\t\t\t\t\tTexture2D _texture_$(buffer_index), SamplerState _texture_$(buffer_index)Sampler,\n$end_buffers\n\t\t\t\t\t\t\tout float metallic, out float roughness, out float3 normal, out float3 emission, out float occlusion, out float opacity) {\n\t\tfloat _seed_variation_ = 0.0;\n\t\tfloat4 _controlled_variation_ = float4(0.0, 0.0, 0.0, 0.0);\n\t\tTime = _time;\n$begin_buffers\n\t\ttexture_$(buffer_index) = _texture_$(buffer_index);\n\t\ttexture_$(buffer_index)Sampler = _texture_$(buffer_index)Sampler;\n$end_buffers\n\t\tuv = frac(uv);\n$begin_generate hlsl_base,rename_buffers,unreal5\n\t\tfloat3 albedo_tex = $albedo_tex(uv);\n\t\talbedo_tex = lerp(pow((albedo_tex+float3(0.055, 0.055, 0.055))/1.055, float3(2.4, 2.4, 2.4)), albedo_tex/12.92, float3(albedo_tex < float3(0.04045, 0.04045, 0.04045)));\n\t\tfloat4 rv = float4(albedo_tex*$albedo_color.rgb, 1.0);\n$if $(connected:metallic_tex)\n\t\tmetallic = $metallic*$metallic_tex(uv);\n$else\n\t\tmetallic = $metallic;\n$fi\n\t\troughness = $roughness*$roughness_tex(uv);\n\t\t// Material Maker's normal convention to Unreal's tangent space (DirectX, Y down)\n\t\tfloat3 n = ($normal_tex(uv)*float3(-1.0, 1.0, -1.0)+float3(1.0, 0.0, 1.0))*2.0-float3(1.0, 1.0, 1.0);\n\t\tnormal = normalize(float3(n.x*$normal, -n.y*$normal, n.z));\n\t\tfloat3 emission_tex = $emission_tex(uv);\n\t\temission = lerp(pow((emission_tex+float3(0.055, 0.055, 0.055))/1.055, float3(2.4, 2.4, 2.4)), emission_tex/12.92, float3(emission_tex < float3(0.04045, 0.04045, 0.04045)))*$emission_energy;\n\t\tocclusion = lerp(1.0, $ao_tex(uv), $ao);\n\t\topacity = $opacity_tex(uv);\n\t\treturn rv;\n$end_generate\n\t}\n};\nFunctions f;\nfloat4 albedo = f.generated_shader(TexCoords, Time,\n$begin_buffers\n\t\t\t\t\t\t\t\t   texture_$(buffer_index), texture_$(buffer_index)Sampler,\n$end_buffers\n\t\t\t\t\t\t\t\t   metallic, roughness, normal, emission, occlusion, opacity);\nreturn albedo;\n",
			"type": "template"
		},
		{
			"file_name": "clipboard",
			"template": "\"$(path_prefix).py\"\n",
			"type": "template"
		}
	],
	"material": "material",
	"name": "Unreal/Unreal Engine 5 Shader"
}
