{
	"export_extension": "mat",
	"files": [
		{
			"file_name": "$(path_prefix).shader",
			"template": [
				"Shader \"Material Maker/$(file_prefix)\"",
				"{",
				"\t// Procedural material generated by Material Maker: the graph is computed",
				"\t// in this shader (buffers, if any, are EXR textures)",
				"\tProperties {",
				"$begin_buffers",
				"\t\ttexture_$(buffer_index) (\"Texture $(buffer_index)\", 2D) = \"white\" {}",
				"$end_buffers",
				"\t\t_MainTex (\"UV\", 2D) = \"white\" {}",
				"\t}",
				"\tSubShader {",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"\t\tTags { \"RenderType\"=\"Transparent\" \"Queue\"=\"Transparent\" }",
				"$else",
				"\t\tTags { \"RenderType\"=\"Opaque\" }",
				"$fi",
				"\t\tLOD 200",
				"\t\tCGPROGRAM",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"\t\t#pragma surface surf Standard fullforwardshadows alpha:fade",
				"$else",
				"\t\t#pragma surface surf Standard fullforwardshadows",
				"$fi",
				"\t\t#pragma target 3.5",
				"",
				"\t\tsampler2D _MainTex;",
				"\t\tstruct Input {",
				"\t\t\tfloat2 uv_MainTex;",
				"\t\t};",
				"",
				"$definitions hlsl,rename_buffers,unity",
				"",
				"\t\tvoid surf (Input IN, inout SurfaceOutputStandard o) {",
				"\t\t\tfloat _seed_variation_ = 0.0;",
				"\t\t\tfloat4 _controlled_variation_ = float4(0.0, 0.0, 0.0, 0.0);",
				"\t\t\tfloat2 uv = frac(IN.uv_MainTex);",
				"$begin_generate hlsl,rename_buffers,unity",
				"\t\t\tfloat3 albedo_tex = $albedo_tex(uv);",
				"#ifndef UNITY_COLORSPACE_GAMMA",
				"\t\t\talbedo_tex = GammaToLinearSpace(albedo_tex);",
				"#endif",
				"\t\t\to.Albedo = albedo_tex*$albedo_color.rgb;",
				"$if $(connected:metallic_tex)",
				"\t\t\to.Metallic = $metallic*$metallic_tex(uv);",
				"$else",
				"\t\t\to.Metallic = $metallic;",
				"$fi",
				"\t\t\to.Smoothness = 1.0-$roughness*$roughness_tex(uv);",
				"\t\t\t// Material Maker's normal convention to Unity's tangent space (OpenGL)",
				"\t\t\tfloat3 normal_tex = ($normal_tex(uv)*float3(-1.0, 1.0, -1.0)+float3(1.0, 0.0, 1.0))*2.0-float3(1.0, 1.0, 1.0);",
				"\t\t\to.Normal = normalize(float3(normal_tex.xy*$normal, normal_tex.z));",
				"\t\t\tfloat3 emission_tex = $emission_tex(uv);",
				"#ifndef UNITY_COLORSPACE_GAMMA",
				"\t\t\temission_tex = GammaToLinearSpace(emission_tex);",
				"#endif",
				"\t\t\to.Emission = emission_tex*$emission_energy;",
				"\t\t\to.Occlusion = lerp(1.0, $ao_tex(uv), $ao);",
				"$if $(connected:opacity_tex) and $(param:flags_transparent)",
				"\t\t\to.Alpha = $opacity_tex(uv);",
				"$else",
				"\t\t\to.Alpha = 1.0;",
				"$fi",
				"$end_generate",
				"\t\t}",
				"\t\tENDCG",
				"\t}",
				"\tFallBack \"Diffuse\"",
				"}",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr",
			"type": "buffers"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr.meta",
			"template": [
				"fileFormatVersion: 2",
				"guid: $uid(tex_$(buffer_index))",
				"TextureImporter:",
				"  internalIDToNameTable: []",
				"  externalObjects: {}",
				"  serializedVersion: 11",
				"  mipmaps:",
				"    mipMapMode: 0",
				"    enableMipMap: 1",
				"    sRGBTexture: 0",
				"    linearTexture: 0",
				"    fadeOut: 0",
				"    borderMipMap: 0",
				"    mipMapsPreserveCoverage: 0",
				"    alphaTestReferenceValue: 0.5",
				"    mipMapFadeDistanceStart: 1",
				"    mipMapFadeDistanceEnd: 3",
				"  bumpmap:",
				"    convertToNormalMap: 0",
				"    externalNormalMap: 0",
				"    heightScale: 0.25",
				"    normalMapFilter: 0",
				"  isReadable: 0",
				"  streamingMipmaps: 0",
				"  streamingMipmapsPriority: 0",
				"  vTOnly: 0",
				"  grayScaleToAlpha: 0",
				"  generateCubemap: 6",
				"  cubemapConvolution: 0",
				"  seamlessCubemap: 0",
				"  textureFormat: 1",
				"  maxTextureSize: 2048",
				"  textureSettings:",
				"    serializedVersion: 2",
				"    filterMode: -1",
				"    aniso: -1",
				"    mipBias: -100",
				"    wrapU: -1",
				"    wrapV: -1",
				"    wrapW: -1",
				"  nPOTScale: 1",
				"  lightmap: 0",
				"  compressionQuality: 50",
				"  spriteMode: 0",
				"  spriteExtrude: 1",
				"  spriteMeshType: 1",
				"  alignment: 0",
				"  spritePivot: {x: 0.5, y: 0.5}",
				"  spritePixelsToUnits: 100",
				"  spriteBorder: {x: 0, y: 0, z: 0, w: 0}",
				"  spriteGenerateFallbackPhysicsShape: 1",
				"  alphaUsage: 1",
				"  alphaIsTransparency: 0",
				"  spriteTessellationDetail: -1",
				"  textureType: 0",
				"  textureShape: 1",
				"  singleChannelComponent: 0",
				"  flipbookRows: 1",
				"  flipbookColumns: 1",
				"  maxTextureSizeSet: 0",
				"  compressionQualitySet: 0",
				"  textureFormatSet: 0",
				"  ignorePngGamma: 0",
				"  applyGammaDecoding: 0",
				"  platformSettings:",
				"  - serializedVersion: 3",
				"    buildTarget: DefaultTexturePlatform",
				"    maxTextureSize: 2048",
				"    resizeAlgorithm: 0",
				"    textureFormat: -1",
				"    textureCompression: 0",
				"    compressionQuality: 50",
				"    crunchedCompression: 0",
				"    allowsAlphaSplitting: 0",
				"    overridden: 0",
				"    androidETC2FallbackOverride: 0",
				"    forceMaximumCompressionQuality_BC6H_BC7: 0",
				"  spriteSheet:",
				"    serializedVersion: 2",
				"    sprites: []",
				"    outline: []",
				"    physicsShape: []",
				"    bones: []",
				"    spriteID: ",
				"    internalID: 0",
				"    vertices: []",
				"    indices: ",
				"    edges: []",
				"    weights: []",
				"    secondaryTextures: []",
				"  spritePackingTag: ",
				"  pSDRemoveMatte: 0",
				"  pSDShowRemoveMatteOption: 0",
				"  userData: ",
				"  assetBundleName: ",
				"  assetBundleVariant: ",
				""
			],
			"type": "buffer_templates"
		},
		{
			"file_name": "$(path_prefix).mat",
			"template": [
				"%YAML 1.1",
				"%TAG !u! tag:unity3d.com,2011:",
				"--- !u!21 &2100000",
				"Material:",
				"  serializedVersion: 6",
				"  m_ObjectHideFlags: 0",
				"  m_CorrespondingSourceObject: {fileID: 0}",
				"  m_PrefabInstance: {fileID: 0}",
				"  m_PrefabAsset: {fileID: 0}",
				"  m_Name: $(file_prefix)",
				"  m_Shader: {fileID: 4800000, guid: $uid(shader), type: 3}",
				"  m_ShaderKeywords: ",
				"  m_LightmapFlags: 4",
				"  m_EnableInstancingVariants: 0",
				"  m_DoubleSidedGI: 0",
				"  m_CustomRenderQueue: -1",
				"  stringTagMap: {}",
				"  disabledShaderPasses: []",
				"  m_SavedProperties:",
				"    serializedVersion: 3",
				"    m_TexEnvs:",
				"    - _MainTex:",
				"        m_Texture: {fileID: 2800000, guid: 6c5d2d4e94384751a0ce7d6619e0d49a, type: 3}",
				"        m_Scale: {x: 1, y: 1}",
				"        m_Offset: {x: 0, y: 0}",
				"$begin_buffers",
				"    - texture_$(buffer_index):",
				"        m_Texture: {fileID: 2800000, guid: $uid(tex_$(buffer_index)), type: 3}",
				"        m_Scale: {x: 1, y: 1}",
				"        m_Offset: {x: 0, y: 0}",
				"$end_buffers",
				"  m_BuildTextureStacks: []",
				""
			],
			"type": "template"
		},
		{
			"file_name": "$(path_prefix).shader.meta",
			"template": [
				"fileFormatVersion: 2",
				"guid: $uid(shader)",
				"ShaderImporter:",
				"  externalObjects: {}",
				"  defaultTextures: []",
				"  nonModifiableTextures: []",
				"  preprocessorOverride: 0",
				"  userData: ",
				"  assetBundleName: ",
				"  assetBundleVariant: ",
				""
			],
			"type": "template"
		}
	],
	"material": "material",
	"name": "Unity/Built-in Shader"
}
