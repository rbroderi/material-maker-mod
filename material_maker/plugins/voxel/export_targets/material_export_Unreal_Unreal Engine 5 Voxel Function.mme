{
	"custom": "## Replaces the uniforms of the Voxel Inputs node by members of the Custom\n## node's function struct (fed by its inputs)\nfunc process_option_voxel_inputs(s : String, is_declaration : bool = false) -> String:\n\tvar rx : RegEx = RegEx.new()\n\tif is_declaration:\n\t\trx.compile(\"(?m)^[ \\\\t]*float[ \\\\t]+p_o\\\\d+_vox_\\\\w+;[ \\\\t]*\\\\r?\\\\n\")\n\telse:\n\t\trx.compile(\"(?m)^[ \\\\t]*p_o\\\\d+_vox_\\\\w+[ \\\\t]*=[^;]*;[ \\\\t]*\\\\r?\\\\n\")\n\ts = rx.sub(s, \"\", true)\n\trx.compile(\"\\\\bp_o\\\\d+_vox_axis_([xyz])\\\\b\")\n\ts = rx.sub(s, \"vox_axis.$1\", true)\n\trx.compile(\"\\\\bp_o\\\\d+_vox_origin_([xyz])\\\\b\")\n\ts = rx.sub(s, \"vox_origin.$1\", true)\n\trx.compile(\"\\\\bp_o\\\\d+_vox_(seed|age|upkeep|fresh|char|wet|footprint)\\\\b\")\n\ts = rx.sub(s, \"vox_$1\", true)\n\treturn s\n",
	"export_extension": "py",
	"files": [
		{
			"file_name": "$(path_prefix)_function.py",
			"prompt_overwrite": false,
			"template": "import unreal\nimport sys\nsys.path.append('$(material_maker_path)$(path_separator)export')\nimport mm\nfrom importlib import reload\nreload(mm)\n# UNVERIFIED in Unreal: written from memory of the Unreal Python API, not run\n# in an Unreal session. Check it in the editor before use.\n# Material Function MF_$(file_prefix) generated by Material Maker: the voxel\n# recipe is computed in a Custom node from the object-space position (metres) and\n# normal. The struct of the recipe is in $(path_prefix).voxel.hlsl.\nMEL = unreal.MaterialEditingLibrary\nfunc = unreal.AssetToolsHelpers.get_asset_tools().create_asset('MF_$(file_prefix)', '/Game', unreal.MaterialFunction, unreal.MaterialFunctionFactoryNew())\n\ndef add(kind, x, y):\n    return MEL.create_material_expression_in_function(func, getattr(unreal, 'MaterialExpression' + kind), x, y)\n\ndef connect(source, source_output, dest, dest_input):\n    return MEL.connect_material_expressions(source, source_output, dest, dest_input)\n\ncall_textures = ''\n$begin_buffers\ncall_textures += 'texture_$(buffer_index), texture_$(buffer_index)Sampler, '\n$end_buffers\ncall = ('\\nMMVoxRecipe f;\\n'\n        'f.vox_seed = Seed; f.vox_age = Age; f.vox_upkeep = Upkeep; f.vox_fresh = Fresh; f.vox_char = Char; f.vox_wet = Wet; f.vox_footprint = Footprint;\\n'\n        'f.vox_axis = Axis; f.vox_origin = Origin;\\n'\n        'return f.generated_shader(Position, normalize(Normal), Time, ' + call_textures +\n        'metallic, roughness, normal, emission, occlusion, opacity);\\n')\nCustom_0 = add('Custom', 0, 0)\nCustom_0.set_editor_property('code', mm.read_text_file('$(path_prefix).voxel.hlsl') + call)\nCustom_0.set_editor_property('output_type', unreal.CustomMaterialOutputType.CMOT_FLOAT4)\nCustom_0.set_editor_property('additional_outputs', [ mm.custom_output('metallic', 1), mm.custom_output('roughness', 1), mm.custom_output('normal', 3), mm.custom_output('emission', 3), mm.custom_output('occlusion', 1), mm.custom_output('opacity', 1)])\ncontract = [ ('Position', 'Vector3'), ('Normal', 'Vector3'), ('Seed', 'Scalar'), ('Age', 'Scalar'), ('Upkeep', 'Scalar'), ('Fresh', 'Scalar'), ('Char', 'Scalar'), ('Wet', 'Scalar'), ('Axis', 'Vector3'), ('Origin', 'Vector3'), ('Footprint', 'Scalar'), ('Time', 'Scalar') ]\ninputs = [mm.custom_input(n) for n, t in contract]\n$begin_buffers\ninputs.append(mm.custom_input('texture_$(buffer_index)'))\n$end_buffers\nCustom_0.set_editor_property('inputs', inputs)\n# One function input per input of the contract (the caller feeds them)\ny = 0\nfor n, t in contract:\n    fi = add('FunctionInput', -500, y)\n    fi.set_editor_property('input_name', n)\n    fi.set_editor_property('input_type', getattr(unreal.FunctionInputType, 'FUNCTION_INPUT_' + t.upper()))\n    fi.set_editor_property('sort_priority', y // 100)\n    connect(fi, '', Custom_0, n)\n    y += 100\n$begin_buffers\nTexture_$(buffer_index) = add('TextureObject', -500, $(expr:1300+170*$(buffer_index)))\nTexture_$(buffer_index)_asset = mm.import_texture('$(path_prefix)_texture_$(buffer_index).exr', '/Game/Textures')\nTexture_$(buffer_index)_asset.set_editor_property('srgb', False)\nTexture_$(buffer_index)_asset.set_editor_property('compression_settings', unreal.TextureCompressionSettings.TC_HDR)\nTexture_$(buffer_index)_asset.set_editor_property('mip_gen_settings', unreal.TextureMipGenSettings.TMGS_NO_MIPMAPS)\nunreal.EditorAssetLibrary.save_loaded_asset(Texture_$(buffer_index)_asset)\nTexture_$(buffer_index).set_editor_property('texture', Texture_$(buffer_index)_asset)\nconnect(Texture_$(buffer_index), '', Custom_0, 'texture_$(buffer_index)')\n$end_buffers\n# The Normal input and output are in object space (like the Position input). Under a\n# non-uniform object scale the caller must transform normals with the inverse transpose\n# of the local to world matrix (n_local = M^T n_world, n_world = M^-T n_local): the\n# vector Transform node alone skews them.\ny = 0\nfor n, pin in [ ('BaseColor', ''), ('Metallic', 'metallic'), ('Roughness', 'roughness'), ('Normal', 'normal'), ('Emissive', 'emission'), ('AmbientOcclusion', 'occlusion'), ('Opacity', 'opacity') ]:\n    fo = add('FunctionOutput', 500, y)\n    fo.set_editor_property('output_name', n)\n    connect(Custom_0, pin, fo, '')\n    y += 100\nMEL.update_material_function(func)\nunreal.EditorAssetLibrary.save_loaded_asset(func)\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr",
			"type": "buffers"
		},
		{
			"file_name": "$(path_prefix).voxel.hlsl",
			"template": "struct MMVoxRecipe {\n\tfloat Time;\n\tfloat vox_seed; float vox_age; float vox_upkeep; float vox_fresh; float vox_char; float vox_wet; float vox_footprint;\n\tfloat3 vox_axis; float3 vox_origin;\n$begin_buffers\n\tTexture2D texture_$(buffer_index);\n\tSamplerState texture_$(buffer_index)Sampler;\n$end_buffers\n\n$definitions hlsl_base,rename_buffers,unreal5,sample_level_0,voxel_inputs\n\tfloat4 generated_shader(float3 p, float3 n, float _time,\n$begin_buffers\n\t\t\t\t\t\tTexture2D _texture_$(buffer_index), SamplerState _texture_$(buffer_index)Sampler,\n$end_buffers\n\t\t\t\t\t\tout float metallic, out float roughness, out float3 normal, out float3 emission, out float occlusion, out float opacity) {\n\t\tfloat _seed_variation_ = 0.0;\n\t\tfloat4 _controlled_variation_ = float4(n, 0.0);\n\t\tTime = _time;\n$begin_buffers\n\t\ttexture_$(buffer_index) = _texture_$(buffer_index);\n\t\ttexture_$(buffer_index)Sampler = _texture_$(buffer_index)Sampler;\n$end_buffers\n\t\tfloat4 mm_q = float4(p, 0.0);\n$begin_generate hlsl_base,rename_buffers,unreal5,sample_level_0,voxel_inputs\n\t\tfloat3 mm_alb = $albedo_tex(mm_q);\n$if not $(param:linear_albedo)\n\t\tmm_alb = float3((mm_alb.x < 0.04045) ? mm_alb.x/12.92 : pow(max((mm_alb.x+0.055)/1.055, 0.0), 2.4), (mm_alb.y < 0.04045) ? mm_alb.y/12.92 : pow(max((mm_alb.y+0.055)/1.055, 0.0), 2.4), (mm_alb.z < 0.04045) ? mm_alb.z/12.92 : pow(max((mm_alb.z+0.055)/1.055, 0.0), 2.4));\n$fi\n\t\tfloat4 rv = float4(mm_alb*$albedo_color.rgb, 1.0);\n\t\tmetallic = $metallic*$metallic_tex(mm_q);\n\t\troughness = $roughness*$roughness_tex(mm_q);\n\t\tfloat3 mm_g = $bump_tex(mm_q);\n\t\tnormal = normalize(n - $bump*(mm_g - n*dot(mm_g, n)));\n\t\temission = $emission_tex(mm_q)*$emission_energy;\n\t\tocclusion = lerp(1.0, $ao_tex(mm_q), $ao);\n\t\topacity = $opacity_tex(mm_q);\n\t\treturn rv;\n$end_generate\n\t}\n};\n",
			"type": "template"
		},
		{
			"file_name": "clipboard",
			"template": "\"$(path_prefix)_function.py\"\n",
			"type": "template"
		}
	],
	"material": "material_voxel",
	"name": "Unreal/Unreal Engine 5 Voxel Function"
}
