{
	"custom": "## Replaces the uniforms of the Voxel Inputs node by members of the Custom\n## node's function struct (fed by its inputs)\nfunc process_option_voxel_inputs(s : String, is_declaration : bool = false) -> String:\n\tvar rx : RegEx = RegEx.new()\n\tif is_declaration:\n\t\trx.compile(\"(?m)^[ \\\\t]*float[ \\\\t]+p_o\\\\d+_vox_\\\\w+;[ \\\\t]*\\\\r?\\\\n\")\n\telse:\n\t\trx.compile(\"(?m)^[ \\\\t]*p_o\\\\d+_vox_\\\\w+[ \\\\t]*=[^;]*;[ \\\\t]*\\\\r?\\\\n\")\n\ts = rx.sub(s, \"\", true)\n\trx.compile(\"\\\\bp_o\\\\d+_vox_axis_([xyz])\\\\b\")\n\ts = rx.sub(s, \"vox_axis.$1\", true)\n\trx.compile(\"\\\\bp_o\\\\d+_vox_origin_([xyz])\\\\b\")\n\ts = rx.sub(s, \"vox_origin.$1\", true)\n\trx.compile(\"\\\\bp_o\\\\d+_vox_(seed|age|upkeep|fresh|char|wet|footprint)\\\\b\")\n\ts = rx.sub(s, \"vox_$1\", true)\n\treturn s\n",
	"export_extension": "py",
	"files": [
		{
			"file_name": "$(path_prefix).py",
			"prompt_overwrite": false,
			"template": "import unreal\nimport sys\nsys.path.append('$(material_maker_path)$(path_separator)export')\nimport mm\nfrom importlib import reload\nreload(mm)\n# UNVERIFIED in Unreal: written from memory of the Unreal Python API, not run\n# in an Unreal session. Check it in the editor before use.\n# Voxel material generated by Material Maker: the graph is computed in a Custom\n# node from the object-space position (metres) and normal. The per-thing values\n# (Seed, Age, Upkeep, Fresh, Char, Wet, Footprint, Axis, Origin) are parameters\n# whose defaults here are zeros: set them per material instance in Unreal.\nmat = mm.Material('$(file_prefix)', True)\nmat.clear()\nCustom_0 = mat.add_node('Custom', -264, 80)\nCustom_0.set_editor_property('code', mm.read_text_file('$(path_prefix).shader'))\nCustom_0.set_editor_property('output_type', unreal.CustomMaterialOutputType.CMOT_FLOAT4)\nCustom_0.set_editor_property('additional_outputs', [ mm.custom_output('metallic', 1), mm.custom_output('roughness', 1), mm.custom_output('normal', 3), mm.custom_output('emission', 3), mm.custom_output('occlusion', 1), mm.custom_output('opacity', 1)])\ninputs = [mm.custom_input(n) for n in ['Position', 'Normal', 'Seed', 'Age', 'Upkeep', 'Fresh', 'Char', 'Wet', 'Axis', 'Origin', 'Footprint', 'Time']]\n$begin_buffers\ninputs.append(mm.custom_input('texture_$(buffer_index)'))\n$end_buffers\nCustom_0.set_editor_property('inputs', inputs)\n# Position: world position to local space, centimetres to metres\nWorldPosition_0 = mat.add_node('WorldPosition', -1100, 0)\nTransformPosition_0 = mat.add_node('TransformPosition', -900, 0)\nTransformPosition_0.set_editor_property('transform_source_type', unreal.MaterialPositionTransformSource.TRANSFORMPOSSOURCE_WORLD)\nTransformPosition_0.set_editor_property('transform_type', unreal.MaterialPositionTransformSource.TRANSFORMPOSSOURCE_LOCAL)\nMultiply_0 = mat.add_node('Multiply', -700, 0)\nMultiply_0.set_editor_property('const_b', 0.01)\nmat.connect_nodes(WorldPosition_0, '', TransformPosition_0, '')\nmat.connect_nodes(TransformPosition_0, '', Multiply_0, 'A')\nmat.connect_nodes(Multiply_0, '', Custom_0, 'Position')\n# Normal: world normal to local space\nVertexNormal_0 = mat.add_node('VertexNormalWS', -1100, 120)\nTransform_0 = mat.add_node('Transform', -900, 120)\nTransform_0.set_editor_property('transform_source_type', unreal.MaterialVectorCoordTransformSource.TRANSFORMSOURCE_WORLD)\nTransform_0.set_editor_property('transform_type', unreal.MaterialVectorCoordTransform.TRANSFORM_LOCAL)\nmat.connect_nodes(VertexNormal_0, '', Transform_0, '')\nmat.connect_nodes(Transform_0, '', Custom_0, 'Normal')\n# Per-thing values (defaults are zeros: set them per instance)\ny = 240\nfor n in ['Seed', 'Age', 'Upkeep', 'Fresh', 'Char', 'Wet', 'Footprint']:\n    p = mat.add_node('ScalarParameter', -700, y)\n    p.set_editor_property('parameter_name', n)\n    p.set_editor_property('default_value', 0.0)\n    mat.connect_nodes(p, '', Custom_0, n)\n    y += 100\nAxis_0 = mat.add_node('VectorParameter', -700, y)\nAxis_0.set_editor_property('parameter_name', 'Axis')\nAxis_0.set_editor_property('default_value', unreal.LinearColor(1.0, 0.0, 0.0, 0.0))\nmat.connect_nodes(Axis_0, '', Custom_0, 'Axis')\nOrigin_0 = mat.add_node('VectorParameter', -700, y+100)\nOrigin_0.set_editor_property('parameter_name', 'Origin')\nOrigin_0.set_editor_property('default_value', unreal.LinearColor(0.0, 0.0, 0.0, 0.0))\nmat.connect_nodes(Origin_0, '', Custom_0, 'Origin')\nTime_0 = mat.add_node('Time', -700, y+200)\nmat.connect_nodes(Time_0, '', Custom_0, 'Time')\n$begin_buffers\nTexture_$(buffer_index) = mat.add_node('TextureObject', -456, $(expr:110+170*$(buffer_index)))\nTexture_$(buffer_index)_asset = mm.import_texture('$(path_prefix)_texture_$(buffer_index).exr', '/Game/Textures')\nTexture_$(buffer_index)_asset.set_editor_property('srgb', False)\nTexture_$(buffer_index)_asset.set_editor_property('compression_settings', unreal.TextureCompressionSettings.TC_HDR)\nTexture_$(buffer_index)_asset.set_editor_property('mip_gen_settings', unreal.TextureMipGenSettings.TMGS_NO_MIPMAPS)\nunreal.EditorAssetLibrary.save_loaded_asset(Texture_$(buffer_index)_asset)\nTexture_$(buffer_index).set_editor_property('texture', Texture_$(buffer_index)_asset)\nmat.connect_nodes(Texture_$(buffer_index), '', Custom_0, 'texture_$(buffer_index)')\n$end_buffers\n# The normal is in object space: back to world space for the material\nNormalToWorld_0 = mat.add_node('Transform', -100, 200)\nNormalToWorld_0.set_editor_property('transform_source_type', unreal.MaterialVectorCoordTransformSource.TRANSFORMSOURCE_LOCAL)\nNormalToWorld_0.set_editor_property('transform_type', unreal.MaterialVectorCoordTransform.TRANSFORM_WORLD)\nmat.connect_nodes(Custom_0, 'normal', NormalToWorld_0, '')\nmat.set_editor_property('tangent_space_normal', False)\nmat.connect_property(Custom_0, 'return', unreal.MaterialProperty.MP_BASE_COLOR)\nmat.connect_property(Custom_0, 'metallic', unreal.MaterialProperty.MP_METALLIC)\nmat.connect_property(Custom_0, 'roughness', unreal.MaterialProperty.MP_ROUGHNESS)\nmat.connect_property(NormalToWorld_0, '', unreal.MaterialProperty.MP_NORMAL)\nmat.connect_property(Custom_0, 'emission', unreal.MaterialProperty.MP_EMISSIVE_COLOR)\nmat.connect_property(Custom_0, 'occlusion', unreal.MaterialProperty.MP_AMBIENT_OCCLUSION)\n$if $(connected:opacity_tex)\nmat.set_editor_property('blend_mode', unreal.BlendMode.BLEND_TRANSLUCENT)\nmat.connect_property(Custom_0, 'opacity', unreal.MaterialProperty.MP_OPACITY)\n$fi\nmat.save()\n",
			"type": "template"
		},
		{
			"file_name": "$(path_prefix)_texture_$(buffer_index).exr",
			"type": "buffers"
		},
		{
			"file_name": "$(path_prefix).shader",
			"template": "struct Functions {\n\tfloat Time;\n\tfloat vox_seed; float vox_age; float vox_upkeep; float vox_fresh; float vox_char; float vox_wet; float vox_footprint;\n\tfloat3 vox_axis; float3 vox_origin;\n$begin_buffers\n\tTexture2D texture_$(buffer_index);\n\tSamplerState texture_$(buffer_index)Sampler;\n$end_buffers\n\n$definitions hlsl_base,rename_buffers,unreal5,sample_level_0,voxel_inputs\n\tfloat4 generated_shader(float3 p, float3 n, float _time,\n$begin_buffers\n\t\t\t\t\t\tTexture2D _texture_$(buffer_index), SamplerState _texture_$(buffer_index)Sampler,\n$end_buffers\n\t\t\t\t\t\tout float metallic, out float roughness, out float3 normal, out float3 emission, out float occlusion, out float opacity) {\n\t\tfloat _seed_variation_ = 0.0;\n\t\tfloat4 _controlled_variation_ = float4(n, 0.0);\n\t\tTime = _time;\n$begin_buffers\n\t\ttexture_$(buffer_index) = _texture_$(buffer_index);\n\t\ttexture_$(buffer_index)Sampler = _texture_$(buffer_index)Sampler;\n$end_buffers\n\t\tfloat4 mm_q = float4(p, 0.0);\n$begin_generate hlsl_base,rename_buffers,unreal5,sample_level_0,voxel_inputs\n\t\tfloat3 mm_alb = $albedo_tex(mm_q);\n$if not $(param:linear_albedo)\n\t\tmm_alb = lerp(pow((mm_alb+float3(0.055, 0.055, 0.055))/1.055, float3(2.4, 2.4, 2.4)), mm_alb/12.92, float3(mm_alb < float3(0.04045, 0.04045, 0.04045)));\n$fi\n\t\tfloat4 rv = float4(mm_alb*$albedo_color.rgb, 1.0);\n\t\tmetallic = $metallic*$metallic_tex(mm_q);\n\t\troughness = $roughness*$roughness_tex(mm_q);\n\t\tfloat3 mm_g = $bump_tex(mm_q);\n\t\tnormal = normalize(n - $bump*(mm_g - n*dot(mm_g, n)));\n\t\temission = $emission_tex(mm_q)*$emission_energy;\n\t\tocclusion = lerp(1.0, $ao_tex(mm_q), $ao);\n\t\topacity = $opacity_tex(mm_q);\n\t\treturn rv;\n$end_generate\n\t}\n};\nFunctions f;\nf.vox_seed = Seed; f.vox_age = Age; f.vox_upkeep = Upkeep; f.vox_fresh = Fresh; f.vox_char = Char; f.vox_wet = Wet; f.vox_footprint = Footprint;\nf.vox_axis = Axis; f.vox_origin = Origin;\nfloat4 albedo = f.generated_shader(Position, normalize(Normal), Time,\n$begin_buffers\n\t\t\t\t\t\t\t\t   texture_$(buffer_index), texture_$(buffer_index)Sampler,\n$end_buffers\n\t\t\t\t\t\t\t\t   metallic, roughness, normal, emission, occlusion, opacity);\nreturn albedo;\n",
			"type": "template"
		},
		{
			"file_name": "clipboard",
			"template": "\"$(path_prefix).py\"\n",
			"type": "template"
		}
	],
	"material": "material_voxel",
	"name": "Unreal/Unreal Engine 5 Voxel"
}
