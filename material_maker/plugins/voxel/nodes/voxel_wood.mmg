{
	"name": "voxel_wood",
	"node_position": {
		"x": 0,
		"y": 0
	},
	"parameters": {
		"aged_colour": {
			"a": 1,
			"b": 0.24313725490196078,
			"g": 0.32941176470588235,
			"r": 0.41568627450980394
		},
		"aged_hides": 0.55,
		"bump_strength": 0.08,
		"check_strength": 0.7,
		"early": {
			"a": 1,
			"b": 0.2980392156862745,
			"g": 0.43137254901960786,
			"r": 0.5725490196078431
		},
		"flow_amount": 7.0,
		"flow_scale": 0.014,
		"late": {
			"a": 1,
			"b": 0.1568627450980392,
			"g": 0.22745098039215686,
			"r": 0.32941176470588235
		},
		"pith_wander": 4.0,
		"pore_strength": 0.55,
		"ray_strength": 0.4,
		"ring_porous": true,
		"ring_width_mm": 5,
		"ripple_amount": 0.7,
		"units_per_metre": 81
	},
	"seed_int": 0,
	"shader_model": {
		"code": "",
		"global": "",
		"includes": [
			"mm_noise3d"
		],
		"inputs": [
			{
				"default": "0.0",
				"label": "Seed",
				"longdesc": "The seed of the piece of wood (from Voxel Inputs)",
				"name": "seed_in",
				"shortdesc": "Seed",
				"type": "tex3d_gs"
			},
			{
				"default": "vec3(0.0)",
				"label": "Normal",
				"longdesc": "The surface normal (from Voxel Inputs); a zero vector means unknown and counts as a face along the grain",
				"name": "normal_in",
				"shortdesc": "Normal",
				"type": "tex3d"
			},
			{
				"default": "vec3(1.0, 0.0, 0.0)",
				"label": "Axis",
				"longdesc": "The grain axis (from Voxel Inputs)",
				"name": "axis_in",
				"shortdesc": "Axis",
				"type": "tex3d"
			},
			{
				"default": "vec3(0.0)",
				"label": "Origin",
				"longdesc": "The position of the pith, in metres (from Voxel Inputs)",
				"name": "origin_in",
				"shortdesc": "Origin",
				"type": "tex3d"
			},
			{
				"default": "0.1",
				"label": "Age",
				"longdesc": "How old and handled the surface is, from 0 to 1 (from Voxel Inputs)",
				"name": "age_in",
				"shortdesc": "Age",
				"type": "tex3d_gs"
			},
			{
				"default": "0.0",
				"label": "Fresh",
				"longdesc": "0 for the original aged surface, 1 for a freshly cut one (from Voxel Inputs)",
				"name": "fresh_in",
				"shortdesc": "Fresh",
				"type": "tex3d_gs"
			},
			{
				"default": "0.0",
				"label": "Footprint",
				"longdesc": "Size of a pixel in metres, used to fade rings finer than a pixel (from Voxel Inputs)",
				"name": "footprint_in",
				"shortdesc": "Footprint",
				"type": "tex3d_gs"
			}
		],
		"instance": [
			"float $(name)_lin1(float c) {",
			"\treturn (c <= 0.04045) ? c/12.92 : pow((c+0.055)/1.055, 2.4);",
			"}",
			"vec3 $(name)_lin(vec3 c) {",
			"\treturn vec3($(name)_lin1(c.x), $(name)_lin1(c.y), $(name)_lin1(c.z));",
			"}",
			"vec3 $(name)_axis(vec3 ax) {",
			"\tfloat l = dot(ax, ax);",
			"\tif (l > 0.000001) {",
			"\t\treturn ax/sqrt(l);",
			"\t}",
			"\treturn vec3(1.0, 0.0, 0.0);",
			"}",
			"int $(name)_dom(vec3 a) {",
			"\tvec3 b = abs(a);",
			"\tif (b.x >= b.y && b.x >= b.z) {",
			"\t\treturn 0;",
			"\t}",
			"\tif (b.y >= b.z) {",
			"\t\treturn 1;",
			"\t}",
			"\treturn 2;",
			"}",
			"vec3 $(name)_b1(vec3 a) {",
			"\tvec3 eu = vec3(1.0, 0.0, 0.0);",
			"\tif ($(name)_dom(a) == 0) {",
			"\t\teu = vec3(0.0, 1.0, 0.0);",
			"\t}",
			"\treturn normalize(eu-a*dot(eu, a));",
			"}",
			"vec3 $(name)_b2(vec3 a) {",
			"\tvec3 ev = vec3(0.0, 0.0, 1.0);",
			"\tif ($(name)_dom(a) == 2) {",
			"\t\tev = vec3(0.0, 1.0, 0.0);",
			"\t}",
			"\tvec3 b1 = $(name)_b1(a);",
			"\treturn normalize(ev-a*dot(ev, a)-b1*dot(ev, b1));",
			"}",
			"float $(name)_side(vec3 nrm, vec3 a) {",
			"\tfloat nl = dot(nrm, nrm);",
			"\tif (nl > 0.000001) {",
			"\t\tfloat d = 1.0-abs(dot(nrm/sqrt(nl), a));",
			"\t\treturn d*d;",
			"\t}",
			"\treturn 1.0;",
			"}",
			"vec4 $(name)_eval(vec3 P, vec3 org, vec3 nrm, vec3 ax, float sd, float age_in, float fr, float fpr) {",
			"\tuint sh = mm_n3_seed(sd);",
			"\tfloat upm = $units_per_metre;",
			"\tvec3 a = $(name)_axis(ax);",
			"\tvec3 b1 = $(name)_b1(a);",
			"\tvec3 b2 = $(name)_b2(a);",
			"\tvec3 q = P*upm;",
			"\tvec3 oq = org*upm;",
			"\tfloat s = dot(q, a);",
			"\tfloat u0 = dot(q, b1);",
			"\tfloat v0 = dot(q, b2);",
			"\tfloat ou = dot(oq, b1);",
			"\tfloat ov = dot(oq, b2);",
			"\tfloat rw = $ring_width_mm*upm/1000.0;",
			"\tfloat side = $(name)_side(nrm, a);",
			"\tfloat ag = 1.0-fr;",
			"\tfloat age = age_in*ag+0.10*(1.0-ag);",
			"\tfloat fp = fpr*upm;",
			"\tvec3 early = $(name)_lin($early.rgb);",
			"\tvec3 late = $(name)_lin($late.rgb);",
			"\tvec3 agedc = $(name)_lin($aged_colour.rgb);",
			"\tfloat pu = (mm_n3_value(vec3(s*0.011+9.0, 0.3, 0.7), sh+20u)-0.5)*$pith_wander;",
			"\tfloat pv = (mm_n3_value(vec3(s*0.011+19.0, 0.6, 0.2), sh+21u)-0.5)*$pith_wander;",
			"\tfloat u = u0-ou-pu;",
			"\tfloat v = v0-ov-pv;",
			"\tfloat flow = (mm_n3_fbm(vec3(s*$flow_scale, u*0.03+4.0, v*0.03), sh, 2, 0.5, 2.03)-0.5)*$flow_amount;",
			"\tfloat ripple = (mm_n3_value(vec3(s*0.05, u*0.15, v*0.15), sh+1u)-0.5)*$ripple_amount;",
			"\tfloat r = abs(sqrt(u*u+v*v)+flow+ripple);",
			"\tfloat rb = r/rw;",
			"\tfloat phase = rb+1.6*(mm_n3_value(vec3(rb*0.17+0.5, 0.5, 0.5), sh+2u)-0.5)+0.3*(mm_n3_value(vec3(rb*0.9, 0.2, s*0.02), sh+22u)-0.5);",
			"\tfloat yr = floor(phase);",
			"\tfloat f = phase-yr;",
			"\tfloat year = mm_n3_hash(int(yr), 3, 4, sh);",
			"\tfloat fade = clamp(rw/(2.2*max(fp, 0.0001)), 0.0, 1.0);",
			"\tfloat latefrac = smoothstep(0.30, 0.90, f)*(1.0-smoothstep(0.95, 1.0, f))*(0.7+0.6*year);",
			"\tlatefrac = 0.45+(clamp(latefrac, 0.0, 1.0)-0.45)*fade;",
			"\tvec3 col = mix(early, late, latefrac);",
			"\tfloat fibre = 0.45*mm_n3_value(vec3(s*0.15, u0*3.1, v0*3.1), sh+3u)+0.30*mm_n3_value(vec3(s*0.4, u0*8.0+5.0, v0*8.0), sh+13u)+0.25*mm_n3_value(vec3(s*0.05, u0*1.3, v0*1.3), sh+14u);",
			"\tcol *= 0.86+0.28*fibre;",
			"\tfloat pores = mm_n3_value(vec3(s*0.45, u0*14.0, v0*14.0), sh+4u);",
			"\tfloat pore;",
			"\tfloat raykind;",
			"\tif ($ring_porous) {",
			"\t\tfloat band = (1.0-smoothstep(0.18, 0.34, f))*smoothstep(0.0, 0.05, f);",
			"\t\tpore = clamp((pores-0.55)/0.2, 0.0, 1.0)*band+clamp((mm_n3_value(vec3(s*0.6, u0*20.0+7.0, v0*20.0), sh+15u)-0.86)/0.1, 0.0, 1.0)*0.4;",
			"\t\traykind = 1.0;",
			"\t} else {",
			"\t\tpore = clamp((pores-0.8)/0.15, 0.0, 1.0)*(1.0-smoothstep(0.2, 0.4, f))*0.5;",
			"\t\traykind = 0.25;",
			"\t}",
			"\tpore *= fade;",
			"\tcol *= 1.0-($pore_strength-0.25*age)*pore;",
			"\tfloat ang = atan(v, u);",
			"\tfloat rk = 17.0;",
			"\tfloat rayv = smoothstep(0.70, 0.80, mm_n3_value(vec3(cos(ang)*rk+30.0, sin(ang)*rk, s*0.11), sh+5u));",
			"\trayv = rayv*smoothstep(0.5, 0.72, mm_n3_value(vec3(r*0.22, s*0.05, 0.5), sh+16u))*raykind;",
			"\trayv *= fade;",
			"\tcol = mix(col, vec3(0.40, 0.28, 0.17)*(0.9+0.2*fibre), $ray_strength*rayv);",
			"\tcol *= 0.9+0.2*mm_n3_fbm(vec3(s*0.02, u0*0.1, v0*0.1), sh+6u, 2, 0.5, 2.03);",
			"\tfloat lum = dot(col, vec3(0.3, 0.59, 0.11));",
			"\tvec3 grey = lum*vec3(0.95, 0.88, 0.78);",
			"\tcol = mix(col, grey, clamp(0.55*age*(0.6+0.8*mm_n3_fbm(vec3(s*0.03, u0*0.2, v0*0.2), sh+7u, 3, 0.5, 2.03)), 0.0, 0.7));",
			"\tcol = mix(col, agedc*(0.8+0.4*fibre), clamp($aged_hides*0.45*ag*(0.35+0.65*side), 0.0, 0.5));",
			"\tcol *= 1.0-0.35*age*pore;",
			"\tfloat hs = smoothstep(0.55, 0.85, mm_n3_value(vec3(s*0.09, u0*0.55, v0*0.55), sh+30u));",
			"\tcol *= 1.0+0.16*age*hs*(0.4+0.6*side);",
			"\tcol *= 0.88;",
			"\tfloat cr = abs(mm_n3_value(vec3(s*0.012+3.0, u0*0.9, v0*0.9), sh+8u)-0.5);",
			"\tfloat wide = 0.010+0.012*mm_n3_value(vec3(s*0.05, u0*0.3, v0*0.3), sh+9u);",
			"\tfloat check = (1.0-smoothstep(wide*0.5, wide, cr))*smoothstep(0.45, 0.6, mm_n3_value(vec3(s*0.02, u0*0.25, v0*0.25), sh+10u));",
			"\tcol *= 1.0-$check_strength*check*side*ag;",
			"\treturn vec4(col, rayv);",
			"}",
			"float $(name)_h(vec3 q, vec3 a, vec3 b1, vec3 b2, uint sh) {",
			"\tfloat s = dot(q, a);",
			"\tfloat u = dot(q, b1);",
			"\tfloat v = dot(q, b2);",
			"\treturn mm_n3_value(vec3(s*0.15, u*3.1, v*3.1), sh+3u)+0.5*mm_n3_value(vec3(s*0.4, u*8.0+5.0, v*8.0), sh+13u)+0.6*mm_n3_value(vec3(s*0.08, u*1.5, v*1.5), sh+12u);",
			"}",
			"vec3 $(name)_bump(vec3 P, vec3 org, vec3 nrm, vec3 ax, float sd, float fr) {",
			"\tuint sh = mm_n3_seed(sd);",
			"\tvec3 a = $(name)_axis(ax);",
			"\tvec3 b1 = $(name)_b1(a);",
			"\tvec3 b2 = $(name)_b2(a);",
			"\tvec3 q = P*$units_per_metre;",
			"\tfloat k = $bump_strength+0.05*(1.0-fr)*$(name)_side(nrm, a);",
			"\tfloat e = 0.06;",
			"\tfloat h0 = $(name)_h(q, a, b1, b2, sh);",
			"\tvec3 g = vec3($(name)_h(q+vec3(e, 0.0, 0.0), a, b1, b2, sh)-h0, $(name)_h(q+vec3(0.0, e, 0.0), a, b1, b2, sh)-h0, $(name)_h(q+vec3(0.0, 0.0, e), a, b1, b2, sh)-h0)/e;",
			"\treturn k*g;",
			"}"
		],
		"longdesc": "A port of the voxkit oak recipe: growth rings, fibre, pores, medullary rays, ageing and drying checks",
		"name": "Voxel Wood",
		"outputs": [
			{
				"longdesc": "The linear base colour",
				"shortdesc": "Albedo",
				"tex3d": "$(name)_eval($uv.xyz, $origin_in($uv), $normal_in($uv), $axis_in($uv), $seed_in($uv), $age_in($uv), $fresh_in($uv), $footprint_in($uv)).rgb",
				"type": "tex3d"
			},
			{
				"longdesc": "The bump gradient vector, already multiplied by the bump strength, for the Bump input of a Voxel Material set to 1",
				"shortdesc": "Bump",
				"tex3d": "$(name)_bump($uv.xyz, $origin_in($uv), $normal_in($uv), $axis_in($uv), $seed_in($uv), $fresh_in($uv))",
				"type": "tex3d"
			},
			{
				"longdesc": "The roughness",
				"shortdesc": "Roughness",
				"tex3d_gs": "0.75-0.25*$(name)_eval($uv.xyz, $origin_in($uv), $normal_in($uv), $axis_in($uv), $seed_in($uv), $age_in($uv), $fresh_in($uv), $footprint_in($uv)).w",
				"type": "tex3d_gs"
			},
			{
				"longdesc": "The specular level",
				"shortdesc": "Spec",
				"tex3d_gs": "0.05+0.10*$(name)_eval($uv.xyz, $origin_in($uv), $normal_in($uv), $axis_in($uv), $seed_in($uv), $age_in($uv), $fresh_in($uv), $footprint_in($uv)).w",
				"type": "tex3d_gs"
			},
			{
				"longdesc": "The specular power",
				"shortdesc": "Power",
				"tex3d_gs": "20.0",
				"type": "tex3d_gs"
			}
		],
		"parameters": [
			{
				"control": "None",
				"default": 81,
				"label": "Units per metre",
				"longdesc": "Recipe units (voxels) per metre; the ring width and every feature size scale with it",
				"max": 1000,
				"min": 1,
				"name": "units_per_metre",
				"shortdesc": "Units per metre",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 5,
				"label": "Ring width (mm)",
				"longdesc": "Average width of a growth ring, in millimetres",
				"max": 100,
				"min": 0.1,
				"name": "ring_width_mm",
				"shortdesc": "Ring width (mm)",
				"step": 0.1,
				"type": "float"
			},
			{
				"default": {
					"a": 1,
					"b": 0.2980392156862745,
					"g": 0.43137254901960786,
					"r": 0.5725490196078431
				},
				"label": "Early wood",
				"longdesc": "Colour (sRGB) of the early wood, the pale part of each ring",
				"name": "early",
				"shortdesc": "Early wood",
				"type": "color"
			},
			{
				"default": {
					"a": 1,
					"b": 0.1568627450980392,
					"g": 0.22745098039215686,
					"r": 0.32941176470588235
				},
				"label": "Late wood",
				"longdesc": "Colour (sRGB) of the late wood, the dark part of each ring",
				"name": "late",
				"shortdesc": "Late wood",
				"type": "color"
			},
			{
				"default": {
					"a": 1,
					"b": 0.24313725490196078,
					"g": 0.32941176470588235,
					"r": 0.41568627450980394
				},
				"label": "Aged colour",
				"longdesc": "Colour (sRGB) of the aged surface finish",
				"name": "aged_colour",
				"shortdesc": "Aged colour",
				"type": "color"
			},
			{
				"control": "None",
				"default": 0.55,
				"label": "Aged hides",
				"longdesc": "How much the aged finish hides the wood",
				"max": 1,
				"min": 0,
				"name": "aged_hides",
				"shortdesc": "Aged hides",
				"step": 0.01,
				"type": "float"
			},
			{
				"default": true,
				"label": "Ring porous",
				"longdesc": "Ring porous wood (oak) has a line of open pores in the early wood and strong medullary rays",
				"name": "ring_porous",
				"shortdesc": "Ring porous",
				"type": "boolean"
			},
			{
				"control": "None",
				"default": 7.0,
				"label": "Flow amount",
				"longdesc": "How far slow noise pushes the rings about, in recipe units",
				"max": 50,
				"min": 0,
				"name": "flow_amount",
				"shortdesc": "Flow amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.014,
				"label": "Flow scale",
				"longdesc": "Frequency of the ring flow noise along the grain, per recipe unit",
				"max": 1,
				"min": 0.0001,
				"name": "flow_scale",
				"shortdesc": "Flow scale",
				"step": 0.0001,
				"type": "float"
			},
			{
				"control": "None",
				"default": 4.0,
				"label": "Pith wander",
				"longdesc": "How far the pith wanders along the grain, in recipe units",
				"max": 50,
				"min": 0,
				"name": "pith_wander",
				"shortdesc": "Pith wander",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.7,
				"label": "Ripple amount",
				"longdesc": "Amount of fine ripple on the rings, in recipe units",
				"max": 10,
				"min": 0,
				"name": "ripple_amount",
				"shortdesc": "Ripple amount",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.4,
				"label": "Ray strength",
				"longdesc": "Strength of the pale medullary rays",
				"max": 1,
				"min": 0,
				"name": "ray_strength",
				"shortdesc": "Ray strength",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.55,
				"label": "Pore strength",
				"longdesc": "How dark the pores are",
				"max": 1,
				"min": 0,
				"name": "pore_strength",
				"shortdesc": "Pore strength",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.7,
				"label": "Check strength",
				"longdesc": "How dark the drying checks (splits along the grain) are",
				"max": 1,
				"min": 0,
				"name": "check_strength",
				"shortdesc": "Check strength",
				"step": 0.01,
				"type": "float"
			},
			{
				"control": "None",
				"default": 0.08,
				"label": "Bump strength",
				"longdesc": "Bump strength of the grain relief (more is added on aged faces along the grain)",
				"max": 1,
				"min": 0,
				"name": "bump_strength",
				"shortdesc": "Bump strength",
				"step": 0.001,
				"type": "float"
			}
		],
		"shortdesc": "Voxel Wood"
	},
	"type": "shader"
}