[gd_resource type="Resource" script_class="TextResource" load_steps=2 format=3 uid="uid://vl3mifeswrlj"]

[ext_resource type="Script" path="res://addons/material_maker/engine/text_resource.gd" id="1_yim88"]

[resource]
script = ExtResource("1_yim88")
text = "#version 450

layout(location = 0) out vec4 outColor;
layout(location = 2) in vec3 model_vert;
layout(location = 3) in vec3 normal;
layout(location = 4) in vec2 uv;

@DECLARATIONS

void main() {
	int box = 2;
	ivec2 v2t_size = textureSize(v2t, 0);
	float v = 1.0;
	vec4 pos = transform*vec4(model_vert, 1.0);
	pos /= pos.w;
	pos.y = -pos.y;
	vec3 mv = pos.xyz*0.5+vec3(0.5);
	// v2t keeps front faces only. This pass draws in UV space, so a triangle faces the
	// camera if its UV winding and its winding on screen (sign of d(mv)/d(uv)) agree.
	vec2 mv_dx = dFdx(mv.xy);
	vec2 mv_dy = dFdy(mv.xy);
	bool facing_camera = gl_FrontFacing == (mv_dx.x*mv_dy.y-mv_dx.y*mv_dy.x > 0.0);
	if (mv.x > 0.0 && mv.x < 1.0 && mv.y > 0.0 && mv.y < 1.0) {
		// Compare with the UVs of the view pixels around, without filtering: interpolated
		// UVs (at silhouettes and UV island edges) can match a hidden face by chance
		ivec2 center = ivec2(mv.xy*vec2(v2t_size));
		for (int dx = -box; dx <= box; ++dx) {
			for (int dy = -box; dy <= box; ++dy) {
				ivec2 p = center+ivec2(dx, dy);
				if (any(lessThan(p, ivec2(0))) || any(greaterThanEqual(p, v2t_size))) {
					continue;
				}
				vec4 view_uv = texelFetch(v2t, p, 0);
				// The background (transparent) has no UV
				if (view_uv.a > 0.0) {
					v = min(v, length(view_uv.xy-uv));
				}
			}
		}
	}
	v = clamp(1.0-20.0*v, 0.0, 1.0);
	outColor = vec4(mv.xy, v, 1.0);
	// Where triangles share UV space, keep the most visible one, preferring
	// triangles that face the camera
	gl_FragDepth = 0.5*(1.0-v)+(facing_camera ? 0.0 : 0.5);
}
"
